---
import Base from '../layouts/Base.astro'
import changelog from '../data/changelog.json'
import { formatDate } from '../lib/site'
import { renderReleaseNotes } from '../lib/markdown'

/**
 * Every published release. The notes are the GitHub release bodies, baked by
 * scripts/bake-changelog.mjs and rendered by src/lib/markdown.ts, which
 * escapes everything before adding markup.
 */

const entries = changelog.entries.map((entry) => ({
  ...entry,
  html: entry.body ? renderReleaseNotes(entry.body) : '',
  // Release names are "Vyotiq v1.0.0"; only show one that says more than that.
  extraName: entry.name && !entry.name.includes(entry.version) ? entry.name : null
}))
---

<Base title="Changelog" description="Every release of Agent V, newest first, with the full release notes.">
  <section class="page-head">
    <div class="wrap">
      <h1 class="title">Changelog</h1>
      <p class="lede">
        Every release of Agent V, newest first. The same notes are on{' '}
        <a href={changelog.releasesUrl} class="link" rel="noopener noreferrer">GitHub</a>.
      </p>
    </div>
  </section>

  <div class="wrap">
    {
      entries.length === 0 ? (
        <section class="band-tight rule">
          <h2 class="h2">Nothing published yet</h2>
          <p class="body empty">The first release shows up here once it’s tagged and built.</p>
        </section>
      ) : (
        <ol class="releases">
          {entries.map((entry) => (
            <li class="release" id={entry.tag}>
              <div class="release-meta">
                <h2 class="version mono">{entry.version}</h2>
                <p class="meta">{formatDate(entry.publishedAt)}</p>
                {entry.prerelease && <span class="tag">Pre-release</span>}
                <p class="meta files">
                  <a href={entry.htmlUrl} class="link" rel="noopener noreferrer">
                    Release on GitHub
                  </a>
                  <span>
                    {entry.assetCount} {entry.assetCount === 1 ? 'file' : 'files'}
                  </span>
                </p>
              </div>
              <div class="release-body">
                {entry.extraName && <p class="release-name">{entry.extraName}</p>}
                {entry.html ? (
                  <div class="prose notes" set:html={entry.html} />
                ) : (
                  <p class="body">No notes were written for this release.</p>
                )}
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</Base>

<style>
  .releases {
    border-top: 1px solid var(--line);
  }

  .release {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .release-meta {
    position: sticky;
    top: calc(var(--header) + 2rem);
    align-self: start;
    display: grid;
    gap: 0.375rem;
    justify-items: start;
  }

  .version {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .files {
    display: grid;
    gap: 0.125rem;
    margin-top: 0.75rem;
  }

  .release-name {
    margin-bottom: 1.25rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  /* The lede paragraph of a release reads as its summary. */
  .notes > :global(p:first-child) {
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--text);
  }

  .notes :global(h3) {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .notes :global(li) {
    padding-left: 0.125rem;
  }

  .empty {
    margin-top: 1rem;
  }

  @media (max-width: 859px) {
    .release {
      grid-template-columns: minmax(0, 1fr);
    }
    .release-meta {
      position: static;
    }
  }
</style>
