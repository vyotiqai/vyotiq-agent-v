---
import Base from '../layouts/Base.astro'

const links = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/download', label: 'Download' },
  { href: '/docs', label: 'Docs' }
]
---

<Base title="Page not found" description="There is no page at this address on vyotiq.com." noindex>
  <section class="page-head missing">
    <div class="wrap">
      <p class="meta mono code-404">404</p>
      <h1 class="title">There’s no page here</h1>
      <p class="lede">The link may be old, or the page has moved. One of these should help.</p>
      <ul class="links">
        {links.map((l) => <li><a href={l.href} class="more">{l.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .missing {
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .code-404 {
    margin-bottom: 1rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 2rem;
  }
</style>
