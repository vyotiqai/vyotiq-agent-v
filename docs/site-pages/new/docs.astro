---
import Base from '../layouts/Base.astro'
import { app } from '../lib/site'

const source = app.repo.source
// package.json says ">=22.18.0"; the page says "22.18.0 or later".
const node = app.node.replace(/^>=\s*/, '')

/* Settings is being reorganised between releases, so the steps name the
   screen to look for rather than a path through the menus. */
const steps = [
  {
    title: 'Install it',
    body: 'Download the build for your system and run it. On Windows it installs for your user only, so you don’t need admin rights. The builds aren’t code-signed, so your system will warn you the first time you open it.',
    link: { href: '/download#first-run', label: 'What to do about the warning' }
  },
  {
    title: 'Add a model provider',
    body: 'Open Settings, find Providers, and paste an API key for the provider you use. The key is stored in your operating system’s keychain. Using Ollama? Point Agent V at it and skip the key.'
  },
  {
    title: 'Open a repository',
    body: 'Open the folder you want to work in. Agent V builds a search index of it in the background.'
  },
  {
    title: 'Give it a task',
    body: 'Start in Ask mode to explore the code without changing anything, or switch to Agent mode to let it make changes. In Settings you choose which tools may run without asking you first.'
  }
]

const reference = [
  { title: 'README', body: 'What the project is, how it’s laid out, and the development commands.', href: `${source}#readme` },
  { title: 'Contributing', body: 'How changes are made and the checks every one of them has to pass.', href: '/contributing' },
  {
    title: 'How browser traffic is controlled',
    body: 'The rule every request from the built-in browser goes through, and what a run records about it.',
    href: `${source}/blob/main/docs/egress.md`
  },
  { title: 'Security policy', body: 'How to report a vulnerability.', href: '/security' },
  { title: 'Report an issue', body: 'Bugs, requests and questions.', href: app.repo.issues ?? `${source}/issues` }
]
---

<Base
  title="Docs"
  description="Get started with Agent V: install it, add a model provider, open a repository and give it a task. Or build it from source."
>
  <section class="page-head">
    <div class="wrap">
      <h1 class="title">Get started</h1>
      <p class="lede">
        Agent V is a desktop app, and there’s no account to create. Install it, add a model provider, and open a
        repository.
      </p>
    </div>
  </section>

  <section class="band-tight rule" id="start">
    <div class="wrap split">
      <div class="stack">
        <h2 class="h2">From download to your first task</h2>
      </div>
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li class="step">
              <span class="step-n mono">{String(i + 1).padStart(2, '0')}</span>
              <div class="step-text">
                <h3 class="h3">{step.title}</h3>
                <p>{step.body}</p>
                {step.link && (
                  <p>
                    <a href={step.link.href} class="more">
                      {step.link.label}
                    </a>
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band-tight rule" id="source">
    <div class="wrap split">
      <div class="stack">
        <h2 class="h2">Build it yourself</h2>
        <p class="body">
          Agent V is GPL-3.0-or-later, and anything the release pipeline builds, you can build too. It’s also the way to go
          if you’d rather not run an unsigned app.
        </p>
        <p class="detail">
          You need Node <span class="mono">{node}</span> or later, and pnpm. Turn pnpm on once with{' '}
          <span class="mono">corepack enable</span>.
        </p>
      </div>
      <div class="stack">
        <pre class="code"><code><span class="prompt">$ </span>git clone {source}.git
<span class="prompt">$ </span>cd vyotiq-agent-v
<span class="prompt">$ </span>pnpm install
<span class="prompt">$ </span>pnpm dev</code></pre>
        <p class="detail">
          <span class="mono">pnpm dev</span> runs the app in development. <span class="mono">pnpm build</span> makes a
          production build, and <span class="mono">pnpm pack:win</span>, <span class="mono">pnpm pack:mac</span> and{' '}
          <span class="mono">pnpm pack:linux</span> make the installers.
        </p>
      </div>
    </div>
  </section>

  <section class="band-tight rule" id="more">
    <div class="wrap split">
      <div class="stack">
        <h2 class="h2">Go deeper</h2>
        <p class="body">The detailed documentation lives in the repository, next to the code it describes.</p>
      </div>
      <ul class="refs">
        {
          reference.map((ref) => (
            <li>
              <a href={ref.href} class="ref" {...(ref.href.startsWith('http') ? { rel: 'noopener noreferrer' } : {})}>
                <span class="ref-title">{ref.title}</span>
                <span class="ref-body">{ref.body}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .steps {
    border-top: 1px solid var(--line);
  }

  .step {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .step-n {
    padding-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--text-3);
  }

  .step-text {
    display: grid;
    gap: 0.5rem;
  }

  .step-text p {
    color: var(--text-2);
  }

  .refs {
    border-top: 1px solid var(--line);
  }

  .ref {
    display: grid;
    gap: 0.25rem;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--line);
  }

  .ref-title {
    font-weight: 600;
    color: var(--text);
  }

  .ref-title::after {
    content: ' →';
    color: var(--text-3);
    transition: color var(--fast) var(--ease);
  }

  .ref:hover .ref-title::after {
    color: var(--text);
  }

  .ref-body {
    font-size: 0.9375rem;
    color: var(--text-2);
  }
</style>
