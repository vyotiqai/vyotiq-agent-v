---
import Base from '../layouts/Base.astro'
import PlatformMark from '../components/PlatformMark.astro'
import { app, formatBytes, formatDate } from '../lib/site'
import { HAS_RELEASE, PICKS, PLATFORMS, RELEASE_META } from '../lib/download'

const signing = app.packaging.signing
const unsigned = signing.windows === 'unsigned' || signing.macos === 'not-notarized'

const firstRun = [
  {
    os: 'windows' as const,
    label: 'Windows',
    body: 'SmartScreen says “Windows protected your PC”. Click More info, then Run anyway. It installs for your user only, with no admin rights needed, and shows up in the Start menu as Vyotiq.'
  },
  {
    os: 'macos' as const,
    label: 'macOS',
    body: 'Gatekeeper blocks the first launch. Open System Settings, go to Privacy & Security, find Vyotiq near the bottom and click Open Anyway.'
  },
  {
    os: 'linux' as const,
    label: 'Linux',
    body: 'Make the AppImage executable with chmod +x, then run it. The .deb and .rpm packages install through your package manager as usual.'
  }
]
---

<Base
  title="Download"
  description="Download Agent V for Windows, macOS and Linux. Free and open source under GPL-3.0-or-later."
>
  <section class="page-head">
    <div class="wrap">
      <h1 class="title">Download Agent&nbsp;V</h1>
      {
        HAS_RELEASE ? (
          <>
            <p class="lede">
              Version <span class="mono">{RELEASE_META.version}</span>, released {formatDate(RELEASE_META.publishedAt)}.
              Free and open source, for Windows, macOS and Linux.
            </p>
            <div class="actions">
              <a class="btn btn-primary" href="#all" data-primary>
                <span data-primary-label>See all downloads</span>
              </a>
              <a class="btn btn-secondary" href="/changelog">What’s new</a>
            </div>
            <p class="meta pick" data-pick-meta hidden />
            <p class="meta pick" data-pick-alt hidden />
          </>
        ) : (
          <p class="lede">No release is published yet. Download links will appear here as soon as one is.</p>
        )
      }
    </div>
  </section>

  {
    HAS_RELEASE && (
      <section class="band-tight rule" id="all" aria-labelledby="all-title">
        <div class="wrap split">
          <div class="stack">
            <h2 class="h2" id="all-title">All downloads</h2>
            <p class="body">
              Every file comes from the <a class="link" href={RELEASE_META.htmlUrl} rel="noopener noreferrer">GitHub release</a>,
              the same place the app checks for updates. The Mac builds are separate for Apple silicon and Intel.
            </p>
          </div>

          <div class="platforms">
            {PLATFORMS.map((platform) => (
              <div class="platform">
                <h3 class="h3 platform-name">
                  <PlatformMark os={platform.id} size={18} />
                  {platform.label}
                </h3>
                {platform.variants.map((variant) => (
                  <div class="variant">
                    <p class="meta variant-name">
                      {variant.heading} <span class="mono">({variant.arch})</span>
                    </p>
                    <ul class="assets">
                      {variant.installers.map((installer) => (
                        <li class="asset">
                          <a class="asset-link" data-asset href={installer.url}>
                            {installer.label}
                          </a>
                          <span class="asset-file mono">{installer.name}</span>
                          <span class="asset-size mono">{formatBytes(installer.size)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    unsigned && (
      <section class="band-tight rule" id="first-run">
        <div class="wrap split">
          <div class="stack">
            <h2 class="h2">The first time you open it</h2>
            <p class="body">
              The builds aren’t code-signed, so your system will warn you the first time you open Agent V. That’s expected.
            </p>
            <p class="detail">
              The source is public and the builds come from a GitHub Actions workflow in the same repository. If you’d rather
              not run an unsigned app, <a class="link" href="/docs#source">build it yourself</a>.
            </p>
          </div>
          <ul class="first-run">
            {firstRun.map((f) => (
              <li>
                <h3 class="h3 platform-name">
                  <PlatformMark os={f.os} size={16} />
                  {f.label}
                </h3>
                <p>{f.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="band-tight rule" id="updates">
    <div class="wrap split">
      <div class="stack">
        <h2 class="h2">Updates</h2>
      </div>
      <div class="stack">
        <p class="body">
          When a new version is out, Agent V tells you. It never downloads or installs an update unless you ask it to.
        </p>
        <p><a href="/changelog" class="more">Read the changelog</a></p>
      </div>
    </div>
  </section>

  {HAS_RELEASE && <script type="application/json" id="picks" set:html={JSON.stringify(PICKS)} />}
</Base>

<style>
  .pick {
    margin-top: 1rem;
  }

  .platforms {
    display: grid;
    gap: 2.25rem;
  }

  .platform-name {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .variant {
    margin-top: 1rem;
  }

  .variant-name {
    margin-bottom: 0.25rem;
  }

  .assets {
    border-top: 1px solid var(--line);
  }

  .asset {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.8125rem;
    border-bottom: 1px solid var(--line);
  }

  .asset-link {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: var(--line-2);
  }

  .asset-link:hover {
    text-decoration-color: currentColor;
  }

  .asset-file {
    font-size: 0.8125rem;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }

  .asset-size {
    font-size: 0.8125rem;
    color: var(--text-2);
    white-space: nowrap;
  }

  .first-run {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .first-run li {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .first-run p {
    color: var(--text-2);
  }

  @media (max-width: 639px) {
    .asset {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.25rem 1rem;
    }
    .asset-file {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>

<script>
  import { detectArm, detectOs, OS_LABEL } from '../lib/detect'

  type Pick = { platform: string; arch: string; format: string; label: string; name: string; url: string; size: number }

  const data = document.getElementById('picks')?.textContent
  const picks: Pick[] = data ? JSON.parse(data) : []
  const primary = document.querySelector<HTMLAnchorElement>('[data-primary]')
  const label = primary?.querySelector<HTMLElement>('[data-primary-label]')
  const meta = document.querySelector<HTMLElement>('[data-pick-meta]')
  const alt = document.querySelector<HTMLElement>('[data-pick-alt]')

  const mb = (bytes: number) => `${Math.round(bytes / 1024 / 1024)} MB`
  // The first format listed is the one most people want on that system.
  const PREFERRED: Record<string, string[]> = { windows: ['exe'], macos: ['dmg', 'zip'], linux: ['AppImage', 'deb', 'rpm'] }

  const choose = (platform: string, arch: string | null) => {
    const candidates = picks.filter((p) => p.platform === platform && (arch === null || p.arch === arch))
    for (const format of PREFERRED[platform] ?? []) {
      const hit = candidates.find((p) => p.format === format)
      if (hit) return hit
    }
    return candidates[0] ?? null
  }

  const os = detectOs()
  if (os && primary && label && meta && alt) {
    void detectArm().then((arm) => {
      // A Mac whose browser won't say which chip it has gets the Apple silicon
      // build, with the Intel one offered right under the button.
      const arch = os === 'macos' ? (arm === false ? 'x64' : 'arm64') : 'x64'
      const pick = choose(os, arch)
      if (!pick) return

      primary.href = pick.url
      label.textContent =
        os === 'macos' ? `Download for Mac (${arch === 'arm64' ? 'Apple silicon' : 'Intel'})` : `Download for ${OS_LABEL[os]}`
      meta.textContent = `${pick.name} · ${mb(pick.size)}`
      meta.hidden = false

      if (os === 'macos' && arm === null) {
        const intel = choose('macos', 'x64')
        if (intel) {
          alt.textContent = 'On an Intel Mac? '
          const link = document.createElement('a')
          link.href = intel.url
          link.className = 'link'
          link.textContent = 'Get the Intel build'
          alt.append(link, '.')
          alt.hidden = false
        }
      }
    })
  }
</script>
