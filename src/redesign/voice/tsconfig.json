{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@renderer/*": ["../../renderer/src/*"],
      "@shared/*": ["../../shared/*"]
    }
  },
  "include": ["src/**/*", "vite-env.d.ts", "../../renderer/src/env.d.ts", "../../preload/index.d.ts"]
}
