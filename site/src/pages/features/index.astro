---
import Base from '@/layouts/Base.astro'
import PageHead from '@/components/site/PageHead.astro'
import FeatureShot from '@/components/site/FeatureShot.astro'
import { FEATURES } from '@/data/features'

/** Each feature's hero screen again, in a card-sized frame, at the app's narrow layout. */
const CARD: Record<string, { desktop: { w: number; h: number; x: number; y: number; s: number } }> = {
  'task-record': { desktop: { w: 592, h: 400, x: -150, y: 28, s: 0.56 } },
  instances: { desktop: { w: 592, h: 400, x: 24, y: 28, s: 0.78 } },
  approvals: { desktop: { w: 592, h: 400, x: 44, y: 32, s: 0.84 } },
  usage: { desktop: { w: 592, h: 400, x: 59, y: 28, s: 0.74 } }
}
---
<Base title="Features" description="What Agent V does: tasks with a record and checks, instances that work in parallel, approvals and rewind, and usage with honest costs.">
  <PageHead eyebrow="Features" title="Hand it the work.<br />Keep the say." lede="Agent V takes a task from a brief to a reviewed change. These are the parts that make that safe to hand off." />
  <div class="wrap grid">
    {FEATURES.map((f) => (
      <a href={`/features/${f.slug}`} class="card">
        <FeatureShot shot={{ ...f.hero, wide: false, desktop: CARD[f.slug].desktop }} />
        <h2 class="h4">{f.nav} →</h2>
        <p class="muted">{f.lede}</p>
      </a>
    ))}
  </div>
</Base>

<style>
  .grid { padding: 48px 0 var(--section-gap); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px 16px; }
  .card { display: flex; flex-direction: column; gap: 14px; text-decoration: none; }
  .card:hover { opacity: 1; }
  .card:hover h2 { opacity: 0.72; }
  @media (max-width: 639px) { .grid { grid-template-columns: minmax(0, 1fr); gap: 40px; } }
</style>
