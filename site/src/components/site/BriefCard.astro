---
/**
 * A use case's brief, to paste into Agent V's New task page: the mode to pick,
 * the brief itself and the Done when lines to add under it. Copy appears only
 * when the clipboard can be reached; the text is always there to select.
 */
interface Props {
  mode: 'Agent' | 'Ask'
  /** A brief for the New task page, or a slash command typed like one. */
  kind?: 'brief' | 'command'
  brief: string
  checks: string[]
}
const { mode, kind = 'brief', brief, checks } = Astro.props
const noun = kind === 'command' ? 'command' : 'brief'
---
<figure class="brief" data-brief>
  <figcaption class="head">
    <span class="label">The {noun}</span>
    <span class="mode">{mode} mode</span>
    <button type="button" class="copy" hidden>Copy {noun}</button>
    <span class="status" role="status" aria-live="polite"></span>
  </figcaption>
  <p class="text" data-brief-text>{brief}</p>
  {checks.length > 0 && (
    <div class="checks">
      <p class="label">Done when</p>
      <ul>{checks.map((c) => <li>{c}</li>)}</ul>
      <p class="hint">Type each line into the "Done when… a command passes, a file exists" field in the brief box and press Enter.</p>
    </div>
  )}
  {kind === 'command' && <p class="hint">Paste it into the instruction line of an open task.</p>}
</figure>

<style>
  .brief { margin: 0; background: var(--night); color: var(--night-fg); border-radius: 8px; padding: 20px 24px 22px; display: flex; flex-direction: column; gap: 16px; }
  .head { display: flex; align-items: center; gap: 12px; min-height: 32px; }
  .label { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--night-muted); }
  .mode { font-size: 13px; padding: 2px 8px; border-radius: 4px; border: 1px solid var(--night-hair); color: var(--night-body); }
  .copy { margin-left: auto; min-height: 32px; padding: 0 12px; border-radius: 4px; border: 1px solid var(--night-hair); background: transparent; color: var(--night-fg); font: inherit; font-size: 14px; cursor: pointer; }
  .copy:hover { border-color: var(--night-muted); }
  .copy:focus-visible { outline: 2px solid var(--night-fg); outline-offset: 2px; }
  .status { font-size: 13px; color: var(--night-muted); }
  .text { font-size: 17px; line-height: 1.55; white-space: pre-line; }
  .checks { border-top: 1px solid var(--night-hair); padding-top: 14px; display: flex; flex-direction: column; gap: 8px; }
  ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; }
  li { position: relative; padding-left: 22px; line-height: 1.5; color: var(--night-body); }
  li::before { content: ''; position: absolute; left: 2px; top: 0.45em; width: 10px; height: 10px; border-radius: 50%; border: 1.5px dashed var(--night-muted); }
  .hint { font-size: 14px; color: var(--night-muted); }
  @media (max-width: 639px) { .brief { padding: 16px 16px 18px; } .text { font-size: 16px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-brief]').forEach((card) => {
    const button = card.querySelector<HTMLButtonElement>('.copy')
    const status = card.querySelector<HTMLElement>('.status')
    const text = card.querySelector<HTMLElement>('[data-brief-text]')?.textContent ?? ''
    if (!button || !status || !navigator.clipboard) return
    button.hidden = false
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text)
        status.textContent = 'Copied'
      } catch {
        status.textContent = 'Select the text to copy it'
      }
      setTimeout(() => (status.textContent = ''), 2500)
    })
  })
</script>
