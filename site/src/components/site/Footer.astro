---
import Logo from './Logo.astro'
import { FOOTER_NAV } from '@/data/site'
---
<footer class="foot">
  <div class="wrap inner">
    <div class="cols">
      <a href="/" class="brand" aria-label="Agent V home"><Logo size={20} /><span>Agent V</span></a>
      {FOOTER_NAV.map((col) => (
        <nav aria-label={col.label}>
          <div class="head">{col.label}</div>
          {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      ))}
    </div>
    <div class="base"><span>Made by Vyotiq</span><span>© 2026</span></div>
  </div>
</footer>

<style>
  .foot { background: var(--night) var(--grain); color: var(--night-fg); }
  .inner { border-top: 1px solid var(--night-hair); padding: 48px 0 36px; display: flex; flex-direction: column; gap: 56px; }
  .cols { display: grid; grid-template-columns: 1fr repeat(4, 180px); gap: 32px; font-size: 15px; }
  .brand { display: inline-flex; align-self: start; align-items: center; gap: 10px; text-decoration: none; font-size: 19px; font-weight: 500; letter-spacing: -0.03em; }
  nav { display: flex; flex-direction: column; }
  .head { padding-bottom: 8px; }
  nav a { color: var(--night-muted); text-decoration: none; padding: 3px 0; }
  .base { display: flex; justify-content: space-between; font-size: 13px; color: var(--night-dim); }
  @media (max-width: 1023px) {
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 32px; }
    .brand { grid-column: 1 / -1; }
    nav a { padding: 6px 0; }
  }
</style>
