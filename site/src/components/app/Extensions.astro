<span style={`display: flex; align-items: center; gap: 6px; margin-right: 20px; box-sizing: border-box; border-bottom: 2px solid ${t.line}; padding-top: 2px; color: ${t.color}; font-weight: ${t.weight}`}>{t.label}<span style="font-size: 12px; font-weight: 400; color: var(--app-tertiary)">{t.n}</span></span>
