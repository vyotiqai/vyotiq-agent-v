---
const names = ['OpenAI', 'Anthropic', 'Gemini', 'Ollama', 'DeepSeek', 'Groq', 'OpenRouter', 'xAI', 'Mistral', 'OpenCode Go']
const tint = ['var(--app-fg-strong)', '#B85C38', '#3367D6', 'var(--app-fg)', '#4D6BFE', '#F55036', '#6467F2', 'var(--app-fg-strong)', '#FA520F', 'var(--app-fg)']
const providers = names.map((name, i) => ({
  name,
  initial: name[0],
  tile: 'width: 16px; height: 16px; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; color: #FFFFFF; background: ' + tint[i],
  style: 'height: 26px; display: flex; align-items: center; gap: 8px; padding: 0 8px; border-radius: 6px; font-size: 12.5px;' + (i === 1 ? ' background: var(--app-surface-2); color: var(--app-fg-strong); font-weight: 500' : ' color: var(--app-secondary)')
}))
const row = (sel: boolean) => 'height: 32px; display: flex; align-items: center; gap: 8px; padding: 0 8px; margin: 0 6px; border-radius: 6px;' + (sel ? ' background: var(--app-surface)' : '')
const models = [
  { id: 'claude-opus-5', ctx: '200k', price: '$5.00', sel: true, style: row(true) },
  { id: 'claude-sonnet-4-6', ctx: '200k', price: '$3.00', sel: false, style: row(false) },
  { id: 'claude-sonnet-4', ctx: '200k', price: '$3.00', sel: false, style: row(false) },
  { id: 'claude-haiku-4-5', ctx: '200k', price: '$1.00', sel: false, style: row(false) }
]
const efforts = ['Off', 'Min', 'Low', 'Med', 'High', 'XHigh', 'Max']
const seg = 'height: 24px; display: inline-flex; align-items: center; padding: 0 8px; border-radius: 4px; font-size: 12px; font-weight: 500;'
---
<div style="width: 560px; height: 392px; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; background: var(--app-bg); border-radius: 10px; font-family: var(--app-font); font-size: 13px; line-height: 20px; color: var(--app-fg); box-shadow: 0 0 0 1px var(--app-border), 0 30px 70px -20px rgba(0, 0, 0, 0.50)">
<div style="height: 40px; flex-shrink: 0; display: flex; align-items: center; gap: 8px; padding: 0 12px; border-bottom: 1px solid var(--app-divider); color: var(--app-tertiary)">
<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="7" cy="7" r="4.5"></circle><path d="M10.5 10.5L14 14"></path></svg>
<span style="flex-grow: 1">Search every provider</span>
<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M13 3v3.5H9.5M3 13V9.5h3.5M12.5 6.5A5 5 0 0 0 4 4.5M3.5 9.5A5 5 0 0 0 12 11.5"></path></svg>
</div>
<div style="flex-grow: 1; min-height: 0; display: flex">
<div style="width: 168px; flex-shrink: 0; padding: 6px; box-sizing: border-box; border-right: 1px solid var(--app-divider); display: flex; flex-direction: column; gap: 1px">
{providers.map((p) => (<Fragment>
<div style={p.style}><span style={p.tile}>{p.initial}</span>{p.name}</div>
</Fragment>))}
</div>
<div style="flex-grow: 1; min-width: 0; display: flex; flex-direction: column">
<div style="height: 28px; display: flex; align-items: center; gap: 8px; padding: 0 8px; margin: 0 6px; font-size: 11px; color: var(--app-tertiary)">
<span style="flex-grow: 1">Model</span><span style="width: 40px; text-align: right">Context</span><span style="width: 48px; text-align: right">$/M in</span>
</div>
{models.map((m) => (<Fragment>
<div style={m.style}>
<span style="flex-grow: 1; font-family: var(--app-mono); font-size: 11.5px">{m.id}</span>
{m.sel ? <svg width="12" height="12" viewBox="0 0 256 256" fill="none" stroke="var(--app-fg-strong)" stroke-width="20" stroke-linecap="round" stroke-linejoin="round" aria-label="Selected"><path d="M40 144l56 56L224 72"></path></svg> : null}
<span style="width: 40px; text-align: right; font-family: var(--app-mono); font-size: 11px; color: var(--app-muted)">{m.ctx}</span>
<span style="width: 48px; text-align: right; font-family: var(--app-mono); font-size: 11px; color: var(--app-muted)">{m.price}</span>
</div>
</Fragment>))}
</div>
</div>
<div style="height: 48px; flex-shrink: 0; display: flex; align-items: center; gap: 8px; padding: 0 12px; border-top: 1px solid var(--app-border)">
<span style="font-size: 12px; color: var(--app-muted)">Effort</span>
<span role="radiogroup" aria-label="Effort" style="display: inline-flex; align-items: center; height: 28px; box-sizing: border-box; padding: 2px; border-radius: 6px; background: var(--app-surface)">{efforts.map((e) => (<span style={e === 'High' ? seg + ' background: var(--app-bg); color: var(--app-fg-strong); box-shadow: 0 0 0 1px var(--app-border)' : seg + ' color: var(--app-muted)'}>{e}</span>))}</span>
</div>
</div>
