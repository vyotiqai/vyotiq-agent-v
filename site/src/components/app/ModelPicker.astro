---
/**
 * The model picker (chat/components/composer/ModelPicker.tsx) with Anthropic open: the
 * providers you set up, local ones marked, each model's context and input price, and the
 * effort a Claude model offers (no Off) with the note the app prints under it.
 */
import Icon from './Icon.astro'
import Mark from './Mark.astro'

const mono = 'font-family: var(--app-mono);'
const providers = [
  { mark: 'openai', name: 'OpenAI', note: '' },
  { mark: 'anthropic', name: 'Anthropic', note: '', sel: true },
  { mark: 'gemini', name: 'Gemini', note: '' },
  { mark: 'ollama', name: 'Ollama', note: 'local' },
  { mark: 'deepseek', name: 'DeepSeek', note: '' },
  { mark: 'openrouter', name: 'OpenRouter', note: '' }
] as const
const models = [
  { id: 'claude-opus-5', ctx: '200k', price: '$5.00', sel: true },
  { id: 'claude-sonnet-4', ctx: '200k', price: '$3.00', sel: false },
  { id: 'claude-haiku-4-5', ctx: '200k', price: '$1.00', sel: false }
]
const efforts = ['Min', 'Low', 'Med', 'High', 'XHigh', 'Max']
const seg = 'height: 24px; display: inline-flex; align-items: center; padding: 0 8px; border-radius: 4px; font-size: 12px; font-weight: 500;'
const prow = 'height: 32px; display: flex; align-items: center; gap: 8px; padding: 0 8px; border-radius: 6px;'
---
<div role="dialog" aria-label="Model and effort" style="width: 520px; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; background: var(--app-bg); border-radius: 10px; font-family: var(--app-font); font-size: 13px; line-height: 20px; letter-spacing: 0; color: var(--app-fg); box-shadow: var(--app-shadow-menu)">
<div style="height: 40px; flex-shrink: 0; box-sizing: border-box; display: flex; align-items: center; gap: 8px; padding: 0 8px 0 12px; border-bottom: 1px solid var(--app-border)">
<Icon name="magnifyingGlass" size="14" color="var(--app-muted)" />
<span style="flex-grow: 1; color: var(--app-tertiary)">Search every provider</span>
<span style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; color: var(--app-tertiary)"><Icon name="arrowClockwise" size="13" /></span>
</div>
<div style="height: 300px; display: flex">
<div style="width: 160px; flex-shrink: 0; box-sizing: border-box; padding: 6px; border-right: 1px solid var(--app-border); display: flex; flex-direction: column; gap: 1px">
{providers.map((p) => (
<div style={`${prow} ${'sel' in p && p.sel ? 'background: var(--app-surface-2); color: var(--app-fg-strong)' : 'color: var(--app-secondary)'}`}><Mark provider={p.mark} size="16" /><span style="flex-grow: 1; white-space: nowrap">{p.name}</span>{p.note && <span style="font-size: 11px; color: var(--app-tertiary)">{p.note}</span>}</div>
))}
<div style={`${prow} color: var(--app-secondary)`}><Icon name="plugsConnected" size="16" /><span style="flex-grow: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">Custom OpenAI-compatible</span><span style="font-size: 11px; color: var(--app-tertiary)">local</span></div>
<div style={`${prow} font-size: 12px; color: var(--app-muted)`}>Add a provider…</div>
</div>
<div style="flex-grow: 1; min-width: 0; padding: 6px">
<div style="height: 28px; display: flex; align-items: center; gap: 8px; padding: 0 8px; font-size: 11px; color: var(--app-tertiary)"><span style="flex-grow: 1">Model</span><span style="width: 40px; text-align: right">Context</span><span style="width: 48px; text-align: right">$/M in</span></div>
{models.map((m) => (
<div style="height: 28px; display: flex; align-items: center; gap: 8px; padding: 0 8px; border-radius: 6px">
<span style={`flex-grow: 1; ${mono} font-size: 12px; color: ${m.sel ? 'var(--app-fg-strong)' : 'var(--app-fg)'}`}>{m.id}</span>
{m.sel && <Icon name="check" size="12" color="var(--app-fg-strong)" />}
<span style="width: 20px"></span>
<span style={`width: 40px; text-align: right; ${mono} font-size: 11px; color: var(--app-muted)`}>{m.ctx}</span>
<span style={`width: 48px; text-align: right; ${mono} font-size: 11px; color: var(--app-muted)`}>{m.price}</span>
</div>
))}
</div>
</div>
<div style="border-top: 1px solid var(--app-border); padding: 10px 12px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px">
<span style="display: flex; align-items: center; gap: 8px"><span style="font-size: 12px; color: var(--app-muted)">Effort</span><span role="radiogroup" aria-label="Effort" style="height: 28px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 4px; padding: 2px; border-radius: 6px; background: var(--app-surface)">{efforts.map((e) => <span style={e === 'High' ? `${seg} background: var(--app-bg); color: var(--app-fg-strong); box-shadow: 0 0 0 1px var(--app-border)` : `${seg} color: var(--app-muted)`}>{e}</span>)}</span></span>
<span style="width: 100%; font-size: 11px; line-height: 16px; color: var(--app-tertiary)">The most it thinks on a step: a run of steps that only read or search thinks less. Thinking tokens are billed.</span>
</div>
</div>
