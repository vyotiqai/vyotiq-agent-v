---
/**
 * The end of a finished task's record (TaskRecord's result, record/Checks.tsx and
 * record/Receipt.tsx): the result, the files it changed, each Done when check marked with
 * its evidence, the edits still to review, and the receipt.
 */
import Glyph from './Glyph.astro'
import Icon from './Icon.astro'
import Mark from './Mark.astro'

const mono = 'font-family: var(--app-mono);'
const chip = 'padding: 2px 4px; border-radius: 4px; background: var(--app-surface); font-family: var(--app-mono); font-size: 0.85em; color: var(--app-fg);'
const files = [
  { icon: 'typescript', dir: 'src/middleware/', name: 'rateLimit.ts', fresh: true, add: '+58', del: '' },
  { icon: 'test-ts', dir: 'test/', name: 'rateLimit.test.ts', fresh: true, add: '+28', del: '' },
  { icon: 'routing', dir: 'src/server/', name: 'router.ts', fresh: false, add: '+2', del: '−1' },
  { icon: 'typescript', dir: 'src/', name: 'config.ts', fresh: false, add: '+6', del: '−5' }
] as const
const checks = [
  { t: 'Calls over the limit get 429 with a Retry-After header', e: 'rateLimit.test.ts: the 101st call in a minute got 429, Retry-After: 37' },
  { t: 'The existing API tests still pass', e: 'pnpm test: 214 passed, 0 failed' },
  { t: 'The limit can be set per environment', e: 'config.ts reads RATE_LIMIT_PER_MINUTE, default 100' }
]
---
<div style="width: 700px; height: 480px; box-sizing: border-box; overflow: hidden; padding: 12px 24px 0; background: var(--app-bg); border: 1px solid var(--app-frame); border-radius: 8px; font-family: var(--app-font); font-size: 13px; line-height: 20px; letter-spacing: 0; color: var(--app-fg); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2), 0 30px 70px -24px rgba(0, 0, 0, 0.5)">
<section style="padding: 12px 0">
<div style="margin-bottom: 8px; font-size: 11px; line-height: 16px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--app-tertiary)">Result</div>
<p style="margin: 0; font-size: 14px; line-height: 22px; color: var(--app-fg-strong)">Every call to <span style={chip}>/api</span> now passes a token bucket keyed by API key. Past 100 a minute it answers 429 with Retry-After, and <span style={chip}>RATE_LIMIT_PER_MINUTE</span> changes the limit.</p>
<div style="margin: 12px -8px 0">
{files.map((f) => (
<div style="height: 28px; display: flex; align-items: center; gap: 8px; padding: 0 8px; border-radius: 6px; font-size: 12px">
<Mark file={f.icon} size="14" />
<span style="min-width: 0; white-space: nowrap"><span style="color: var(--app-tertiary)">{f.dir}</span>{f.name}</span>
{f.fresh && <span style="font-size: 11px; color: var(--app-tertiary)">New</span>}
<span style="flex-grow: 1"></span>
<span style={`display: flex; gap: 6px; ${mono} font-size: 11px`}><span style="color: var(--app-success)">{f.add}</span>{f.del && <span style="color: var(--app-danger)">{f.del}</span>}</span>
<span style="width: 11px"></span>
</div>
))}
</div>
<div style="margin-top: 16px">
<div style="font-weight: 600; color: var(--app-fg-strong)">Checked · 3 of 3 done-when checks met</div>
<ul style="margin: 6px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px">
{checks.map((c) => (
<li style="display: flex; align-items: flex-start; gap: 10px">
<span style="margin-top: 3px; display: flex"><Glyph kind="review" size="14" /></span>
<div style="min-width: 0"><div style="color: var(--app-secondary)">{c.t}</div><div style="margin-top: 2px; font-size: 12px; line-height: 18px; color: var(--app-tertiary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis">{c.e}</div></div>
</li>
))}
</ul>
</div>
<div style="margin-top: 12px; display: flex; align-items: center; gap: 8px; font-size: 12px; line-height: 18px; color: var(--app-tertiary)">4 files changed, not kept yet<span style="height: 24px; box-sizing: border-box; display: flex; align-items: center; gap: 6px; padding: 0 8px; border: 1px solid var(--app-border); border-radius: 6px; background: var(--app-bg); font-size: 11px; font-weight: 500; color: var(--app-fg)">Review changes<span style="display: flex; opacity: 0.7"><Icon name="arrowRight" size="11" /></span></span></div>
</section>
<section style={`padding: 12px 0; border-top: 1px solid var(--app-border); display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; ${mono} font-size: 12px; line-height: 18px; color: var(--app-tertiary)`}>
{['4m 12s', '3/3 checks met', '48k tok (in+out)', '71% cache hit', '~$0.42'].map((p, i) => (<Fragment>{i > 0 && <span>·</span>}<span style="white-space: nowrap">{p}</span></Fragment>))}
<span style="flex-grow: 1"></span>
<span style="display: flex; gap: 2px">{(['thumbsUp', 'thumbsDown', 'copy'] as const).map((n) => <span style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center"><Icon name={n} size="15" /></span>)}</span>
</section>
</div>
