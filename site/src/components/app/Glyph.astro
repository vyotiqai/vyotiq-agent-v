---
/**
 * The app's state glyphs (lib/ui/StatusGlyph.tsx): a shape first, then a colour. Running is
 * the Agent V mark at 86% of the box, its facets taking the light in turn.
 */
const props = Astro.props as { kind?: string; size?: number | string; still?: boolean }
const k = props.kind ?? 'running'
const s = Number(props.size ?? 14)
const px = s + 'px'
const inner = Math.round(s * 0.86)
const is = { running: k === 'running', needs: k === 'needs', review: k === 'review', done: k === 'done', failed: k === 'failed', queued: k === 'queued', stopped: k === 'stopped', paused: k === 'paused' }
const tone: Record<string, string> = { queued: 'var(--app-tertiary)', needs: 'var(--app-accent)', review: 'var(--app-success)', done: 'var(--app-tertiary)', failed: 'var(--app-danger)', stopped: 'var(--app-tertiary)', paused: 'var(--app-muted)' }
---
{is.running ? (
<span style={`display: inline-grid; place-items: center; flex-shrink: 0; width: ${px}; height: ${px}; color: var(--app-fg)`}>
<svg class={props.still ? undefined : 'app-agv'} width={inner} height={inner} viewBox="112 112 800 800" aria-hidden="true"><path class="f f-tr" d="M 363.044 198.000 L 512.000 112.000 L 858.410 312.000 L 858.410 484.000 Z" fill="currentColor"></path><path class="f f-br" d="M 858.410 540.000 L 858.410 712.000 L 512.000 912.000 L 363.044 826.000 Z" fill="currentColor" opacity={props.still ? '0.35' : undefined}></path><path class="f f-l" d="M 314.546 798.000 L 165.590 712.000 L 165.590 312.000 L 314.546 226.000 Z" fill="currentColor" opacity={props.still ? '0.6' : undefined}></path><path d="M 794.908 512.000 L 370.546 757.005 L 370.546 266.995 Z" fill="currentColor"></path></svg>
</span>
) : (
<svg width={px} height={px} viewBox="0 0 16 16" aria-hidden="true" style={`flex-shrink: 0; color: ${tone[k]}`}>
{is.queued && <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.4 2.2"></circle>}
{is.needs && <rect x="3.2" y="3.2" width="9.6" height="9.6" rx="1.6" transform="rotate(45 8 8)" fill="currentColor"></rect>}
{is.review && (<Fragment><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M5.3 8.2l1.8 1.8 3.6-3.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></Fragment>)}
{is.done && (<Fragment><circle cx="8" cy="8" r="7" fill="currentColor"></circle><path d="M5.2 8.2l1.9 1.9 3.8-4" fill="none" stroke="var(--app-bg)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></Fragment>)}
{is.failed && (<Fragment><circle cx="8" cy="8" r="7" fill="currentColor"></circle><path d="M5.8 5.8l4.4 4.4M10.2 5.8l-4.4 4.4" stroke="var(--app-bg)" stroke-width="1.7" stroke-linecap="round"></path></Fragment>)}
{is.stopped && (<Fragment><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><rect x="5.9" y="5.9" width="4.2" height="4.2" rx="0.6" fill="currentColor"></rect></Fragment>)}
{is.paused && (<Fragment><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M6.6 5.9v4.2M9.4 5.9v4.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></Fragment>)}
</svg>
)}
