---
/**
 * The inspector's PR tab (chat/components/PrPanel.tsx): the pull request the task opened
 * from its own branch, marked ready, with its checks passed and nothing blocking a merge.
 */
import Glyph from './Glyph.astro'
import Icon from './Icon.astro'

const mono = 'font-family: var(--app-mono);'
const tabs = ['Changes', 'Files', 'Terminal', 'Browser', 'PR', 'Plan']
const sub = [{ l: 'Checks', n: '4/4' }, { l: 'Files', n: '4' }, { l: 'Commits', n: '1' }, { l: 'Reviews', n: '1' }, { l: 'About', n: '' }]
const checks = [
  { name: 'lint', t: '38s' },
  { name: 'typecheck', t: '1m 4s' },
  { name: 'test (ubuntu-latest)', t: '2m 41s' },
  { name: 'test (windows-latest)', t: '3m 12s' }
]
const xs = 'width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;'
---
<div style="width: 560px; height: 470px; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; background: var(--app-bg); border: 1px solid var(--app-frame); border-radius: 8px; font-family: var(--app-font); font-size: 13px; line-height: 20px; letter-spacing: 0; color: var(--app-fg); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2), 0 30px 70px -24px rgba(0, 0, 0, 0.52)">
<div style="height: 40px; flex-shrink: 0; box-sizing: border-box; border-bottom: 1px solid var(--app-border); display: flex; align-items: stretch; gap: 8px; padding: 0 8px 0 12px">
<span style="display: flex; align-items: stretch; gap: 8px; font-size: 12px; font-weight: 500">
{tabs.map((t) => (
<span style={`position: relative; display: flex; align-items: center; padding: 0 4px; color: ${t === 'PR' ? 'var(--app-fg-strong)' : 'var(--app-muted)'}`}>{t}{t === 'PR' && <span style="position: absolute; left: 4px; right: 4px; bottom: -1px; height: 2px; border-radius: 999px; background: var(--app-fg-strong)"></span>}</span>
))}
</span>
<span style="flex-grow: 1"></span>
<span style="display: flex; align-items: center; gap: 8px; color: var(--app-tertiary)"><span style={xs}><Icon name="arrowsOut" size="13" /></span><span style={xs}><Icon name="x" size="13" /></span></span>
</div>
<div style="flex-shrink: 0; border-bottom: 1px solid var(--app-border)">
<div style="height: 40px; box-sizing: border-box; border-bottom: 1px solid var(--app-border); display: flex; align-items: center; gap: 8px; padding: 0 8px 0 16px; font-size: 12px; line-height: 18px">
<span style="height: 18px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 4px; padding: 0 6px; border-radius: 4px; background: var(--app-success-soft); color: var(--app-success); font-size: 11px; line-height: 1; font-weight: 500"><Icon name="gitPullRequest" size="11" />Open</span>
<span style={`min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; ${mono} font-size: 11px; color: var(--app-muted)`}>vyotiq/add-per-key-rate-limiting-to-the-public-api-mgal3k9p <span style="color: var(--app-tertiary)">→</span> main</span>
<span style="flex-grow: 1"></span>
<span style={`${xs} color: var(--app-secondary)`}><Icon name="arrowSquareOut" size="13" /></span>
<span style={`${xs} color: var(--app-secondary)`}><Icon name="dotsThree" size="13" /></span>
</div>
<div style="padding: 8px 16px 0">
<div style="font-weight: 600; color: var(--app-fg-strong)">Add per-key rate limiting to the public API <span style="font-weight: 400; color: var(--app-tertiary)">#214</span></div>
<div style="margin-top: 4px; height: 32px; display: flex; align-items: stretch; gap: 16px; font-size: 12px; font-weight: 500">
{sub.map((s, i) => (
<span style={`position: relative; display: flex; align-items: center; gap: 6px; color: ${i === 0 ? 'var(--app-fg-strong)' : 'var(--app-muted)'}`}>{s.l}{s.n && <span style={`${mono} font-size: 11px; color: var(--app-tertiary)`}>{s.n}</span>}{i === 0 && <span style="position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; border-radius: 999px; background: var(--app-fg-strong)"></span>}</span>
))}
</div>
</div>
</div>
<div style="padding: 12px 16px">
<div style="margin: 0 -8px">
{checks.map((c) => (
<div style="display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 6px">
<Glyph kind="review" size="14" />
<span style={`flex-grow: 1; ${mono} font-size: 12px; line-height: 18px`}>{c.name}</span>
<span style={`${mono} font-size: 11px; color: var(--app-tertiary)`}>{c.t}</span>
<span style={`${xs} color: var(--app-secondary)`}><Icon name="arrowSquareOut" size="13" /></span>
</div>
))}
</div>
<div style="margin-top: 20px">
<div style="margin-bottom: 8px; font-size: 11px; line-height: 16px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--app-tertiary)">Merge</div>
<div style="font-size: 12px; line-height: 18px; color: var(--app-muted)">Ready to merge.</div>
<div style="margin-top: 10px; display: flex"><span style="height: 28px; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-radius: 6px; background: var(--app-accent); color: var(--app-accent-fg); font-size: 12px; font-weight: 500">Squash and merge<span style="display: flex; opacity: 0.7"><Icon name="caretDown" size="12" /></span></span></div>
</div>
</div>
</div>
