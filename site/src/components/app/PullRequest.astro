---
import Glyph from './Glyph.astro'

const checks = [
  { name: 'lint', t: '38s' },
  { name: 'typecheck', t: '1m 04s' },
  { name: 'test (ubuntu-latest)', t: '2m 41s' },
  { name: 'test (windows-latest)', t: '3m 12s' }
]
---
<div style="width: 560px; height: 470px; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; background: var(--app-bg); border: 1px solid var(--app-frame); border-radius: 10px; font-family: var(--app-font); font-size: 13px; line-height: 20px; color: var(--app-fg); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2), 0 30px 70px -24px rgba(0, 0, 0, 0.52)">
<div style="height: 40px; flex-shrink: 0; box-sizing: border-box; border-bottom: 1px solid var(--app-border); display: flex; align-items: stretch; gap: 18px; padding: 0 16px; font-size: 12px; font-weight: 500">
<span style="display: flex; align-items: center; color: var(--app-muted)">Changes</span>
<span style="display: flex; align-items: center; color: var(--app-muted)">Files</span>
<span style="display: flex; align-items: center; color: var(--app-muted)">Terminal</span>
<span style="display: flex; align-items: center; color: var(--app-muted)">Browser</span>
<span style="display: flex; align-items: center; color: var(--app-fg-strong); box-shadow: inset 0 -2px 0 var(--app-fg-strong)">PR</span>
<span style="display: flex; align-items: center; color: var(--app-muted)">Plan</span>
</div>
<div style="padding: 14px 16px 0; display: flex; flex-direction: column; gap: 10px">
<div style="display: flex; align-items: center; gap: 8px; font-size: 12px">
<span style="height: 22px; display: flex; align-items: center; gap: 5px; padding: 0 8px; border-radius: 999px; background: var(--app-success-soft); color: var(--app-success); font-weight: 600"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="4.5" cy="3.5" r="1.5"></circle><circle cx="4.5" cy="12.5" r="1.5"></circle><circle cx="11.5" cy="12.5" r="1.5"></circle><path d="M4.5 5v6M11.5 11V6.5a2 2 0 0 0-2-2H7"></path></svg>Open</span>
<span style="font-family: var(--app-mono); font-size: 11px; color: var(--app-muted)">rate-limit → main</span>
<span style="flex-grow: 1"></span>
<span style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; color: var(--app-muted)"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-label="Open on GitHub"><path d="M13.5 6.25V2.5H9.75M9 7l4.5-4.5M11.5 9v4a.5.5 0 0 1-.5.5H3a.5.5 0 0 1-.5-.5V5a.5.5 0 0 1 .5-.5h4"></path></svg></span>
</div>
<div style="font-size: 14px; line-height: 22px; font-weight: 600; color: var(--app-fg-strong)">Add rate limiting to the public API <span style="font-weight: 400; color: var(--app-tertiary)">#214</span></div>
<div style="display: flex; gap: 16px; font-size: 12px; font-weight: 500; border-bottom: 1px solid var(--app-border)">
<span style="padding: 6px 0; color: var(--app-fg-strong); box-shadow: inset 0 -2px 0 var(--app-fg-strong)">Checks <span style="font-family: var(--app-mono); font-weight: 400; color: var(--app-tertiary)">4/4</span></span>
<span style="padding: 6px 0; color: var(--app-muted)">Files <span style="font-family: var(--app-mono); font-weight: 400; color: var(--app-tertiary)">4</span></span>
<span style="padding: 6px 0; color: var(--app-muted)">Commits <span style="font-family: var(--app-mono); font-weight: 400; color: var(--app-tertiary)">3</span></span>
<span style="padding: 6px 0; color: var(--app-muted)">Reviews <span style="font-family: var(--app-mono); font-weight: 400; color: var(--app-tertiary)">1</span></span>
<span style="padding: 6px 0; color: var(--app-muted)">About</span>
</div>
</div>
<div style="padding: 4px 8px; display: flex; flex-direction: column">
{checks.map((c) => (<Fragment>
<div style="height: 32px; display: flex; align-items: center; gap: 10px; padding: 0 8px">
<Glyph kind="review" size="14" />
<span style="flex-grow: 1; font-family: var(--app-mono); font-size: 11.5px">{c.name}</span>
<span style="font-family: var(--app-mono); font-size: 11px; color: var(--app-tertiary)">{c.t}</span>
</div>
</Fragment>))}
</div>
<div style="margin: 8px 16px 0; padding-top: 12px; border-top: 1px solid var(--app-divider); display: flex; flex-direction: column; gap: 10px">
<div style="font-size: 11px; line-height: 16px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--app-tertiary)">Merge</div>
<div style="font-size: 13px; color: var(--app-fg)">Ready to merge.</div>
<div style="display: flex; gap: 8px">
<span style="height: 28px; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-radius: 6px; background: var(--app-accent); color: var(--app-accent-fg); font-size: 12px; font-weight: 500">Squash and merge<svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6l4 4 4-4"></path></svg></span>
</div>
</div>
</div>
