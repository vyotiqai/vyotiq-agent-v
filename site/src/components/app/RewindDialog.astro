---
/** The rewind dialog (features/task/RewindDialog.tsx): one file was changed since, so it stays. */
import Icon from './Icon.astro'
import Mark from './Mark.astro'

const mono = 'font-family: var(--app-mono);'
const files = [
  { letter: 'M', icon: 'routing', path: 'src/server/router.ts', note: '' },
  { letter: 'A', icon: 'typescript', path: 'src/middleware/rateLimit.ts', note: '' },
  { letter: 'M', icon: 'typescript', path: 'src/config.ts', note: 'changed since · left as is' }
] as const
const btn = 'height: 28px; box-sizing: border-box; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-radius: 6px; font-size: 12px; font-weight: 500;'
---
<div role="dialog" aria-label="Rewind to before run 2?" style="width: 480px; box-sizing: border-box; background: var(--app-bg); border-radius: 10px; font-family: var(--app-font); font-size: 13px; line-height: 20px; letter-spacing: 0; color: var(--app-fg); box-shadow: var(--app-shadow-menu)">
<div style="padding: 20px 20px 8px">
<div style="display: flex; align-items: center; gap: 8px; font-size: 15px; line-height: 22px; font-weight: 600; color: var(--app-fg-strong)"><Icon name="arrowCounterClockwise" size="18" color="var(--app-muted)" />Rewind to before run 2?</div>
<p style="margin: 8px 0 0; line-height: 21px; color: var(--app-secondary)">Everything after run 2’s instruction leaves the record, and these files go back to how they were before it. It’s kept, so you can redo it until you send a new instruction or change those files.</p>
</div>
<ul aria-label="Files" style="margin: 12px 0; padding: 0; list-style: none; border-top: 1px solid var(--app-border); border-bottom: 1px solid var(--app-border); font-size: 12px; line-height: 18px">
{files.map((f, i) => (
<li style={`height: 32px; box-sizing: border-box; display: flex; align-items: center; gap: 8px; padding: 0 20px; ${i > 0 ? 'border-top: 1px solid var(--app-divider);' : ''}`}>
<span style={`width: 12px; ${mono} font-weight: 600; color: var(--app-muted)`}>{f.letter}</span>
<Mark file={f.icon} size="13" />
<span style={`flex-grow: 1; ${mono} font-size: 11px; color: ${f.note ? 'var(--app-tertiary)' : 'var(--app-secondary)'}`}>{f.path}</span>
{f.note && <span style="font-size: 11px; color: var(--app-tertiary)">{f.note}</span>}
</li>
))}
</ul>
<div style="display: flex; align-items: center; gap: 8px; padding: 12px 20px; border-top: 1px solid var(--app-border)">
<span style="flex-grow: 1; font-size: 11px; line-height: 16px; color: var(--app-tertiary)">Your own edits since then are left alone.</span>
<span style={`${btn} color: var(--app-secondary)`}>Cancel</span>
<span style={`${btn} background: var(--app-accent); color: var(--app-accent-fg)`}><Icon name="arrowCounterClockwise" size="14" />Rewind 2 files</span>
</div>
</div>
