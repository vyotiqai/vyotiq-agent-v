---
/**
 * An approval card (features/task/record/ApprovalCard.tsx): a terminal command waiting a
 * minute, with the default 5 minute command timeout and the 15 minute answer window.
 */
import Glyph from './Glyph.astro'
import Icon from './Icon.astro'

const mono = 'font-family: var(--app-mono);'
const btn = 'height: 28px; box-sizing: border-box; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-radius: 6px; font-size: 12px; font-weight: 500; white-space: nowrap;'
---
<div style="width: 520px; box-sizing: border-box; border: 1px solid var(--app-accent); border-radius: 8px; overflow: hidden; background: var(--app-bg); font-family: var(--app-font); font-size: 13px; line-height: 20px; letter-spacing: 0; color: var(--app-fg); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2), 0 24px 60px -16px rgba(0, 0, 0, 0.52)">
<div style="height: 32px; display: flex; align-items: center; gap: 8px; padding: 0 12px; background: var(--app-accent-soft); font-size: 12px; line-height: 18px">
<Glyph kind="needs" size="12" />
<span style="font-weight: 600; color: var(--app-accent)">Needs you — run a command?</span>
<span style="flex-grow: 1"></span>
<span style={`${mono} font-size: 11px; color: var(--app-tertiary)`}>1m ago</span>
</div>
<div style="padding: 12px; display: flex; flex-direction: column; gap: 12px">
<div style={`border: 1px solid var(--app-border); border-radius: 6px; background: var(--app-sunken); padding: 8px 12px; ${mono} font-size: 12px; line-height: 18px; color: var(--app-fg-strong)`}><span style="color: var(--app-tertiary)">$ </span>pnpm db:migrate --env test</div>
<div style="font-size: 12px; line-height: 18px; color: var(--app-muted)">Can change files or run code · times out after 5 min · denied automatically in 14 min</div>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding-top: 2px">
<span style={`${btn} background: var(--app-accent); color: var(--app-accent-fg)`}><Icon name="check" size="14" />Allow once</span>
<span style={`${btn} border: 1px solid var(--app-border); background: var(--app-bg); color: var(--app-fg)`}>Allow for this task</span>
<span style={`${btn} color: var(--app-secondary)`}>Always allow<span style={`${mono} font-size: 11px`}>pnpm db:migrate</span></span>
<span style="flex-grow: 1"></span>
<span style={`${btn} border: 1px solid var(--app-border); background: var(--app-bg); color: var(--app-danger)`}>Deny</span>
</div>
</div>
</div>
