---
/**
 * The inspector's Changes tab for a finished task (features/inspector/ChangesColumn.tsx,
 * chat/components/ChangesPanel.tsx and ReviewChecks.tsx): its checks, then each file it
 * touched with its diff, then Keep, Undo and Commit. Two new files are folded by hand.
 */
import Glyph from './Glyph.astro'
import Icon from './Icon.astro'
import Mark from './Mark.astro'

const mono = 'font-family: var(--app-mono);'
const tabs = ['Changes', 'Files', 'Terminal', 'Browser', 'PR', 'Plan']
// github-dark, the diff's syntax theme
const k = (s: string) => `<span style="color:#F97583">${s}</span>`
const str = (s: string) => `<span style="color:#9ECBFF">${s}</span>`
const fn = (s: string) => `<span style="color:#B392F0">${s}</span>`
const files = [
  { letter: 'A', icon: 'typescript', name: 'rateLimit.ts', dir: 'src/middleware', add: '+58', del: '', open: false },
  { letter: 'A', icon: 'test-ts', name: 'rateLimit.test.ts', dir: 'test', add: '+28', del: '', open: false },
  { letter: 'M', icon: 'routing', name: 'router.ts', dir: 'src/server', add: '+2', del: '−1', open: true },
  { letter: 'M', icon: 'typescript', name: 'config.ts', dir: 'src', add: '+6', del: '−5', open: false }
] as const
const rows: { n: string; sign: '' | '+' | '−'; code: string }[] = [
  { n: '10', sign: '', code: `${k('import')} { orders } ${k('from')} ${str("'./routes/orders'")}` },
  { n: '11', sign: '', code: `${k('import')} { products } ${k('from')} ${str("'./routes/products'")}` },
  { n: '12', sign: '+', code: `${k('import')} { rateLimit } ${k('from')} ${str("'../middleware/rateLimit'")}` },
  { n: '13', sign: '', code: '' },
  { n: '14', sign: '', code: `${k('export const')} router ${k('=')} ${fn('Router')}()` },
  { n: '', sign: '−', code: `router.${fn('use')}(auth)` },
  { n: '15', sign: '+', code: `router.${fn('use')}(auth, ${fn('rateLimit')}({ perMinute: config.rateLimitPerMinute }))` },
  { n: '16', sign: '', code: `router.${fn('use')}(${str("'/orders'")}, orders)` },
  { n: '17', sign: '', code: `router.${fn('use')}(${str("'/products'")}, products)` }
]
const tint = { '': '', '+': 'background: var(--app-diff-add);', '−': 'background: var(--app-diff-del);' }
const signColor = { '': 'transparent', '+': 'var(--app-success)', '−': 'var(--app-danger)' }
const btn = 'height: 28px; box-sizing: border-box; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-radius: 6px; font-size: 12px; font-weight: 500;'
const seg = 'height: 20px; display: inline-flex; align-items: center; padding: 0 6px; border-radius: 4px;'
---
<div style="width: 600px; height: 520px; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; background: var(--app-bg); border: 1px solid var(--app-frame); border-radius: 8px; font-family: var(--app-font); font-size: 13px; line-height: 20px; letter-spacing: 0; color: var(--app-fg); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2), 0 30px 70px -24px rgba(0, 0, 0, 0.52)">
<div style="height: 40px; flex-shrink: 0; box-sizing: border-box; border-bottom: 1px solid var(--app-border); display: flex; align-items: stretch; gap: 8px; padding: 0 8px 0 12px">
<span style="display: flex; align-items: stretch; gap: 8px; font-size: 12px; font-weight: 500">
{tabs.map((t, i) => (
<span style={`position: relative; display: flex; align-items: center; gap: 6px; padding: 0 4px; color: ${i === 0 ? 'var(--app-fg-strong)' : 'var(--app-muted)'}`}>{t}{i === 0 && <span style={`${mono} font-size: 11px; color: var(--app-tertiary)`}>4</span>}{i === 0 && <span style="position: absolute; left: 4px; right: 4px; bottom: -1px; height: 2px; border-radius: 999px; background: var(--app-fg-strong)"></span>}</span>
))}
</span>
<span style="flex-grow: 1"></span>
<span style="display: flex; align-items: center; gap: 8px; color: var(--app-tertiary)"><span style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center"><Icon name="arrowsOut" size="13" /></span><span style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center"><Icon name="x" size="13" /></span></span>
</div>
<div style="height: 40px; flex-shrink: 0; box-sizing: border-box; border-bottom: 1px solid var(--app-border); display: flex; align-items: center; gap: 8px; padding: 0 8px; font-size: 12px; line-height: 18px">
<span style="height: 24px; display: flex; align-items: center; gap: 6px; padding: 0 8px; border-radius: 6px; color: var(--app-secondary)">This task<Icon name="caretDown" size="12" color="var(--app-tertiary)" /></span>
<span style="color: var(--app-muted)">4 files</span>
<span style={`display: flex; gap: 6px; ${mono} font-size: 11px`}><span style="color: var(--app-success)">+94</span><span style="color: var(--app-danger)">−6</span></span>
<span style="flex-grow: 1"></span>
<span style="height: 24px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 4px; padding: 2px; border-radius: 6px; background: var(--app-surface)"><span style={`${seg} background: var(--app-bg); color: var(--app-fg-strong); box-shadow: 0 0 0 1px var(--app-border)`}><Icon name="rows" size="13" /></span><span style={`${seg} color: var(--app-muted)`}><Icon name="columns" size="13" /></span></span>
<span style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; color: var(--app-tertiary)"><Icon name="dotsThree" size="13" /></span>
</div>
<div style="flex-shrink: 0; border-bottom: 1px solid var(--app-border); padding: 8px 12px">
<div style="height: 24px; display: flex; align-items: center; gap: 6px; font-size: 11px; line-height: 16px; color: var(--app-tertiary)"><Glyph kind="review" size="12" />3 of 3 checks met<Icon name="caretRight" size="10" /></div>
</div>

<div style="flex-grow: 1; min-height: 0; overflow: hidden">
{files.map((f) => (
<div style="border-bottom: 1px solid var(--app-divider)">
<div style="height: 36px; display: flex; align-items: center; gap: 8px; padding: 0 12px; background: var(--app-bg); font-size: 12px; line-height: 18px">
<Icon name={f.open ? 'caretDown' : 'caretRight'} size="11" color="var(--app-tertiary)" />
<span style={`width: 12px; ${mono} font-size: 11px; font-weight: 600; color: ${f.letter === 'A' ? 'var(--app-success)' : 'var(--app-muted)'}`}>{f.letter}</span>
<Mark file={f.icon} size="14" />
<span>{f.name}</span>
<span style="flex-grow: 1; font-size: 11px; line-height: 16px; color: var(--app-tertiary)">{f.dir}</span>
<span style={`display: flex; gap: 6px; ${mono} font-size: 11px`}><span style="color: var(--app-success)">{f.add}</span>{f.del && <span style="color: var(--app-danger)">{f.del}</span>}</span>
</div>
{f.open && (
<div style={`background: var(--app-sunken); padding: 4px 0; ${mono} font-size: 12px; line-height: 18px`}>
<div style="padding: 1px 12px; background: var(--app-surface); color: var(--app-muted)">@@ -10,7 +10,8 @@ import {'{'} Router {'}'} from 'express'</div>
{rows.map((r) => (
<div style={`display: flex; ${tint[r.sign]}`}>
<span style="width: 36px; flex-shrink: 0; box-sizing: border-box; padding-right: 4px; text-align: right; color: var(--app-tertiary)">{r.n}</span>
<span style={`width: 20px; flex-shrink: 0; text-align: center; color: ${signColor[r.sign]}`}>{r.sign || ' '}</span>
<span style="padding-right: 16px; white-space: pre; color: #E1E4E8" set:html={r.code || ' '}></span>
</div>
))}
</div>
)}
</div>
))}
</div>

<div style="flex-shrink: 0; border-top: 1px solid var(--app-border); padding: 12px; display: flex; flex-direction: column; gap: 10px">
<div style={`${mono} font-size: 12px; line-height: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis`}>Add per-key rate limiting to the public API</div>
<div style="display: flex; align-items: center; gap: 6px">
<span style={`${btn} color: var(--app-secondary)`}><Icon name="arrowCounterClockwise" size="14" />Undo all</span>
<span style="flex-grow: 1"></span>
<span style={`${btn} border: 1px solid var(--app-border); background: var(--app-bg); color: var(--app-fg)`}>Keep all</span>
<span style={`${btn} background: var(--app-accent); color: var(--app-accent-fg)`}>Commit<span style="display: flex; opacity: 0.7"><Icon name="caretDown" size="12" /></span></span>
</div>
</div>
</div>
