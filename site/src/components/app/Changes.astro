---
const mono = 'font-family: var(--app-mono); font-size: 11px; font-weight: 600; width: 12px; '
const f = (letter: string, name: string, dir: string, add: string, del: string, sel = false) => ({
  letter, name, dir, add, del,
  letterStyle: mono + 'color: ' + (letter === 'A' ? 'var(--app-success)' : 'var(--app-muted)'),
  rowStyle: 'height: 28px; display: flex; align-items: center; gap: 8px; padding: 0 8px; border-radius: 6px;' + (sel ? ' background: var(--app-surface-2)' : '')
})
const add = 'background: var(--app-success-soft); '
const r = (n: string, sign: string, code: string, bg = '') => ({
  n, sign, code,
  rowStyle: 'display: flex; ' + (bg || ''),
  signStyle: 'width: 20px; flex-shrink: 0; text-align: center; color: ' + (sign === '+' ? 'var(--app-success)' : 'var(--app-danger)')
})
const files = [
  f('A', 'rateLimit.ts', 'src/middleware', '+58', '', true),
  f('A', 'rateLimit.test.ts', 'test', '+28', ''),
  f('M', 'router.ts', 'src/server', '+2', '−1'),
  f('M', 'config.ts', 'src', '+6', '−5')
]
const diff = [
  r('1', '+', "import type { Request, Response, NextFunction } from 'express'", add),
  r('2', '+', '', add),
  r('3', '+', 'export function rateLimit({ perMinute }: { perMinute: number }) {', add),
  r('4', '+', '  const buckets = new Map<string, { tokens: number; at: number }>()', add),
  r('5', '+', '  return (req: Request, res: Response, next: NextFunction) => {', add),
  r('6', '+', "    const key = req.header('x-api-key') ?? req.ip", add),
  r('7', '+', '    const b = refill(buckets, key, perMinute)', add),
  r('8', '+', '    if (b.tokens < 1) {', add),
  r('9', '+', "      res.set('Retry-After', String(secondsUntil(b)))", add),
  r('10', '+', '      return res.status(429).end()', add)
]
---
<div style="width: 600px; height: 520px; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; background: var(--app-bg); border: 1px solid var(--app-frame); border-radius: 10px; font-family: var(--app-font); font-size: 13px; line-height: 20px; color: var(--app-fg); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2), 0 30px 70px -24px rgba(0, 0, 0, 0.52)">
<div style="height: 40px; flex-shrink: 0; box-sizing: border-box; border-bottom: 1px solid var(--app-border); display: flex; align-items: stretch; gap: 18px; padding: 0 8px 0 16px; font-size: 12px; font-weight: 500">
<span style="display: flex; align-items: center; gap: 5px; color: var(--app-fg-strong); box-shadow: inset 0 -2px 0 var(--app-fg-strong)">Changes <span style="font-family: var(--app-mono); font-weight: 400; color: var(--app-tertiary)">4</span></span>
<span style="display: flex; align-items: center; color: var(--app-muted)">Files</span>
<span style="display: flex; align-items: center; color: var(--app-muted)">Terminal</span>
<span style="display: flex; align-items: center; color: var(--app-muted)">Browser</span>
<span style="display: flex; align-items: center; color: var(--app-muted)">PR</span>
<span style="display: flex; align-items: center; color: var(--app-muted)">Plan</span>
<span style="flex-grow: 1"></span>
<span style="display: flex; align-items: center; color: var(--app-muted)"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M9.5 2.5h4v4M13.5 2.5L9 7M6.5 13.5h-4v-4M2.5 13.5L7 9"></path></svg></span>
<span style="display: flex; align-items: center; color: var(--app-muted)"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"></path></svg></span>
</div>
<div style="height: 36px; flex-shrink: 0; display: flex; align-items: center; gap: 10px; padding: 0 12px; font-size: 12px; color: var(--app-secondary); border-bottom: 1px solid var(--app-divider)">
<span style="display: flex; align-items: center; gap: 4px; font-weight: 500">This task<svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6l4 4 4-4"></path></svg></span>
<span style="display: flex; align-items: center; gap: 4px; font-family: var(--app-mono); font-size: 11px; color: var(--app-muted)"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="4.5" cy="3.5" r="1.5"></circle><circle cx="4.5" cy="12.5" r="1.5"></circle><circle cx="11.5" cy="5" r="1.5"></circle><path d="M4.5 5v6M11.5 6.5a4 4 0 0 1-4 4h-3"></path></svg>main</span>
<span style="flex-grow: 1"></span>
<span style="color: var(--app-muted)">4 files</span>
<span style="font-family: var(--app-mono); font-size: 11px"><span style="color: var(--app-success)">+94</span> <span style="color: var(--app-danger)">−6</span></span>
<span style="display: inline-flex; align-items: center; height: 28px; box-sizing: border-box; padding: 2px; border-radius: 6px; background: var(--app-surface)"><span style="height: 24px; display: inline-flex; align-items: center; padding: 0 8px; border-radius: 4px; background: var(--app-bg); color: var(--app-fg-strong); box-shadow: 0 0 0 1px var(--app-border)"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="3" width="11" height="4" rx="0.5"></rect><rect x="2.5" y="9" width="11" height="4" rx="0.5"></rect></svg></span><span style="height: 24px; display: inline-flex; align-items: center; padding: 0 8px; color: var(--app-muted)"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="2.5" width="4" height="11" rx="0.5"></rect><rect x="9" y="2.5" width="4" height="11" rx="0.5"></rect></svg></span></span>
<span style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; color: var(--app-muted)"><svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="3.5" cy="8" r="1"></circle><circle cx="8" cy="8" r="1"></circle><circle cx="12.5" cy="8" r="1"></circle></svg></span>
</div>
<div style="padding: 4px 8px; display: flex; flex-direction: column">
{files.map((f) => (<Fragment>
<div style={f.rowStyle}>
<span style={f.letterStyle}>{f.letter}</span>
<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="var(--app-info)" stroke-width="1.2" aria-hidden="true"><path d="M4 2h5l3 3v9H4z"></path><path d="M9 2v3h3"></path></svg>
<span style="font-size: 12px; color: var(--app-fg)">{f.name}</span>
<span style="flex-grow: 1; font-size: 11px; color: var(--app-tertiary)">{f.dir}</span>
<span style="font-family: var(--app-mono); font-size: 11px"><span style="color: var(--app-success)">{f.add}</span> <span style="color: var(--app-danger)">{f.del}</span></span>
</div>
</Fragment>))}
</div>
<div style="margin: 4px 12px 0; border: 1px solid var(--app-border); border-radius: 8px; overflow: hidden; flex-grow: 1; min-height: 0; display: flex; flex-direction: column">
<div style="height: 32px; flex-shrink: 0; display: flex; align-items: center; gap: 8px; padding: 0 10px; border-bottom: 1px solid var(--app-border)">
<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="var(--app-info)" stroke-width="1.2" aria-hidden="true"><path d="M4 2h5l3 3v9H4z"></path><path d="M9 2v3h3"></path></svg>
<span style="flex-grow: 1; font-family: var(--app-mono); font-size: 11px">src/middleware/rateLimit.ts</span>
<span style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; color: var(--app-muted)"><svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 6.25V2.5H9.75M9 7l4.5-4.5M11.5 9v4a.5.5 0 0 1-.5.5H3a.5.5 0 0 1-.5-.5V5a.5.5 0 0 1 .5-.5h4"></path></svg></span>
<span style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; color: var(--app-muted); opacity: 0.45"><svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10l5-5 5 5"></path></svg></span>
<span style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; color: var(--app-muted)"><svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6l5 5 5-5"></path></svg></span>
</div>
<div style="background: var(--app-sunken); flex-grow: 1; font-family: var(--app-mono); font-size: 11.5px; line-height: 18px; padding: 4px 0">
{diff.map((d) => (<Fragment>
<div style={d.rowStyle}><span style="width: 30px; flex-shrink: 0; text-align: right; color: var(--app-tertiary)">{d.n}</span><span style={d.signStyle}>{d.sign}</span><span style="white-space: pre; color: var(--app-fg)">{d.code}</span></div>
</Fragment>))}
</div>
</div>
<div style="height: 48px; flex-shrink: 0; display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: 12px; font-weight: 500">
<span style="display: flex; align-items: center; gap: 6px; height: 28px; padding: 0 8px; color: var(--app-secondary)"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 3.5L2.5 6 5 8.5"></path><path d="M2.5 6h7a4 4 0 0 1 0 8H7"></path></svg>Undo all</span>
<span style="flex-grow: 1"></span>
<span style="height: 28px; box-sizing: border-box; display: flex; align-items: center; padding: 0 10px; border: 1px solid var(--app-border); border-radius: 6px; color: var(--app-fg)">Keep all</span>
<span style="height: 28px; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-radius: 6px; background: var(--app-accent); color: var(--app-accent-fg)">Commit<svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6l4 4 4-4"></path></svg></span>
</div>
</div>
