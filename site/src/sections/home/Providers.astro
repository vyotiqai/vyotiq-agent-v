---
/** Wordmarks set in type, not logos: the names are the claim. */
const providers: [string, string][] = [
  ['OpenAI', 'font-weight: 600; letter-spacing: -0.03em'],
  ['Anthropic', 'font-weight: 500; letter-spacing: 0.02em'],
  ['Gemini', 'font-weight: 500; letter-spacing: -0.02em'],
  ['Ollama', 'font-weight: 600; letter-spacing: -0.02em'],
  ['DeepSeek', 'font-weight: 600; letter-spacing: -0.03em'],
  ['Groq', 'font-weight: 600; letter-spacing: -0.04em'],
  ['OpenRouter', 'font-weight: 500; letter-spacing: -0.02em'],
  ['xAI', 'font-weight: 600; letter-spacing: -0.02em'],
  ['Mistral', 'font-weight: 600; letter-spacing: 0.01em; text-transform: uppercase; font-size: 0.95em'],
  ['OpenCode', 'font-family: var(--mono); font-weight: 500; font-size: 0.85em']
]
---
<section class="wrap strip" aria-label="Model providers">
  <p>Runs on the models you choose</p>
  <ul>
    {providers.map(([name, style]) => <li style={style}>{name}</li>)}
  </ul>
</section>

<style>
  .strip { margin-top: 64px; min-height: 112px; border-block: 1px solid var(--hair); display: flex; align-items: center; gap: 48px; }
  p { width: 130px; flex-shrink: 0; font-size: 15px; line-height: 1.35; color: var(--nav); }
  ul { padding: 0; list-style: none; flex-grow: 1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 22px; font-size: 22px; color: var(--faint); white-space: nowrap; }
  @media (max-width: 1023px) {
    .strip { flex-direction: column; align-items: flex-start; gap: 14px; padding-block: 22px; }
    p { width: auto; font-size: 14px; }
    ul { justify-content: flex-start; font-size: 18px; }
  }
  @media (max-width: 639px) { .strip { margin-top: 44px; } }
</style>
