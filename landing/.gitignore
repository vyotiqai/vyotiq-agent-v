dist/
.astro/
node_modules/

# Baked at build time from repo sources / the GitHub API — never hand-edited,
# never committed, so the site can't drift from what it claims to describe.
src/data/app.json
src/data/release.json
src/data/changelog.json
src/data/logos.json
src/generated/legal/
public/brand/

# public/shots/ IS committed. The images come from scripts/capture-shots.mjs
# booting the real application, and the pages that use them assert the files
# exist, so a clone has to carry them or the site loses its only product
# imagery. Only surfaces backed by real shipped data are captured there.
