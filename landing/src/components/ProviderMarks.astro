---
import { PROVIDERS } from '../lib/providers'

const files = import.meta.glob<string>('../assets/providers/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true
})

function providerSvg(id: string): string {
  const entry = Object.entries(files).find(([key]) => key.endsWith(`/${id}.svg`))
  if (entry == null) throw new Error(`missing provider mark: ${id}`)
  return entry[1]
}
---

<ul class="provider-list">
  {
    PROVIDERS.map((provider) => (
      <li>
        <span class="provider-mark" aria-hidden="true" set:html={providerSvg(provider.id)} />
        <span>{provider.name}</span>
      </li>
    ))
  }
  <li>
    <span class="provider-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M8 12h8M6 9v6M18 9v6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        <circle cx="4" cy="12" r="2" stroke="currentColor" stroke-width="1.75" />
        <circle cx="20" cy="12" r="2" stroke="currentColor" stroke-width="1.75" />
      </svg>
    </span>
    <span>Custom host</span>
  </li>
</ul>

<style>
  .provider-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-inline: 0;
    padding: 0;
    list-style: none;
  }

  .provider-list li {
    display: grid;
    grid-template-columns: 1.25rem auto;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .provider-mark {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
  }

  .provider-mark :global(svg) {
    display: block;
    width: 1rem;
    height: 1rem;
  }

</style>
