---
import { PROVIDERS } from '../lib/providers'
---

<section class="marks" aria-label="Supported model providers">
  <div class="wrap marks-row">
    <span class="marks-label mono">Models you can connect</span>
    <ul class="marks-list mono">
      {
        PROVIDERS.map((provider) => (
          <li>{provider.name}</li>
        ))
      }
      <li>Custom host</li>
    </ul>
  </div>
</section>

<style>
  .marks {
    background: var(--well);
  }

  .marks-row {
    display: flex;
    align-items: baseline;
    gap: 2rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }

  .marks-label {
    flex: none;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .marks-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .marks-list li {
    transition: color var(--duration, 150ms) var(--ease, ease);
  }

  .marks-list li:hover {
    color: var(--fg);
  }

  .marks-list li + li::before {
    content: '/';
    color: var(--border);
    margin-right: 1.25rem;
  }

  @media (max-width: 640px) {
    .marks-row {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
