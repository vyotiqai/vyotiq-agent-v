---
import release from '../data/release.json';

const version = release.tag ?? null;
const win = release.assets.windows.exe?.url ?? null;
const macArm = release.assets.macos.arm64?.url ?? null;
const macIntel = release.assets.macos.x64?.url ?? null;
const linux = release.assets.linux.appimage?.url ?? null;
---

<section class="relative flex min-h-[calc(100svh-4rem)] flex-col items-center justify-center overflow-hidden px-6 text-center">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero-grid absolute inset-0"></div>
    <div class="absolute left-1/2 top-0 h-72 w-72 -translate-x-1/2 rounded-full bg-orange-500/15 blur-3xl"></div>
  </div>

  {
    version && (
      <a href={release.url} target="_blank" rel="noopener noreferrer" class="mb-6 inline-flex items-center gap-2 rounded-full border border-zinc-200 px-3 py-1 text-xs font-medium text-zinc-600 transition-colors hover:border-orange-500/60 hover:text-zinc-900 dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-100">
        <span class="size-1.5 rounded-full bg-orange-500" aria-hidden="true" />
        Open source · {version}
      </a>
    )
  }

  <h1 class="max-w-3xl text-balance text-4xl font-bold tracking-tight text-zinc-900 sm:text-6xl dark:text-zinc-50">
    The coding workspace for <span class="text-orange-600 dark:text-orange-400">real repositories</span>.
  </h1>

  <p class="mt-6 max-w-xl text-pretty text-lg text-zinc-600 dark:text-zinc-400">
    Agent V plans, edits, and ships in your actual working tree — local-first, private by default, and completely free.
  </p>

  <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row">
    <a
      id="hero-download"
      href={win ?? (linux ?? '/#download')}
      class="inline-flex items-center gap-2 rounded-full bg-orange-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-orange-500"
      data-win={win} data-mac={macArm} data-linux={linux}
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true"><path d="M3 5.5 10.5 4.4v7.1H3V5.5Zm0 13v-6h7.5v7.1L3 18.5Zm8.5.2V12.5H21v10l-9.5-1.8Zm0-7.2V4.3L21 3v8.5h-9.5Z"/></svg>
      <span id="hero-download-label">Download now</span>
    </a>
    <a
      href="https://github.com/vyotiqai/vyotiq-agent-v"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-6 py-3 text-sm font-semibold text-zinc-700 transition-colors hover:border-zinc-400 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-600 dark:hover:bg-zinc-900"
    >
      Build from source
    </a>
  </div>

  <p class="mt-6 text-sm text-zinc-500 dark:text-zinc-500">Windows · macOS · Linux — free under GPL-3.0</p>

  <a href="#features" class="absolute bottom-8 text-zinc-400 transition-colors hover:text-zinc-600 dark:hover:text-zinc-300" aria-label="Scroll to features">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 animate-bounce" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </a>
</section>

<script is:inline>
  (() => {
    const ua = navigator.userAgent;
    const uaData = navigator.userAgentData?.platform || '';
    const isMac = /Mac|iPhone|iPad/.test(ua) || /mac/i.test(uaData);
    const isLinux = !isMac && (/Linux|X11/.test(ua) || /lin/i.test(uaData));
    const btn = document.getElementById('hero-download');
    const label = document.getElementById('hero-download-label');
    if (!btn || !label) return;
    const url = isMac ? btn.dataset.mac : isLinux ? btn.dataset.linux : btn.dataset.win;
    if (url) {
      btn.href = url;
      label.textContent = `Download for ${isMac ? 'macOS' : isLinux ? 'Linux' : 'Windows'}`;
    }
  })();
</script>
