---
import providerIcons from '../data/provider-icons.json';

const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_55%_40%_at_50%_0%,rgba(255,255,255,0.05),transparent)]"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="pt-20 sm:pt-28">
      <div
        class="flex flex-wrap items-center gap-2.5 sm:gap-3"
        aria-label="Supported model providers"
      >
        {
          providerIcons.map((p) => (
            <span
              class="grid size-12 place-items-center rounded-xl border border-white/10 bg-white/[0.03]"
              title={p.title}
            >
              <svg
                viewBox={p.viewBox}
                role="img"
                aria-label={p.title}
                class="size-6 text-zinc-200"
                fill="currentColor"
                fill-rule="evenodd"
              >
                <title>{p.title}</title>
                {p.paths.map((d) => <path d={d} />)}
              </svg>
            </span>
          ))
        }
      </div>

      <h1
        class="mt-10 text-4xl font-semibold leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-7xl"
      >
        Your coding workspace
        <span class="block text-zinc-500">for real repositories</span>
      </h1>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-zinc-400 sm:text-lg">
        Agent V pairs a natural-language agent harness with workspace tools, multi-provider chat,
        live context management, and file-backed long-term memory.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        <a
          href={`${REPO}#build-from-source`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-white px-7 py-3 font-semibold text-zinc-950 transition hover:bg-zinc-200 sm:w-auto"
        >
          Download
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 4v12m0 0-5-5m5 5 5-5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-white/15 bg-white/[0.03] px-7 py-3 font-semibold text-zinc-200 transition hover:border-white/30 hover:text-white sm:w-auto"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z"
          ></path>
          </svg>
          Star on GitHub
        </a>
      </div>
    </div>

    <img
      src="/media/agentv-hero.webp"
      alt="Agent V — real session screen recording"
      class="mt-16 w-full rounded-2xl border border-white/10 shadow-2xl shadow-black/40 sm:mt-20"
      decoding="async"
    />
  </div>
</section>
