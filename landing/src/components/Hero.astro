---
import release from '../data/release.json';
import providerIcons from '../data/provider-icons.json';
import osIcons from '../data/os-icons.json';

const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';

// Tag-page fallback: the baked release page when known, the releases listing
// otherwise. Installer URLs come only from the baked manifest - never invented.
const tagPageUrl =
  typeof release.url === 'string' && release.url ? release.url : `${REPO}/releases/latest`;

const realAsset = (asset) =>
  asset && typeof asset.url === 'string' && asset.url ? asset : null;

const formatSize = (bytes) => {
  if (typeof bytes !== 'number' || !Number.isFinite(bytes) || bytes <= 0) return null;
  const mb = bytes / (1024 * 1024);
  return mb >= 1000
    ? `${(mb / 1024).toFixed(2)} GB`
    : mb >= 100
      ? `${Math.round(mb)} MB`
      : `${mb.toFixed(1)} MB`;
};

const win = realAsset(release.assets?.windows);
const macArm = realAsset(release.assets?.macos?.arm64);
const macIntel = realAsset(release.assets?.macos?.x64);
const linApp = realAsset(release.assets?.linux?.appimage);
const linDeb = realAsset(release.assets?.linux?.deb);

// Menu entries: real installer when published, the release tag page otherwise.
// The deb entry only appears when a .deb asset exists in the release.
const osOptions = [
  { id: 'windows', name: 'Windows', asset: win, icon: osIcons.windows },
  { id: 'macos-arm64', name: 'macOS (Apple Silicon)', asset: macArm, icon: osIcons.macos },
  { id: 'macos-x64', name: 'macOS (Intel)', asset: macIntel, icon: osIcons.macos },
  { id: 'linux-appimage', name: 'Linux (AppImage)', asset: linApp, icon: osIcons.linux },
  ...(linDeb ? [{ id: 'linux-deb', name: 'Linux (deb)', asset: linDeb, icon: osIcons.linux }] : []),
].map((option) => ({
  ...option,
  href: option.asset?.url ?? tagPageUrl,
  size: formatSize(option.asset?.size),
}));

const releaseDate = (() => {
  if (typeof release.publishedAt !== 'string' || !release.publishedAt) return null;
  const date = new Date(release.publishedAt);
  return Number.isNaN(date.getTime())
    ? null
    : new Intl.DateTimeFormat('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC',
      }).format(date);
})();

const hasRelease =
  release.source === 'github' && typeof release.version === 'string' && release.version !== '';
---

<section class="relative">
  <div class="av-max mx-auto px-4 sm:px-6 lg:px-10">
    <div class="mx-auto max-w-3xl pt-16 text-center sm:pt-20 md:pt-24">
      <img
        src="/brand/vyotiq-app-icon.svg"
        alt=""
        width="56"
        height="56"
        class="mx-auto size-14"
        aria-hidden="true"
      />
      <h1
        class="mt-6 text-[clamp(2.4rem,5vw,4.25rem)] font-semibold leading-[1.05] tracking-tight text-[var(--av-ink)]"
      >
        Meet Agent V.
        <span class="block text-[color-mix(in_srgb,var(--av-ink)_55%,transparent)]">Your repo's new teammate.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-[color-mix(in_srgb,var(--av-ink)_60%,transparent)] sm:text-lg">
        A free, open-source coding agent that sits in your workspace: reads your code, makes the
        change, runs it, checks its own work. With the models you already use.
      </p>

      <div class="mt-8 flex flex-col items-stretch justify-center gap-2.5 sm:flex-row sm:items-center sm:gap-2.5">
        <div class="relative mx-auto w-full sm:mx-0 sm:w-auto" data-os-picker>
          <div class="av-cta-split w-full sm:w-auto">
            <a
              href={tagPageUrl}
              data-os-primary
              data-os-default-url={tagPageUrl}
              class="av-cta-primary flex min-w-0 flex-1 items-center justify-center gap-2 px-5 py-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--av-accent)] sm:flex-none"
            >
              <svg
                data-os-primary-icon
                class="hidden size-4 shrink-0"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              ></svg>
              <span class="font-semibold">Download Agent V</span>
              <span data-os-primary-os class="hidden text-sm font-medium text-[color-mix(in_srgb,var(--av-on-cta)_72%,transparent)] sm:inline"></span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M12 4v12m0 0-5-5m5 5 5-5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
            <button
              type="button"
              data-os-toggle
              aria-expanded="false"
              aria-controls="os-download-menu"
              aria-haspopup="true"
              aria-label="Choose download for your operating system"
              class="av-cta-primary flex items-center justify-center px-3.5 py-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--av-accent)]"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-os-chevron class="transition">
                <path
                  d="m6 9 6 6 6-6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
          <div
            id="os-download-menu"
            data-os-menu
            class="absolute left-0 top-full z-30 mt-1.5 hidden w-72 rounded border border-[var(--av-hairline)] bg-[var(--av-bg)] p-1.5 text-left shadow-lg shadow-[var(--av-shadow)]"
          >
              <p class="px-2.5 pb-1.5 pt-1 text-xs font-medium uppercase tracking-wide text-[var(--av-muted)]">
                Download for
              </p>
              <ul class="flex flex-col" aria-label="Download options">
                {
                  osOptions.map((option) => (
                    <li>
                      <a
                        href={option.href}
                        data-os-item
                        data-os-id={option.id}
                        data-os-url={option.asset?.url ?? ''}
                        data-os-name={option.name}
                        data-os-size={option.size ?? ''}
                        data-os-icon-viewbox={option.icon.viewBox}
                        data-os-icon-paths={JSON.stringify(option.icon.paths)}
                        class="group flex items-center justify-between gap-3 rounded-md px-2.5 py-2 text-sm text-[var(--av-ink)] transition hover:bg-[var(--av-panel)] focus-visible:bg-[var(--av-panel)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--av-accent)] data-[detected]:bg-[color-mix(in_srgb,var(--av-accent)_8%,transparent)] data-[detected]:text-[var(--av-ink)]"
                      >
                        <span class="flex min-w-0 items-center gap-2.5">
                          <svg
                            viewBox={option.icon.viewBox}
                            class="size-4 shrink-0 text-[var(--av-muted)] group-data-[detected]:text-[var(--av-accent)]"
                            fill="currentColor"
                            aria-hidden="true"
                          >
                            {option.icon.paths.map((d) => (
                              <path d={d} />
                            ))}
                          </svg>
                          <span class="truncate font-medium">{option.name}</span>
                          <span class="hidden shrink-0 text-xs font-semibold text-[var(--av-accent)] group-data-[detected]:inline">
                            Detected
                          </span>
                        </span>
                        <span class="shrink-0 text-xs tabular-nums text-[var(--av-muted)]">{option.size}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          {
            hasRelease ? (
              <p
                class="mt-2.5 flex flex-wrap items-center justify-center gap-x-1.5 text-xs text-[var(--av-muted)]"
                data-os-meta
              >
                <span class="font-medium text-[var(--av-ink)]">v{release.version}</span>
                {releaseDate ? <span>· released {releaseDate}</span> : null}
                <span data-os-primary-size class="hidden" />
              </p>
            ) : null
          }
        </div>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="av-cta-secondary inline-flex w-full items-center justify-center gap-2 px-5 text-sm sm:w-auto"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12c0-6.63-5.37-12-12-12Z"
            ></path>
          </svg>
          View on GitHub
        </a>
      </div>

      <p class="mt-5 text-xs text-[var(--av-muted)]">Free and open source. Runs on your machine.</p>
      <a href="#intro" class="av-cta-secondary mt-8 inline-flex !min-h-0 gap-1.5 px-4 py-2 text-[13px] font-medium">Learn more
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div id="providers" class="mt-10 scroll-mt-24 border-t border-[var(--av-hairline)] pt-10 sm:mt-12 sm:pt-12">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
        <div class="max-w-xl">
          <p class="text-xs font-semibold uppercase tracking-wider text-[var(--av-muted)]">
            Multi-provider
          </p>
          <h2 class="mt-2 text-lg font-semibold tracking-tight text-[var(--av-ink)] sm:text-xl">
            Bring your own models
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-[var(--av-muted)] sm:text-[15px]">
            OpenAI, Anthropic, Gemini, Ollama, DeepSeek, Groq, OpenRouter, xAI, Mistral, OpenCode, and custom endpoints. Your keys stay on your machine.
          </p>
        </div>
        <ul
          class="flex flex-wrap items-center gap-2 lg:max-w-md lg:justify-end"
          aria-label="Supported model providers"
        >
          {
            providerIcons.map((p) => (
              <li>
                <span
                  class="grid size-9 place-items-center rounded border border-[var(--av-hairline)] bg-[var(--av-panel)]"
                  title={p.title}
                >
                  <svg
                    viewBox={p.viewBox}
                    role="img"
                    aria-label={p.title}
                    class="size-[18px] text-[color-mix(in_srgb,var(--av-ink)_75%,transparent)]"
                    fill="currentColor"
                    fill-rule="evenodd"
                  >
                    <title>{p.title}</title>
                    {p.paths.map((d) => (
                      <path d={d} />
                    ))}
                  </svg>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-os-picker]');

  if (root) {
    const primary = root.querySelector<HTMLAnchorElement>('[data-os-primary]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-os-toggle]');
    const menu = root.querySelector<HTMLElement>('[data-os-menu]');
    const chevron = root.querySelector<HTMLElement>('[data-os-chevron]');
    const primaryOs = root.querySelector<HTMLElement>('[data-os-primary-os]');
    const primarySize = root.querySelector<HTMLElement>('[data-os-primary-size]');
    const items = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-os-item]'));
    const tagUrl = primary?.getAttribute('data-os-default-url') ?? '';
    let open = false;

    const setOpen = (next: boolean) => {
      open = next;
      menu?.classList.toggle('hidden', !open);
      chevron?.classList.toggle('rotate-180', open);
      toggle?.setAttribute('aria-expanded', String(open));
    };

    toggle?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      setOpen(!open);
    });

    toggle?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        setOpen(true);
        (event.key === 'ArrowDown' ? items[0] : items[items.length - 1])?.focus();
      }
    });

    menu?.addEventListener('keydown', (event) => {
      const index = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        items[(index + 1) % items.length]?.focus();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        items[(index - 1 + items.length) % items.length]?.focus();
      } else if (event.key === 'Escape') {
        setOpen(false);
        toggle?.focus();
      }
    });

    items.forEach((item) => {
      item.addEventListener('click', () => {
        clearDetection();
        markDetected(item);
      });
    });
    document.addEventListener('click', (event) => {
      if (open && event.target instanceof Node && !root.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) setOpen(false);
    });

    // OS/arch detection: navigator.userAgentData.platform first, UA-string
    // fallback; Apple Silicon vs Intel via high-entropy hints when available.
    interface NavigatorUADataLike {
      platform?: string;
      getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string }>;
    }
    const uaData = (navigator as Navigator & { userAgentData?: NavigatorUADataLike })
      .userAgentData;
    const ua = navigator.userAgent;
    const platformHint = uaData?.platform ?? '';

    const detectOs = (): 'windows' | 'macos' | 'linux' | null => {
      if (/mac/i.test(platformHint)) return 'macos';
      if (/win/i.test(platformHint)) return 'windows';
      if (/linux|cros/i.test(platformHint)) return 'linux';
      if (/Win/i.test(ua) && !/Android/i.test(ua)) return 'windows';
      if (/Mac/i.test(ua) && !/iPhone|iPad/i.test(ua)) return 'macos';
      if (/Linux|X11/i.test(ua) && !/Android/i.test(ua)) return 'linux';
      return null;
    };

    const detectArch = async (): Promise<'arm64' | 'x64' | null> => {
      try {
        const hints = await uaData?.getHighEntropyValues?.(['architecture']);
        if (hints?.architecture === 'arm') return 'arm64';
        if (hints?.architecture === 'x86') return 'x64';
      } catch {
        // High-entropy hints unavailable - the default pick stands.
      }
      return null;
    };

    const byId = (id: string) => items.find((item) => item.dataset.osId === id);

    const primaryIcon = root.querySelector<SVGElement>('[data-os-primary-icon]');

    const setPrimaryIcon = (item: HTMLAnchorElement) => {
      if (!primaryIcon) return;
      const viewBox = item.dataset.osIconViewbox;
      const rawPaths = item.dataset.osIconPaths;
      if (!viewBox || !rawPaths) {
        primaryIcon.classList.add('hidden');
        primaryIcon.innerHTML = '';
        return;
      }
      let paths: string[] = [];
      try {
        paths = JSON.parse(rawPaths) as string[];
      } catch {
        primaryIcon.classList.add('hidden');
        return;
      }
      primaryIcon.setAttribute('viewBox', viewBox);
      primaryIcon.innerHTML = paths.map((d) => `<path d="${d}"></path>`).join('');
      primaryIcon.classList.remove('hidden');
    };

    const markDetected = (item: HTMLAnchorElement | undefined) => {
      if (!item) return;
      item.setAttribute('data-detected', '');
      item.setAttribute('aria-current', 'true');
      if (primaryOs && item.dataset.osName) primaryOs.textContent = `for ${item.dataset.osName}`;
      // Real installer when baked; tag-page URL otherwise - never a dead link.
      if (primary) primary.setAttribute('href', item.dataset.osUrl || tagUrl);
      setPrimaryIcon(item);
      if (primarySize) {
        const size = item.dataset.osSize || '';
        primarySize.textContent = size ? `\u00B7 ${size}` : '';
        primarySize.classList.toggle('hidden', !size);
      }
    };


    const clearDetection = () => {
      items.forEach((item) => {
        item.removeAttribute('data-detected');
        item.removeAttribute('aria-current');
      });
    };

    const applyDetection = (os: 'windows' | 'macos' | 'linux', arch?: string | null) => {
      if (!os) return;
      const ids =
        os === 'macos'
          ? ['macos-arm64', 'macos-x64']
          : os === 'linux'
            ? ['linux-appimage', 'linux-deb']
            : ['windows'];
      const picked =
        byId(`${os}-${arch ?? ''}`) ??
        byId(ids.find((id) => byId(id)?.dataset.osUrl) ?? '') ??
        byId(ids[0]);
      markDetected(picked);
    };

    const os = detectOs();
    if (os === 'macos') {
      applyDetection('macos'); // Apple Silicon default, refined below when hints exist
      detectArch().then((arch) => {
        if (!arch) return;
        clearDetection();
        applyDetection('macos', arch);
      });
    } else {
      applyDetection(os);
    }
  }
</script>
