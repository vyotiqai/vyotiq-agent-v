---
import { Image } from 'astro:assets';
import release from '../data/release.json';
import heroApp from '../assets/hero-app.png';
import providerIcons from '../data/provider-icons.json';

const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';
const downloadHref =
  release.version && release.url ? release.url : `${REPO}#build-from-source`;
---

<section class="relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="pt-12 text-center sm:pt-16">
      <h1
        class="mx-auto max-w-3xl text-5xl font-semibold leading-[1.05] tracking-tight text-zinc-950 sm:text-6xl lg:text-7xl"
      >
        Meet Agent V.
        <span class="block text-zinc-500">Your repo's new teammate.</span>
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-zinc-600 sm:text-lg">
        The coding agent that sits in your workspace — reads your code, makes the change, runs it,
        and checks its own work. Locally, with the models you already use.
      </p>

      <div class="mt-7 flex flex-col items-center gap-3 sm:flex-row sm:justify-center sm:gap-4">
        <a
          href={downloadHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-zinc-900 px-7 py-3 font-semibold text-white transition hover:bg-zinc-700 sm:w-auto"
        >
          Get Agent V
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 4v12m0 0-5-5m5 5 5-5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-zinc-300 bg-white px-7 py-3 font-semibold text-zinc-900 transition hover:border-zinc-400 sm:w-auto"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z"
          ></path>
          </svg>
          View on GitHub
        </a>
      </div>

      <p class="mt-4 text-xs text-zinc-500">Free and open source. Runs on your machine.</p>

      <div
        class="mt-8 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3"
        aria-label="Supported model providers"
      >
        {
          providerIcons.map((p) => (
            <span
              class="grid size-9 place-items-center rounded-lg border border-zinc-200 bg-white shadow-sm"
              title={p.title}
            >
              <svg
                viewBox={p.viewBox}
                role="img"
                aria-label={p.title}
                class="size-[18px] text-zinc-700"
                fill="currentColor"
                fill-rule="evenodd"
              >
                <title>{p.title}</title>
                {p.paths.map((d) => <path d={d} />)}
              </svg>
            </span>
          ))
        }
      </div>
    </div>

    <figure class="mt-12 sm:mt-14">
      <Image
        src={heroApp}
        alt="Agent V — real workspace: three parallel agent instances finishing while a 45-file verified change set is reviewed"
        format="png"
        widths={[640, 960, 1280, 1920]}
        sizes="(min-width: 80rem) 1216px, 92vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="relative h-auto w-full rounded-lg border border-zinc-200 shadow-2xl shadow-zinc-900/10"
      />
    </figure>
  </div>
</section>
