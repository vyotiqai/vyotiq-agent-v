---
import LandingIcon from './LandingIcon.astro'
---
{/* A stylized Agent V window: dock rail, file tree, agent chat with tool
    rows, composer with the mode picker, and the checkpoint status bar.
    All content is representative of a real run. */}

<div class="ws-mock" role="img" aria-label="Stylized Agent V window: a file tree beside an agent chat that reads a file, edits it, and runs the project typecheck, with a checkpoint waiting in the status bar.">
  <div class="ws-titlebar" aria-hidden="true">
    <span class="ws-dots"><i></i><i></i><i></i></span>
    <span class="ws-app">Agent V</span>
    <span class="ws-path">~/code/vyotiq-agent-v</span>
  </div>
  <div class="ws-body" aria-hidden="true">
    <div class="ws-rail">
      <span aria-current="true"><LandingIcon name="files" size={14} /></span>
      <span><LandingIcon name="globe" size={14} /></span>
      <span><LandingIcon name="terminal" size={14} /></span>
      <span><LandingIcon name="check" size={14} /></span>
      <span><LandingIcon name="pull-request" size={14} /></span>
      <span><LandingIcon name="plan" size={14} /></span>
    </div>
    <div class="ws-tree">
      <ul>
        <li>src/</li>
        <li data-indent="1">main/</li>
        <li data-indent="2">updater.ts</li>
        <li data-indent="2" class="ws-tree-open">latest.ts</li>
        <li data-indent="1" class="ws-tree-open">renderer/</li>
        <li data-indent="2">chat/</li>
        <li data-indent="1">shared/</li>
        <li>package.json</li>
        <li>pnpm-lock.yaml</li>
        <li>README.md</li>
      </ul>
    </div>
    <div class="ws-chat">
      <div class="ws-msg ws-msg-user">
        <p>The updater fails when a download is truncated. Find the cause and fix it.</p>
      </div>
      <div class="ws-tools">
        <div class="ws-tool">
          <b>Read</b> latest.ts
          <span class="ws-tool-done"><LandingIcon name="check" size={11} /></span>
        </div>
        <div class="ws-tool">
          <b>Edit</b> updater.ts
          <span class="ws-diff"><span class="ws-diff-add">+18</span> <span class="ws-diff-del">−6</span></span>
        </div>
        <div class="ws-tool">
          <b>Run</b> pnpm test:updater
          <span class="ws-tool-done"><LandingIcon name="check" size={11} /></span>
        </div>
      </div>
      <div class="ws-msg">
        <p>The SHA512 was computed from a partial buffer when the fetch ended early. The updater now re-downloads with retries before trusting the digest.</p>
      </div>
      <div class="ws-composer">
        <span class="ws-mode">Agent</span>
        <span>Ask, plan, or delegate…</span>
        <span class="ws-send"><LandingIcon name="chevron-right" size={12} /></span>
      </div>
    </div>
  </div>
  <div class="ws-statusbar" aria-hidden="true">
    <span>ctx 38%</span>
    <span>Ollama · qwen2.5</span>
    <span class="ws-checkpoint"><i></i> Checkpoint saved · Keep / Discard</span>
  </div>
</div>
