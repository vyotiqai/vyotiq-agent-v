---
// Site footer. Consumed with no props by every page layout.
import BrandLockup from './BrandLockup.astro'

const cols = [
  {
    title: 'Product',
    links: [
      { href: '/#download', label: 'Download' },
      { href: '/changelog', label: 'Changelog' },
      { href: '/docs', label: 'Docs' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: 'https://github.com/vyotiqai/vyotiq-agent-v', label: 'Source (GPL-3.0)' },
      { href: 'https://github.com/vyotiqai/vyotiq-agent-v-releases/releases', label: 'Releases' },
      { href: 'https://github.com/vyotiqai/vyotiq-agent-v/issues', label: 'Report an issue' },
      { href: 'mailto:support@vyotiq.com', label: 'support@vyotiq.com' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
    ],
  },
]
---

<footer class="footer">
  <div class="inner">
    <div class="top">
      <div class="brand">
        <a href="/" class="wordmark" aria-label="VYOTIQ home">
          <BrandLockup />
        </a>
        <p class="desc">
          VYOTIQ is a coding workspace for real repositories. Free and open source under GPL-3.0.
        </p>
      </div>

      <nav class="cols" aria-label="Footer">
        {
          cols.map((col) => (
            <div class="col">
              <h2 class="col-title">{col.title}</h2>
              <ul class="col-list">
                {col.links.map((link) => (
                  <li>
                    <a href={link.href} class="col-link">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="colophon">
      <span>&copy; 2026 VYOTIQ</span>
      <span>Coding workspace for real repositories</span>
      <span>GPL-3.0</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--well);
    border-top: 1px solid var(--border-faint);
  }

  .inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 3.5rem 1.5rem 2rem;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem 4rem;
    justify-content: space-between;
  }

  .brand {
    max-width: 22rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    color: var(--fg);
    text-decoration: none;
  }

  .desc {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 4rem;
  }

  .col-title {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .col-link {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .col-link:hover {
    color: var(--accent);
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
