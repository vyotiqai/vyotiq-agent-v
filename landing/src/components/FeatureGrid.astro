---
const rows = [
  {
    name: 'Modes',
    text: 'Ask, Plan, and Agent. Plan mode holds file edits until you approve the plan.'
  },
  {
    name: 'Built-in tools',
    text: 'Sixty of them: a file editor, terminal, browser, Git surfaces, search, and LSP integration.'
  },
  {
    name: 'Models',
    text: 'Ten wired providers plus any OpenAI-compatible endpoint. Your API keys live in app settings.'
  },
  {
    name: 'Project memory',
    text: 'Each workspace keeps agent memory in .vyotiq/memory inside the repository.'
  },
  {
    name: 'Code indexing',
    text: 'A local index in .vyotiq/codeindex powers repository-wide semantic search.'
  },
  {
    name: 'Voice dictation',
    text: 'Whisper models run locally in a utility process, not a browser tab.'
  },
  {
    name: 'MCP',
    text: 'Attach external tool servers managed through the app\u2019s marketplace and settings.'
  },
  {
    name: 'Checkpoints',
    text: 'Runs checkpoint along the way, so a bad merge or edit can be rolled back.'
  },
  {
    name: 'Updates',
    text: 'The app checks for new versions but never installs one without your confirmation.'
  }
]
---

<section class="features section" aria-labelledby="features-title">
  <div class="wrap">
    <p class="eyebrow mono"><strong>02</strong> — Features</p>
    <h2 id="features-title" class="features-title">What is in the box.</h2>
    <dl class="spec">
      {
        rows.map((row) => (
          <div class="spec-row">
            <dt class="spec-name mono">{row.name}</dt>
            <dd class="spec-text">{row.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .features-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 3rem;
  }

  .spec {
    margin: 0;
    background: var(--surface);
    border: none;
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--shadow-card, 0 1px 2px rgb(2 8 23 / 0.3), 0 8px 24px rgb(2 8 23 / 0.25));
    overflow: hidden;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1.5rem;
    padding: 0.875rem 1.25rem;
    transition: background-color var(--duration, 150ms) var(--ease, ease);
  }

  .spec-row:hover {
    background: var(--well);
  }

  .spec-row + .spec-row {
    border-top: 1px solid var(--border-faint);
  }

  .spec-name {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
    padding-top: 0.1875rem;
  }

  .spec-text {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    max-width: 58ch;
  }

  @media (max-width: 640px) {
    .spec-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
