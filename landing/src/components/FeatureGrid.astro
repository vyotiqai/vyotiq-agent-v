---
import ProviderMarks from './ProviderMarks.astro'
import LandingIcon from './LandingIcon.astro'

const workspacePanels = [
  {
    name: 'Files',
    detail: 'Repository tree and editor for workspace files, sandboxed to the folder you opened.'
  },
  {
    name: 'Browser',
    detail: 'Embedded browser for reading and acting on live websites from inside a run.'
  },
  {
    name: 'Terminal',
    detail: 'Project commands with their captured output, beside the conversation.'
  },
  {
    name: 'Changes',
    detail: 'Working-tree status, diffs, and checkpoint actions before anything is committed.'
  },
  {
    name: 'Pull Request',
    detail: 'GitHub pull requests through the GitHub CLI, reviewed in the same window.'
  },
  {
    name: 'Plan',
    detail: "The run's plan, contract, and todos, visible as work progresses."
  }
]

const modes = [
  {
    name: 'Ask',
    boundary:
      'Read-only built-in tools and a browse-only browser. It can answer, but it cannot change anything.'
  },
  {
    name: 'Plan',
    boundary:
      "Adds todos, diagnostics, and edits limited to the run's plan.md and contract.md. Implementation waits for approval."
  },
  {
    name: 'Agent',
    boundary:
      'The full built-in catalog, subject to tool approval and safety gates. Commands, edits, Git, and browser actions happen here.'
  }
]

const continuityItems = [
  'Workspace sessions keep chats and run state tied to the repository they belong to.',
  'Background runs keep working while you do something else and can notify you on completion, failure, or when they need attention.',
  'Context estimates and compaction summarize older history when the window fills, so a long run stays usable.',
  'Plans, todos, and checkpoints record what was intended and what completed, so you can pick the work back up.'
]

const extensionItems = [
  {
    key: 'MC',
    name: 'MCPs',
    detail: 'Connect tools and resources from configured Model Context Protocol servers.'
  },
  {
    key: 'SK',
    name: 'Skills',
    detail: 'Add task-specific instructions and workflows the agent can invoke.'
  },
  {
    key: 'RU',
    name: 'Rules',
    detail: 'Apply persistent guidance from user or workspace rule files.'
  },
  {
    key: 'PK',
    name: 'Packages',
    detail: 'Install Marketplace bundles with explicit lifecycle controls.'
  }
]

const localItems = [
  { label: 'Workspace files and run records', detail: 'Including editor history and session state.' },
  { label: 'Settings, indexes, model caches', detail: 'Optional code indexing stays derived and local.' },
  { label: 'Rotating logs', detail: 'Telemetry only: no workspace paths, file names, or chat payloads.' }
]

const remoteItems = [
  { label: 'Model providers', detail: 'Receive the prompts and attached content you send.' },
  { label: 'Visited websites', detail: 'Seen by the embedded browser during browser actions.' },
  { label: 'GitHub and remotes', detail: 'Reached when you use pull requests or push.' },
  { label: 'Dictation and remote MCP', detail: 'OpenAI or OpenRouter for voice; servers you configure.' }
]

const docsLinks = [
  {
    label: 'Quickstart: first useful change',
    detail: 'Open a workspace, connect a model, run one small task, review the diff.',
    href: '/docs/start/quickstart'
  },
  {
    label: 'Built-in tools',
    detail: 'The full catalog and which mode can use each tool.',
    href: '/docs/reference/tools'
  },
  {
    label: 'Providers and models',
    detail: 'Set up Ollama, a cloud provider, or a custom endpoint.',
    href: '/docs/customize/providers'
  },
  {
    label: 'Privacy and security',
    detail: 'What is stored, what leaves the machine, and what gates it.',
    href: '/docs/concepts/privacy-data'
  }
]
---

<div class="home-sections">
  <section id="capabilities" class="home-section wrap" aria-labelledby="workspace-title">
    <header class="home-section-heading">
      <p class="eyebrow"><strong>01</strong> One workspace</p>
      <h2 id="workspace-title">Six panels, one task, zero app-switching.</h2>
      <p>
        The chat drives the work. These panels keep everything it touches in view, so context
        never lives in another window.
      </p>
    </header>
    <ul class="data-sheet">
      {
        workspacePanels.map((panel, index) => (
          <li>
            <span class="sheet-key" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{panel.name}</h3>
            <p>{panel.detail}</p>
          </li>
        ))
      }
    </ul>
    <a class="text-link" href="/docs/agent/workspaces-sessions">
      Tour the workspace
      <LandingIcon name="arrow-up-right" />
    </a>
  </section>

  <section class="home-section wrap" aria-labelledby="modes-title">
    <header class="home-section-heading">
      <p class="eyebrow"><strong>02</strong> Three modes</p>
      <h2 id="modes-title">You decide how much the agent may do.</h2>
      <p>
        The mode is an enforced tool boundary, not a suggestion. Start read-only, plan with
        guardrails, then execute under approval.
      </p>
    </header>
    <div class="mode-table-wrap">
      <table class="mode-table">
        <thead>
          <tr>
            <th scope="col">Mode</th>
            <th scope="col">Boundary</th>
          </tr>
        </thead>
        <tbody>
          {
            modes.map((mode) => (
              <tr>
                <th scope="row">{mode.name}</th>
                <td>{mode.boundary}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="home-supporting-copy">
      MCP server tools are available to Agent only. Ask and Plan can list a server's catalog but
      cannot invoke its tools. Switch modes any time with the composer picker or
      <code>Ctrl+.</code>
    </p>
    <a class="text-link mt-6" href="/docs/agent/modes">
      Compare modes in detail
      <LandingIcon name="arrow-up-right" />
    </a>
  </section>

  <section class="home-section wrap" aria-labelledby="continuity-title">
    <header class="home-section-heading">
      <p class="eyebrow"><strong>03</strong> Long-running work</p>
      <h2 id="continuity-title">Long work stays resumable.</h2>
      <p>
        A run carries more than a transcript. Sessions, checkpoints, and compaction keep the
        state needed to return, catch up, and continue.
      </p>
    </header>
    <div class="home-split">
      <ul class="home-plain-list">
        {continuityItems.map((item) => <li>{item}</li>)}
      </ul>
      <aside class="home-note" aria-labelledby="checkpoint-title">
        <h3 id="checkpoint-title">The honest limits of checkpoints</h3>
        <p>
          Checkpoints cover guarded agent writes. They are not Git commits and cannot reverse
          terminal commands, browser actions, MCP calls, or other remote side effects.
        </p>
        <a class="text-link" href="/docs/agent/checkpoints">
          How checkpoints work
          <LandingIcon name="arrow-up-right" />
        </a>
      </aside>
    </div>
  </section>

  <section class="home-section wrap" aria-labelledby="providers-title">
    <header class="home-section-heading">
      <p class="eyebrow"><strong>04</strong> Provider choice</p>
      <h2 id="providers-title">Bring your own model.</h2>
      <p>
        Configure a local Ollama, one of nine cloud providers, or any OpenAI-compatible endpoint,
        then pick from the models that host exposes.
      </p>
    </header>
    <div class="provider-band">
      <ProviderMarks />
      <aside class="home-note">
        <h3>What new settings select</h3>
        <p>
          Fresh settings start on local Ollama with <code>qwen2.5</code>. That is a selection,
          not an install: the endpoint only works once Ollama exists and is reachable.
        </p>
        <a class="text-link" href="/docs/customize/providers">
          Configure providers
          <LandingIcon name="arrow-up-right" />
        </a>
      </aside>
    </div>
  </section>

  <section class="home-section wrap" aria-labelledby="extensions-title">
    <header class="home-section-heading">
      <p class="eyebrow"><strong>05</strong> Extensions</p>
      <h2 id="extensions-title">Extend on purpose, not by default.</h2>
      <p>
        Marketplace installs are opt-in and scoped. The workspace stays lean until a task calls
        for more.
      </p>
    </header>
    <ul class="home-extension-grid">
      {
        extensionItems.map((item) => (
          <li>
            <h3>
              {item.name}
              <span aria-hidden="true">{item.key}</span>
            </h3>
            <p>{item.detail}</p>
          </li>
        ))
      }
    </ul>
    <p class="home-supporting-copy">
      Memory is plain Markdown under <code>.vyotiq/memory/</code>, injected into every run.
      Optional code indexing builds a separate local index for search; it is not memory.
    </p>
    <a class="text-link mt-6" href="/docs/customize/marketplace">
      Browse customization docs
      <LandingIcon name="arrow-up-right" />
    </a>
  </section>

  <section class="home-section wrap" aria-labelledby="boundaries-title">
    <header class="home-section-heading">
      <p class="eyebrow"><strong>06</strong> Data boundaries</p>
      <h2 id="boundaries-title">Local by default. Explicit about the network.</h2>
      <p>
        Workspace files, run records, settings, indexes, and logs stay on the machine. Content
        crosses the boundary only when the work itself calls an outside service.
      </p>
    </header>
    <div class="boundary-grid">
      <div class="boundary-zone boundary-local">
        <h3>
          <i aria-hidden="true"></i>
          Stays on this machine
        </h3>
        <ul>
          {
            localItems.map((item) => (
              <li>
                {item.label}
                <span>{item.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="boundary-zone boundary-remote">
        <h3>
          <i aria-hidden="true"></i>
          Crosses the network
        </h3>
        <ul>
          {
            remoteItems.map((item) => (
              <li>
                {item.label}
                <span>{item.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="boundary-facts">
      <article>
        <h3>Credentials</h3>
        <p>
          Provider keys, MCP bearer tokens, and GitHub tokens use the operating system's secure
          storage where available.
        </p>
      </article>
      <article>
        <h3>Approvals</h3>
        <p>
          Tool approval can gate every tool, only mutating tools, or nothing, with named tools
          allowlisted. Browser domains can be restricted to an allowlist.
        </p>
      </article>
      <article>
        <h3>Crash reporting</h3>
        <p>Opt-in, and only present in builds configured for the reporting path.</p>
      </article>
    </div>
    <a class="text-link mt-6" href="/docs/concepts/security">
      Review the security model
      <LandingIcon name="arrow-up-right" />
    </a>
  </section>

  <section class="home-section wrap" aria-labelledby="docs-title">
    <header class="home-section-heading">
      <p class="eyebrow"><strong>07</strong> Documentation</p>
      <h2 id="docs-title">Docs for every step.</h2>
      <p>
        Start with an install and a first reviewed run, or go straight to the reference.
      </p>
    </header>
    <nav aria-label="Product documentation">
      <ul class="home-docs-grid">
        {
          docsLinks.map((link) => (
            <li>
              <a href={link.href}>
                <span>{link.label}</span>
                <small>{link.detail}</small>
                <LandingIcon name="arrow-up-right" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</div>
