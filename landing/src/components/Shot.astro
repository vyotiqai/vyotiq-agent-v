---
/**
 * An application screenshot captured by scripts/capture-shots.mjs. Both the
 * light and dark file are rendered; global.css shows the one matching the
 * active theme. The files are committed, so a missing one fails the build.
 */
import { existsSync, readFileSync } from 'node:fs'
import { join } from 'node:path'

interface Props {
  /** Basename without the -light / -dark suffix, e.g. "marketplace". */
  name: string
  alt: string
  caption: string
  /** Above the fold: load immediately instead of lazily. */
  eager?: boolean
}

const { name, alt, caption, eager = false } = Astro.props

const shotsDir = join(process.cwd(), 'public', 'shots')
const lightFile = join(shotsDir, `${name}-light.png`)
const darkFile = join(shotsDir, `${name}-dark.png`)

for (const file of [lightFile, darkFile]) {
  if (!existsSync(file)) {
    throw new Error(`Shot "${name}": missing ${file}. Run \`pnpm site:capture\` at the repo root.`)
  }
}

/** Intrinsic size from the PNG header; the capture is not always exactly 2x. */
function pngSize(file: string): { width: number; height: number } {
  const header = readFileSync(file).subarray(0, 24)
  if (header.toString('ascii', 12, 16) !== 'IHDR') {
    throw new Error(`Shot "${name}": ${file} is not a PNG`)
  }
  return { width: header.readUInt32BE(16), height: header.readUInt32BE(20) }
}

const { width, height } = pngSize(lightFile)
const loading = eager ? 'eager' : 'lazy'
---

<figure class="vy-shot">
  <img class="vy-shot-light" src={`/shots/${name}-light.png`} alt={alt} width={width} height={height} loading={loading} decoding="async" />
  <img class="vy-shot-dark" src={`/shots/${name}-dark.png`} alt={alt} width={width} height={height} loading={loading} decoding="async" />
  <figcaption>{caption}</figcaption>
</figure>
