---
interface Props {
  body?: string;
}

const { body = '' } = Astro.props;

// Escape-first mini markdown: entity-escape everything, then apply a strict
// whitelist of transforms. set:html is only ever fed this generated string.
const esc = (s: string) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

const inline = (s: string) =>
  s
    .replace(/`([^`]+)`/g, '<code class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[0.85em] text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200">$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-semibold text-zinc-900 dark:text-zinc-100">$1</strong>')
    .replace(
      /(https?:\/\/[^\s<]+)/g,
      '<a href="$1" target="_blank" rel="noopener noreferrer" class="font-medium text-orange-600 underline-offset-4 hover:underline dark:text-orange-400">$1</a>',
    );

function render(src: string): string {
  const lines = esc(src).split(/\r?\n/);
  const out: string[] = [];
  let inFence = false;
  let fenceBuf: string[] = [];

  for (const line of lines) {
    if (/^```/.test(line)) {
      if (inFence) {
        out.push(
          `<pre class="mt-3 overflow-x-auto rounded-xl bg-zinc-50 p-4 font-mono text-xs leading-relaxed text-zinc-800 dark:bg-zinc-900 dark:text-zinc-200">${fenceBuf.join('\n')}</pre>`,
        );
        fenceBuf = [];
      }
      inFence = !inFence;
      continue;
    }
    if (inFence) {
      fenceBuf.push(line);
      continue;
    }
    if (!line.trim()) continue;

    const heading = line.match(/^(#{1,3})\s+(.*)$/);
    if (heading) {
      out.push(`<h4 class="mt-6 font-semibold text-zinc-900 first:mt-0 dark:text-zinc-100">${inline(heading[2])}</h4>`);
      continue;
    }
    const bullet = line.match(/^[-*]\s+(.*)$/);
    if (bullet) {
      out.push(
        `<li class="list-disc pl-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 marker:text-orange-500/60">${inline(bullet[1])}</li>`,
      );
      continue;
    }
    out.push(`<p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">${inline(line)}</p>`);
  }
  if (fenceBuf.length) {
    out.push(
      `<pre class="mt-3 overflow-x-auto rounded-xl bg-zinc-50 p-4 font-mono text-xs leading-relaxed text-zinc-800 dark:bg-zinc-900 dark:text-zinc-200">${fenceBuf.join('\n')}</pre>`,
    );
  }
  return out.join('\n');
}

const html = body.trim() ? render(body) : '';
---

{
  html ? (
    <div class="space-y-2" set:html={html} />
  ) : (
    <p class="text-sm italic text-zinc-500 dark:text-zinc-500">No notes in this release.</p>
  )
}
