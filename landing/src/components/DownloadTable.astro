---
import release from '../data/release.json';

const fmt = (a) => (a ? `${Math.round(a.size / (1024 * 1024))} MB` : '');

const groups = [
  {
    os: 'windows',
    name: 'Windows',
    hint: 'Windows 10+ · x64',
    items: [{ label: 'Installer', asset: release.assets.windows.exe }],
  },
  {
    os: 'macos',
    name: 'macOS',
    hint: 'macOS 12+ · signed',
    items: [
      { label: 'Apple Silicon', asset: release.assets.macos.arm64 },
      { label: 'Intel', asset: release.assets.macos.x64 },
    ],
  },
  {
    os: 'linux',
    name: 'Linux',
    hint: 'glibc 2.28+ · x64',
    items: [
      { label: 'AppImage', asset: release.assets.linux.appimage },
      { label: 'DEB', asset: release.assets.linux.deb },
      { label: 'RPM', asset: release.assets.linux.rpm },
    ],
  },
];
---

<div id="download" class="mx-auto w-full max-w-5xl px-6 pb-20 pt-2">
  <div class="grid divide-y divide-line/60 border-y border-line/60">
    {
      groups.map((g) => (
        <div data-os={g.os} class="py-6 transition-colors data-[recommended]:bg-surface/60">
          <div class="flex items-baseline justify-between">
            <p class="flex items-baseline gap-3 text-sm font-semibold text-bright">
              {g.name}
              <span class="hidden rounded-full bg-vy/15 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-vy" data-rec>
                your system
              </span>
            </p>
            <p class="font-mono text-[11px] text-fog/70">{g.hint}</p>
          </div>
          <ul class="mt-3 divide-y divide-line/40">
            {g.items
              .filter((i) => i.asset)
              .map((i) => (
                <li class="flex items-center justify-between gap-4 py-2.5">
                  <div class="min-w-0">
                    <p class="truncate font-mono text-xs text-fg/90">{i.asset.file}</p>
                    <p class="text-xs text-fog/70">{i.label}</p>
                  </div>
                  <div class="flex shrink-0 items-center gap-4">
                    <span class="font-mono text-xs text-fog/70">{fmt(i.asset)}</span>
                    <a
                      href={i.asset.url}
                      download
                      class="text-sm font-medium text-vy underline-offset-4 transition-colors hover:text-vy-hover hover:underline"
                    >
                      Download
                    </a>
                  </div>
                </li>
              ))}
            {g.items.every((i) => !i.asset) && <li class="py-2.5 text-xs text-fog/70">Grab it from the releases page.</li>}
          </ul>
        </div>
      ))
    }
  </div>
</div>

<script is:inline>
  (() => {
    const ua = navigator.userAgent;
    const uaPlatform = navigator.userAgentData?.platform || '';
    const isMac = /Mac|iPhone|iPad/.test(ua) || /mac/i.test(uaPlatform);
    const isLinux = !isMac && (/Linux|X11/.test(ua) || /lin/i.test(uaPlatform));
    const os = isMac ? 'macos' : isLinux ? 'linux' : 'windows';
    const el = document.querySelector('#download [data-os="' + os + '"]');
    if (!el) return;
    el.setAttribute('data-recommended', '');
    el.querySelector('[data-rec]')?.classList.remove('hidden');
  })();
</script>
