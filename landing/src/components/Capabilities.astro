---
const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';

const toolChips = [
  'read',
  'edit',
  'search',
  'glob',
  'grep',
  'codebase_search',
  'list_dir',
  'terminal',
  'todo_write',
];

const workspace = [
  {
    title: 'MCP servers',
    desc: 'Connect Model Context Protocol servers — tools from your .mcp.json join the registry.',
  },
  {
    title: 'Skills & slash commands',
    desc: 'Package know-how into skills; trigger flows from the composer.',
  },
  {
    title: 'Code index',
    desc: 'A local SQLite code index keeps search fast on large repositories.',
  },
  {
    title: 'Voice dictation',
    desc: 'Dictate prompts with a local Whisper model — audio stays on your machine.',
  },
  {
    title: 'Command palette',
    desc: 'Every action reachable from the keyboard.',
  },
  {
    title: 'File attachments',
    desc: 'Drop files and images straight into the conversation.',
  },
  {
    title: 'Themes',
    desc: 'Appearance settings and custom skins for the workspace.',
  },
  {
    title: 'Auto-updates',
    desc: 'New versions arrive automatically via GitHub Releases.',
  },
];
---

<section id="capabilities" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
  <p class="font-mono text-[11px] font-medium uppercase tracking-[0.25em] text-orange-600">
    Capabilities
  </p>
  <h2 class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-zinc-950 sm:text-4xl">
    Everything the agent needs to work a real repo
  </h2>

  <!-- workspace surface: real session recording -->
  <div class="mt-16 grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
    <div>
      <h3 class="text-2xl font-semibold tracking-tight text-zinc-950">
        The full surface of a real workspace
      </h3>
      <p class="mt-3 text-base leading-relaxed text-zinc-600">
        Agent V works your repository directly — every tool sandboxed to the workspace root.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          toolChips.map((t) => (
            <span class="rounded-md border border-zinc-200 bg-white px-2.5 py-1 font-mono text-xs text-zinc-700 shadow-sm">
              {t}
            </span>
          ))
        }
        <span
          class="rounded-md border border-orange-200 bg-orange-50 px-2.5 py-1 font-mono text-xs font-medium text-orange-700"
        >
          +51 more
        </span>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-zinc-600">
        Plus a live agent browser, an interactive terminal dock with a real PTY, and git
        integration — Changes panel, commits, optional GitHub pull-request panel.
      </p>
    </div>
    <figure class="relative">
      <img
        src="/media/showcase-1.webp"
        alt="Agent V — real session recording"
        width="1200"
        height="636"
        class="h-auto w-full rounded-2xl border border-zinc-200 shadow-xl shadow-zinc-900/10"
        loading="lazy"
        decoding="async"
      />
      <figcaption
        class="absolute right-3 top-3 rounded-full bg-zinc-950/80 px-3 py-1 font-mono text-[10px] font-medium uppercase tracking-wider text-zinc-200 backdrop-blur"
      >
        Real session · 0:35–0:41
      </figcaption>
    </figure>
  </div>

  <!-- models: real session recording + plain provider list -->
  <div class="mt-20 grid items-center gap-10 sm:mt-24 lg:grid-cols-2 lg:gap-14">
    <figure class="relative lg:order-1">
      <img
        src="/media/showcase-2.webp"
        alt="Agent V — real session recording"
        width="1200"
        height="636"
        class="h-auto w-full rounded-2xl border border-zinc-200 shadow-xl shadow-zinc-900/10"
        loading="lazy"
        decoding="async"
      />
      <figcaption
        class="absolute right-3 top-3 rounded-full bg-zinc-950/80 px-3 py-1 font-mono text-[10px] font-medium uppercase tracking-wider text-zinc-200 backdrop-blur"
      >
        Real session · 1:08–1:14
      </figcaption>
    </figure>
    <div class="lg:order-2">
      <h3 class="text-2xl font-semibold tracking-tight text-zinc-950">
        Every model you already use
      </h3>
      <p class="mt-3 text-base leading-relaxed text-zinc-600">
        Chat with the providers you already pay for.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-zinc-700">
        OpenAI, Anthropic, Gemini, Ollama, DeepSeek, Groq, OpenRouter, xAI, Modal, and Mistral —
      </p>
      <p class="mt-2 font-mono text-sm text-zinc-500">…or any OpenAI-compatible endpoint.</p>
    </div>
  </div>

  <!-- context & memory: text-only until a real product image is provided -->
  <div class="mt-20 sm:mt-24">
    <div class="max-w-2xl">
      <h3 class="text-2xl font-semibold tracking-tight text-zinc-950">
        Context and memory that persist
      </h3>
      <p class="mt-3 text-base leading-relaxed text-zinc-600">
        Long sessions stay within budget; what matters is remembered between them.
      </p>
      <ul class="mt-6 space-y-3">
        <li class="flex gap-3 text-sm leading-relaxed text-zinc-700">
          <span class="mt-0.5 select-none font-mono text-zinc-300" aria-hidden="true">–</span>
          Budget layers and tool-result trimming
        </li>
        <li class="flex gap-3 text-sm leading-relaxed text-zinc-700">
          <span class="mt-0.5 select-none font-mono text-zinc-300" aria-hidden="true">–</span>
          Structured compaction with a live context-window meter
        </li>
        <li class="flex gap-3 text-sm leading-relaxed text-zinc-700">
          <span class="mt-0.5 select-none font-mono text-zinc-300" aria-hidden="true">–</span>
          File-backed markdown memory under <code class="font-mono text-xs">.vyotiq/memory</code>
        </li>
      </ul>
    </div>
  </div>

  <!-- parallel agents: text-only until a real product image is provided -->
  <div class="mt-20 sm:mt-24">
    <div class="max-w-2xl">
      <h3 class="text-2xl font-semibold tracking-tight text-zinc-950">Run agents in parallel</h3>
      <p class="mt-3 text-base leading-relaxed text-zinc-600">
        Big task? Fan it out — every agent works in its own isolated checkout.
      </p>
      <ul class="mt-6 space-y-3">
        <li class="flex gap-3 text-sm leading-relaxed text-zinc-700">
          <span class="mt-0.5 select-none font-mono text-zinc-300" aria-hidden="true">–</span>
          Spawn parallel agent instances on isolated git worktrees
        </li>
        <li class="flex gap-3 text-sm leading-relaxed text-zinc-700">
          <span class="mt-0.5 select-none font-mono text-zinc-300" aria-hidden="true">–</span>
          Each instance inherits context and gets its own branch
        </li>
        <li class="flex gap-3 text-sm leading-relaxed text-zinc-700">
          <span class="mt-0.5 select-none font-mono text-zinc-300" aria-hidden="true">–</span>
          Pull results, follow up, or cancel mid-flight
        </li>
      </ul>
    </div>
  </div>

  <!-- the rest of the workspace -->
  <div class="mt-20 sm:mt-24">
    <h3 class="text-xl font-semibold tracking-tight text-zinc-950">And the rest of the workspace</h3>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        workspace.map((w) => (
          <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm">
            <h4 class="text-sm font-semibold text-zinc-950">{w.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600">{w.desc}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div
    id="security"
    class="mt-20 scroll-mt-20 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm sm:p-8"
  >
    <h3 class="text-sm font-semibold text-zinc-950">Security by default</h3>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-600">
      Agent V runs with <code class="font-mono text-xs text-zinc-900">contextIsolation: true</code>,
      <code class="font-mono text-xs text-zinc-900">sandbox: true</code>, and
      <code class="font-mono text-xs text-zinc-900">nodeIntegration: false</code> — paths are
      sandboxed to the workspace root.
    </p>
    <a
      href={`${REPO}#security`}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-zinc-600 transition hover:text-zinc-950"
    >
      Learn about security
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
