---
const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';

const rows = [
  {
    title: 'The full surface of a real workspace',
    lead: 'Agent V works your repository directly — every tool sandboxed to the workspace root.',
    points: [
      '60 workspace tools: read/edit/search, glob, grep, codebase_search, list_dir, terminal',
      'Live agent browser — navigate, snapshot, click, type, and wait from inside a run',
      'Interactive terminal dock with a real PTY via node-pty',
      'Git integration — Changes panel, commits, optional GitHub pull-request panel',
    ],
    img: '/media/showcase-1.webp',
    caption: 'Real session · 0:35–0:41',
  },
  {
    title: 'Every model you already use',
    lead: 'Chat with the providers you already pay for.',
    points: [
      'OpenAI, Anthropic, Gemini, Mistral',
      'Ollama, DeepSeek, Groq',
      'OpenRouter, xAI, Modal',
      'Any OpenAI-compatible endpoint',
    ],
    img: '/media/showcase-2.webp',
    caption: 'Real session · 1:08–1:14',
  },
  {
    title: 'Context and memory that persist',
    lead: 'Budget layers and structured compaction keep long sessions working; memory persists between them.',
    points: [
      'Budget layers and tool-result trimming',
      'Structured compaction with a live context-window meter',
      'File-backed markdown memory under .vyotiq/memory',
      'Memory injected into every run',
    ],
    img: '/media/showcase-3.webp',
    caption: 'Real session · 2:17–2:23',
  },
  {
    title: 'Run agents in parallel',
    lead: 'Big task? Fan it out — every agent works in its own isolated checkout.',
    points: [
      'Spawn parallel agent instances on isolated git worktrees',
      'Each instance inherits context and gets its own branch',
      'Pull results, follow up, or cancel mid-flight',
      'Merge finished agent branches back into yours',
    ],
    img: '/media/showcase-4.webp',
    caption: 'Real session · 0:39–0:45',
  },
];

const workspace = [
  {
    title: 'MCP servers',
    desc: 'Connect Model Context Protocol servers — tools from your .mcp.json join the registry.',
  },
  {
    title: 'Skills & slash commands',
    desc: 'Package know-how into skills; trigger flows with / commands from the composer.',
  },
  {
    title: 'Code index',
    desc: 'A local SQLite code index keeps search fast on large repositories.',
  },
  {
    title: 'Voice dictation',
    desc: 'Dictate prompts with a local Whisper model — audio stays on your machine.',
  },
  {
    title: 'Command palette',
    desc: 'Every action reachable from the keyboard.',
  },
  {
    title: 'File attachments',
    desc: 'Drop files and images straight into the conversation.',
  },
  {
    title: 'Themes',
    desc: 'Appearance settings and custom skins for the workspace.',
  },
  {
    title: 'Auto-updates',
    desc: 'New versions arrive automatically via GitHub Releases.',
  },
];
---

<section id="capabilities" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
  <p class="font-mono text-[11px] uppercase tracking-[0.25em] text-zinc-500">Capabilities</p>
  <h2 class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
    Everything the agent needs to work a real repo
  </h2>

  <div class="mt-16 space-y-20 sm:mt-20 sm:space-y-24">
    {
      rows.map((row, i) => (
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
          <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
            <h3 class="text-2xl font-semibold tracking-tight text-white">{row.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-zinc-400">{row.lead}</p>
            <ul class="mt-6 space-y-3">
              {row.points.map((pt) => (
                <li class="flex gap-3 text-sm leading-relaxed text-zinc-300">
                  <span class="mt-0.5 select-none font-mono text-violet-300/60" aria-hidden="true">
                    –
                  </span>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
          <figure class={i % 2 === 1 ? 'lg:order-1' : ''}>
            <img
              src={row.img}
              alt={`Agent V — ${row.title} (real session recording)`}
              class="w-full rounded-xl border border-white/10 shadow-2xl shadow-black/40"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="mt-2 text-center font-mono text-xs text-zinc-600">
              {row.caption}
            </figcaption>
          </figure>
        </div>
      ))
    }
  </div>

  <div class="mt-20 sm:mt-24">
    <h3 class="text-xl font-semibold tracking-tight text-white">And the rest of the workspace</h3>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        workspace.map((w) => (
          <div class="g-border g-border-hover rounded-2xl bg-white/[0.02] p-5">
            <h4 class="text-sm font-semibold text-white">{w.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{w.desc}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div id="security" class="g-border mt-20 scroll-mt-20 rounded-2xl bg-white/[0.02] p-6 sm:p-8">
    <h3 class="text-sm font-semibold text-white">Security by default</h3>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-400">
      Agent V runs with <code class="font-mono text-xs text-zinc-300">contextIsolation: true</code>,
      <code class="font-mono text-xs text-zinc-300">sandbox: true</code>, and
      <code class="font-mono text-xs text-zinc-300">nodeIntegration: false</code> — paths are
      sandboxed to the workspace root.
    </p>
    <a
      href={`${REPO}#security`}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-flex items-center gap-1.5 text-sm text-zinc-400 transition hover:text-white"
    >
      Learn about security
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
