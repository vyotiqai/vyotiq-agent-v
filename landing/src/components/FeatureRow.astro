---
/**
 * Muse-style alternating feature row: text + visual, calm whitespace.
 */
import type { Feature, FeatureCategory } from '../data/features';
import FeatureVisual from './FeatureVisual.astro';
import ParallelWorktrees from './ParallelWorktrees.astro';
import AgentModes from './AgentModes.astro';
import AgentBrowser from './AgentBrowser.astro';

interface Props {
  feature: Feature;
  category?: FeatureCategory;
  index: number;
}

const { feature, category, index } = Astro.props;
const flip = index % 2 === 1;
const band = index % 2 === 0 ? 'bg-[var(--av-band)]' : 'bg-[var(--av-bg)]';
const anchors = (feature.anchors ?? []).slice(0, 5);
---

<section
  id={`feature-${feature.id}`}
  class:list={['scroll-mt-28', band]}
  aria-labelledby={`feature-heading-${feature.id}`}
>
  <div class="av-max mx-auto px-4 py-16 sm:px-6 sm:py-20 lg:px-10 lg:py-24">
    <div
      class:list={[
        'grid items-center gap-10 lg:grid-cols-2 lg:gap-14 xl:gap-20',
        flip ? 'lg:[&>*:first-child]:order-2' : null,
      ]}
    >
      <div class="max-w-xl">
        {
          category ? (
            <p class="text-xs font-semibold uppercase tracking-wider text-[var(--av-muted)]">
              {category.title}
            </p>
          ) : null
        }
        <h2
          id={`feature-heading-${feature.id}`}
          class:list={[
            'text-[clamp(1.55rem,2.8vw,2.15rem)] font-semibold tracking-tight text-[var(--av-ink)] leading-[1.15]',
            category ? 'mt-2' : null,
          ]}
        >
          {feature.title}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-[color-mix(in_srgb,var(--av-ink)_62%,transparent)] sm:text-[17px]">
          {feature.summary}
        </p>
        {
          feature.body ? (
            <p class="mt-3 text-[15px] leading-relaxed text-[var(--av-muted)]">{feature.body}</p>
          ) : null
        }
        {
          anchors.length > 0 ? (
            <p class="mt-6 font-mono text-[12px] leading-relaxed text-[color-mix(in_srgb,var(--av-ink)_55%,transparent)]">
              {anchors.join(' · ')}
            </p>
          ) : null
        }
      </div>

      <div class="min-w-0">
        {
          feature.showcase === 'parallel' ? (
            <ParallelWorktrees embedded />
          ) : feature.showcase === 'modes' ? (
            <AgentModes embedded />
          ) : feature.showcase === 'browser' ? (
            <AgentBrowser embedded />
          ) : (
            <FeatureVisual feature={feature} />
          )
        }
      </div>
    </div>
  </div>
</section>
