---
import providerIcons from '../data/provider-icons.json';

const cards = [
  {
    title: 'Free and open source',
    desc: 'GPL-3.0-or-later. Clone it, read every line, change it — no subscription for the app itself.',
  },
  {
    title: 'Your code stays yours',
    desc: 'A local desktop app — tools are sandboxed to the workspace root, with Electron contextIsolation and sandbox on.',
  },
  {
    title: 'Agents in parallel',
    desc: 'Spawn multiple agent instances, each isolated in its own git worktree — merge their branches when they land.',
  },
  {
    title: 'Extensible end to end',
    desc: 'Model Context Protocol servers, skills, slash commands, and a marketplace of ready-made additions.',
  },
];
---

<section id="why" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
  <p class="font-mono text-[11px] font-medium uppercase tracking-[0.25em] text-orange-600">
    Why Agent V
  </p>
  <h2 class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-zinc-950 sm:text-4xl">
    A coding agent that answers to you
  </h2>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-600 sm:text-lg">
    No subscriptions, no lock-in, no cloud middleman for your code.
  </p>

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
    <div class="relative rounded-2xl border border-zinc-200 bg-gradient-to-b from-orange-50/80 to-white p-6 shadow-sm sm:col-span-2 lg:col-span-4">
      <span class="absolute -left-px -top-px h-2.5 w-2.5 border-l-2 border-t-2 border-orange-500" aria-hidden="true"></span>
      <span class="absolute -right-px -top-px h-2.5 w-2.5 border-r-2 border-t-2 border-orange-500" aria-hidden="true"></span>
      <span class="absolute -bottom-px -left-px h-2.5 w-2.5 border-b-2 border-l-2 border-orange-500" aria-hidden="true"></span>
      <span class="absolute -bottom-px -right-px h-2.5 w-2.5 border-b-2 border-r-2 border-orange-500" aria-hidden="true"></span>
      <span class="font-mono text-xs font-semibold text-orange-600">01</span>
      <h3 class="mt-3 text-sm font-semibold text-zinc-950">Bring your own models</h3>
      <p class="mt-2 max-w-md text-sm leading-relaxed text-zinc-600">
        Chat with the providers you already pay for — switch mid-session.
      </p>
      <div class="mt-5 flex flex-wrap gap-2" aria-label="Supported model providers">
        {
          providerIcons.map((p) => (
            <span
              class="grid size-10 place-items-center rounded-lg border border-zinc-200 bg-white shadow-sm"
              title={p.title}
            >
              <svg
                viewBox={p.viewBox}
                role="img"
                aria-label={p.title}
                class="size-5 text-zinc-700"
                fill="currentColor"
                fill-rule="evenodd"
              >
                <title>{p.title}</title>
                {p.paths.map((d) => <path d={d} />)}
              </svg>
            </span>
          ))
        }
      </div>
      <p class="mt-4 font-mono text-[11px] text-zinc-500">…or any OpenAI-compatible endpoint.</p>
    </div>

    <div class="relative flex flex-col justify-between rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm sm:col-span-1 lg:col-span-2">
      <span class="absolute -left-px -top-px h-2.5 w-2.5 border-l-2 border-t-2 border-orange-500" aria-hidden="true"></span>
      <span class="absolute -right-px -top-px h-2.5 w-2.5 border-r-2 border-t-2 border-orange-500" aria-hidden="true"></span>
      <span class="absolute -bottom-px -left-px h-2.5 w-2.5 border-b-2 border-l-2 border-orange-500" aria-hidden="true"></span>
      <span class="absolute -bottom-px -right-px h-2.5 w-2.5 border-b-2 border-r-2 border-orange-500" aria-hidden="true"></span>
      <span class="font-mono text-xs font-semibold text-orange-600">02</span>
      <div class="mt-4">
        <p class="text-5xl font-semibold tracking-tight text-zinc-950">60</p>
        <h3 class="mt-2 text-sm font-semibold text-zinc-950">sandboxed workspace tools</h3>
        <p class="mt-2 text-sm leading-relaxed text-zinc-600">
          Every tool scoped to the workspace root — enforced, not promised.
        </p>
      </div>
    </div>

    {
      cards.map((card, i) => (
        <div class="rounded-2xl border border-zinc-200 bg-gradient-to-b from-orange-50/60 to-white p-6 shadow-sm sm:col-span-1 lg:col-span-2">
          <span class="font-mono text-xs font-semibold text-orange-600">
            {String(i + 3).padStart(2, '0')}
          </span>
          <h3 class="mt-3 text-sm font-semibold text-zinc-950">{card.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600">{card.desc}</p>
        </div>
      ))
    }
  </div>
</section>
