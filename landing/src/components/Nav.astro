---
import { NAV, app } from '../lib/site'

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const isActive = (href: string) => path === href
---

<header class="vy-nav">
  <div class="vy-shell vy-nav-inner">
    <a href="/" class="vy-brand" aria-label="Vyotiq — home">
      <img src="/brand/vyotiq-mark-black.svg" alt="" width="22" height="22" class="vy-dark-invert" />
      <span class="vy-brand-name">Vyotiq</span>
      <span class="vy-brand-sep" aria-hidden="true">/</span>
      <span class="vy-brand-product">Agent V</span>
    </a>

    <nav class="vy-nav-links" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={item.href} class="vy-nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="vy-nav-actions">
      <a class="vy-nav-link vy-nav-github" href={app.repo.source} rel="noopener noreferrer">GitHub</a>

      <button type="button" class="vy-theme-toggle" data-theme-toggle aria-label="Switch colour theme">
        <svg class="vy-icon-sun" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <circle cx="8" cy="8" r="3.1" />
          <path d="M8 1v1.6M8 13.4V15M15 8h-1.6M2.6 8H1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1M12.9 12.9l-1.1-1.1M4.2 4.2L3.1 3.1" />
        </svg>
        <svg class="vy-icon-moon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.9 5.9 0 1 0 7.1 7.1Z" />
        </svg>
      </button>

      <a class="vy-btn vy-btn-primary vy-nav-cta" href="/download">Download</a>
    </div>

    <button type="button" class="vy-menu-btn" data-menu-toggle aria-expanded="false" aria-controls="vy-mobile-nav" aria-label="Open menu">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M3 6h14M3 10h14M3 14h14" />
      </svg>
    </button>
  </div>

  <div class="vy-mobile-nav" id="vy-mobile-nav" hidden>
    <div class="vy-shell">
      {NAV.map((item) => <a href={item.href} class="vy-mobile-link">{item.label}</a>)}
      <a href="/download" class="vy-mobile-link">Download</a>
      <a href={app.repo.source} class="vy-mobile-link" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</header>

<style>
  .vy-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--vy-bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--vy-border);
  }

  .vy-nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--vy-nav-height);
  }

  .vy-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--vy-fg-strong);
    flex-shrink: 0;
  }

  .vy-brand-sep {
    color: var(--vy-border-strong);
    font-weight: 400;
  }

  .vy-brand-product {
    color: var(--vy-muted);
    font-weight: 500;
  }

  .vy-nav-links {
    display: flex;
    align-items: center;
    gap: 1.375rem;
    margin-inline: auto;
  }

  .vy-nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--vy-muted);
    letter-spacing: -0.008em;
  }

  .vy-nav-link {
    padding: 0.375rem 0.625rem;
    border-radius: var(--vy-radius-md);
    transition: background var(--vy-duration) var(--vy-ease);
  }

  .vy-nav-links .vy-nav-link:hover {
    background: var(--vy-accent-wash);
  }

  .vy-nav-link:hover,
  .vy-nav-link[aria-current='page'] {
    color: var(--vy-fg-strong);
  }

  .vy-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .vy-nav-cta {
    min-height: 2.25rem;
    padding-inline: 0.875rem;
    font-size: 0.875rem;
  }

  .vy-theme-toggle,
  .vy-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--vy-border);
    border-radius: var(--vy-radius-md);
    background: transparent;
    color: var(--vy-muted);
    cursor: pointer;
    transition:
      color var(--vy-duration) var(--vy-ease),
      border-color var(--vy-duration) var(--vy-ease);
  }

  .vy-theme-toggle:hover,
  .vy-menu-btn:hover {
    color: var(--vy-fg-strong);
    border-color: var(--vy-border-strong);
  }

  /* Show the icon of the theme you would switch to. */
  .vy-icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .vy-icon-sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .vy-icon-moon {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .vy-icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .vy-icon-moon {
    display: block;
  }

  .vy-menu-btn {
    display: none;
    color: var(--vy-fg);
  }

  .vy-mobile-nav {
    border-top: 1px solid var(--vy-border);
    padding-block: 0.5rem 1rem;
    background: var(--vy-bg);
  }

  .vy-mobile-link {
    display: block;
    padding-block: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--vy-secondary);
    border-bottom: 1px solid var(--vy-border);
  }

  .vy-mobile-link:last-child {
    border-bottom: 0;
  }

  @media (max-width: 860px) {
    .vy-nav-links,
    .vy-nav-github,
    .vy-nav-cta {
      display: none;
    }
    .vy-nav-actions {
      margin-left: auto;
    }
    .vy-menu-btn {
      display: inline-flex;
    }
  }

  @media (min-width: 861px) {
    .vy-mobile-nav {
      display: none !important;
    }
  }
</style>

<script>
  // Storage can throw in private windows; the page still renders from the OS
  // preference when it does.
  const root = document.documentElement

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches
    const current = root.dataset.theme ?? (systemDark ? 'dark' : 'light')
    const next = current === 'dark' ? 'light' : 'dark'
    root.dataset.theme = next
    try {
      localStorage.setItem('vy-theme', next)
    } catch {}
  })

  const menuBtn = document.querySelector('[data-menu-toggle]')
  const menu = document.getElementById('vy-mobile-nav')
  menuBtn?.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') === 'true'
    menuBtn.setAttribute('aria-expanded', String(!open))
    if (menu) menu.hidden = open
  })
</script>
