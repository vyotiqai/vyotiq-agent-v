---
import release from '../data/release.json';

const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';

const downloadHref = release.source === 'github' ? release.url : `${REPO}#build-from-source`;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-zinc-950/80 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6" aria-label="Main">
    <a href="#top" class="flex items-center gap-2.5">
      <img src="/brand/vyotiq-lockup-white.svg" alt="Vyotiq" width="128" height="32" class="h-8 w-auto" />
    </a>
    <div class="hidden items-center gap-8 text-sm text-zinc-400 md:flex">
      <a href="#capabilities" class="transition hover:text-white">Capabilities</a>
      <a href="#security" class="transition hover:text-white">Security</a>
    </div>
    <div class="flex items-center gap-3">
      <a
        href="https://github.com/vyotiqai/vyotiq-agent-v"
        target="_blank"
        rel="noopener noreferrer"
        class="text-zinc-400 transition hover:text-white"
        aria-label="GitHub repository"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z"
          ></path>
        </svg>
      </a>
      <a
        href={downloadHref}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-200 transition hover:bg-white/10 hover:text-white"
      >
        Download
      </a>
    </div>
  </nav>
</header>
