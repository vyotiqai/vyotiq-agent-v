---
import release from '../data/release.json';

const { assets, tag } = release;

const fmtSize = (asset) =>
  asset ? `${Math.round(asset.size / (1024 * 1024))} MB` : '';

const osCards = [
  {
    os: 'windows',
    name: 'Windows',
    note: 'Windows 10 or later · x64',
    icon: '<path d="M3 5.5 10.5 4.4v7.1H3V5.5Zm0 13v-6h7.5v7.1L3 18.5Zm8.5.2V12.5H21v10l-9.5-1.8Zm0-7.2V4.3L21 3v8.5h-9.5Z"/>',
    items: [{ label: 'Installer (x64)', asset: assets.windows.exe }],
  },
  {
    os: 'macos',
    name: 'macOS',
    note: 'macOS 12 or later · signed',
    icon: '<path d="M16.7 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.5-.1-2.8.8-3.5.8-.7 0-1.8-.8-3-.8-1.6 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.3 2.9 2.3 1.2 0 1.6-.8 3-.8s1.8.8 3 .8c1.3 0 2.1-1.2 2.9-2.3.9-1.3 1.2-2.6 1.3-2.6-.1-.1-2.6-1.1-2.6-3.7ZM14.4 5.6c.6-.8 1.1-1.9 1-3-.9 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1 0 2.2-.5 2.8-1.3Z"/>',
    items: [
      { label: 'Apple Silicon', asset: assets.macos.arm64 },
      { label: 'Intel', asset: assets.macos.x64 },
    ],
  },
  {
    os: 'linux',
    name: 'Linux',
    note: 'glibc 2.28+ · x64',
    icon: '<circle cx="12" cy="6" r="3"/><path d="M9 8c-1.5 2-2 5-2 8 0 3-1 4-1 4s3 1 6 1 6-1 6-1-1-1-1-4c0-3-.5-6-2-8"/><path d="M10 8v3M14 8v3"/>',
    items: [
      { label: 'AppImage', asset: assets.linux.appimage },
      { label: 'DEB', asset: assets.linux.deb },
      { label: 'RPM', asset: assets.linux.rpm },
    ],
  },
];
---

<section id="download" class="scroll-mt-20 border-t border-zinc-200/70 py-24 dark:border-zinc-800/70">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-sm font-semibold text-orange-600 dark:text-orange-400">Download</p>
    <h2 class="mt-2 text-balance text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50">
      Get Agent V{tag ? ` ${tag}` : ''}.
    </h2>
    <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
      Free and open source. Pick the installer for your system — auto-updates are built in.
    </p>

    <div class="mt-12 grid gap-4 md:grid-cols-3" data-download-grid>
      {
        osCards.map((os) => (
          <div
            data-os={os.os}
            class="flex flex-col rounded-2xl border border-zinc-200 bg-white p-6 transition-colors dark:border-zinc-800 dark:bg-zinc-900/40 data-[recommended]:border-orange-500/60 data-[recommended]:ring-2 data-[recommended]:ring-orange-500/20"
          >
            <div class="flex items-center gap-3">
              <svg viewBox="0 0 24 24" fill="currentColor" class="size-5 text-zinc-700 dark:text-zinc-300" aria-hidden="true" set:html={os.icon} />
              <h3 class="font-semibold text-zinc-900 dark:text-zinc-50">{os.name}</h3>
            </div>
            <ul class="mt-5 flex flex-1 flex-col gap-3">
              {os.items
                .filter((i) => i.asset)
                .map((i) => (
                  <li class="flex items-center justify-between gap-3 rounded-xl bg-zinc-50 px-3 py-2.5 dark:bg-zinc-900">
                    <div class="min-w-0">
                      <p class="text-sm font-medium text-zinc-800 dark:text-zinc-200">{i.label}</p>
                      <p class="truncate font-mono text-xs text-zinc-500 dark:text-zinc-500">{i.asset.file}</p>
                    </div>
                    <a
                      href={i.asset.url}
                      download
                      class="shrink-0 rounded-full bg-zinc-900 px-3.5 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
                    >
                      {fmtSize(i.asset)}
                    </a>
                  </li>
                ))}
              {os.items.every((i) => !i.asset) && (
                <li class="text-sm text-zinc-500 dark:text-zinc-500">No installer yet — grab it from GitHub.</li>
              )}
            </ul>
            <p class="mt-5 text-xs text-zinc-500 dark:text-zinc-500">{os.note}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-zinc-600 dark:text-zinc-400">
      Prefer building it yourself? <a href="https://github.com/vyotiqai/vyotiq-agent-v#quick-start" target="_blank" rel="noopener noreferrer" class="font-medium text-orange-600 underline-offset-4 hover:underline dark:text-orange-400">Build from source</a> — or browse <a href={release.url} target="_blank" rel="noopener noreferrer" class="font-medium text-orange-600 underline-offset-4 hover:underline dark:text-orange-400">all releases on GitHub</a>.
    </p>
  </div>
</section>

<script is:inline>
  (() => {
    const ua = navigator.userAgent;
    const uaPlatform = navigator.userAgentData?.platform || '';
    const isMac = /Mac|iPhone|iPad/.test(ua) || /mac/i.test(uaPlatform);
    const isLinux = !isMac && (/Linux|X11/.test(ua) || /lin/i.test(uaPlatform));
    const os = isMac ? 'macos' : isLinux ? 'linux' : 'windows';
    document.querySelector(`[data-download-grid] [data-os="${os}"]`)
      ?.setAttribute('data-recommended', '');
  })();
</script>
