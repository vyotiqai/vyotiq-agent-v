---
const removed = [
  'Re-explaining your codebase to a fresh chat, every session.',
  'Copy-pasting between terminal, editor, and a chat window.',
  'No memory between sessions — the same setup every time.',
  'One agent task at a time, serially.',
  'Edits you can only hope were correct.',
];

const added = [
  '60 sandboxed workspace tools work your repository directly.',
  'Terminal, browser, git, and editor surfaces in one workspace.',
  'File-backed memory under .vyotiq/memory persists between runs.',
  'Spawn parallel agent instances on isolated git worktrees.',
  'Every change verified by re-reads and greps before it lands.',
];
---

<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-28">
  <div
    class="overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-950 shadow-xl shadow-zinc-900/10"
  >
    <div class="flex items-center justify-between border-b border-white/10 px-4 py-2.5">
      <span class="font-mono text-[11px] text-zinc-500">git diff --without-agent-v..with-agent-v</span>
      <span class="font-mono text-[11px] text-zinc-600">unified</span>
    </div>
    <div class="p-2 sm:p-4">
      <p class="px-2 py-1 font-mono text-[11px] text-zinc-500">@@ the old way @@</p>
      {
        removed.map((line) => (
          <p class="rounded bg-red-500/5 px-2 py-1.5 font-mono text-xs leading-relaxed text-red-300/90">
            <span class="select-none text-red-400/70">- </span>
            {line}
          </p>
        ))
      }
      <p class="mt-4 px-2 py-1 font-mono text-[11px] text-zinc-500">@@ with agent v @@</p>
      {
        added.map((line) => (
          <p class="rounded bg-emerald-500/10 px-2 py-1.5 font-mono text-xs leading-relaxed text-emerald-300/90">
            <span class="select-none text-emerald-400/80">+ </span>
            {line}
          </p>
        ))
      }
    </div>
  </div>
</section>
