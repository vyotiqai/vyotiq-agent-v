---
const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';
---

<section class="mx-auto max-w-7xl px-4 pb-24 pt-8 sm:px-6 sm:pb-32">
  <div class="relative border-t border-zinc-200 pt-20 text-center sm:pt-28">
    <div
      class="pointer-events-none absolute left-1/2 top-0 h-64 w-[36rem] max-w-full -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgb(234_88_12/0.08),transparent)] blur-2xl"
      aria-hidden="true"
    >
    </div>
    <h2 class="relative text-3xl font-semibold tracking-tight text-zinc-950 sm:text-5xl">
      Start building with Agent V.
    </h2>
    <p class="relative mt-4 text-base text-zinc-600 sm:text-lg">Free, open source, and ready to clone.</p>
    <div
      class="relative mx-auto mt-6 flex max-w-xl items-center justify-center gap-2 rounded-xl border border-zinc-200 bg-white px-4 py-2.5 font-mono text-xs text-zinc-600 shadow-sm"
    >
      <span class="select-none font-semibold text-orange-600" aria-hidden="true">$</span>
      <span class="truncate">git clone https://github.com/vyotiqai/vyotiq-agent-v.git</span>
    </div>
    <div class="relative mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
      <a
        href={`${REPO}#build-from-source`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-zinc-900 px-7 py-3 font-semibold text-white transition hover:bg-zinc-700 sm:w-auto"
      >
        Build from source
      </a>
      <a
        href={REPO}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-zinc-300 bg-white px-7 py-3 font-semibold text-zinc-900 transition hover:border-zinc-400 sm:w-auto"
      >
        View on GitHub
      </a>
    </div>
  </div>
</section>
