---
const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';
---

<section class="mx-auto max-w-6xl px-4 pb-24 pt-8 sm:px-6 sm:pb-32">
  <div class="border-t border-white/5 pt-20 text-center sm:pt-28">
    <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-5xl">
      Start building with Agent V.
    </h2>
    <p class="mt-4 text-base text-zinc-400 sm:text-lg">Free, open source, and ready to clone.</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
      <a
        href={`${REPO}#build-from-source`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-white px-7 py-3 font-semibold text-zinc-950 transition hover:bg-zinc-200 sm:w-auto"
      >
        Build from source
      </a>
      <a
        href={REPO}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-white/15 bg-white/[0.03] px-7 py-3 font-semibold text-zinc-200 transition hover:border-white/30 hover:text-white sm:w-auto"
      >
        View on GitHub
      </a>
    </div>
  </div>
</section>
