---
interface Props {
  class?: string
  variant?: 'lockup' | 'mark'
  alt?: string
}

const { class: className, variant = 'lockup', alt = '' } = Astro.props
---

<span
  class:list={['brand-lockup inline-flex items-center gap-2.5', className]}
  aria-label={alt || undefined}
>
  <img
    src="/brand/mark-black.svg"
    alt=""
    width="16"
    height="16"
    class="brand-lockup-mark"
    loading="eager"
    decoding="async"
  />
  {
    variant === 'lockup' ? (
      <img
        src="/brand/wordmark-black.svg"
        alt=""
        width="73"
        height="13"
        class="brand-lockup-wordmark"
        loading="eager"
        decoding="async"
      />
    ) : null
  }
</span>

<style>
  .brand-lockup-mark,
  .brand-lockup-wordmark {
    display: block;
    flex: none;
  }

  /* The canonical assets are drawn for light surfaces; invert on dark. */
  :global([data-theme='dark']) .brand-lockup-mark,
  :global([data-theme='dark']) .brand-lockup-wordmark {
    filter: invert(1);
  }
</style>
