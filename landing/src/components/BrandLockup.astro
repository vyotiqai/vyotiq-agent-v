---
interface Props {
  class?: string
  variant?: 'lockup' | 'mark'
  alt?: string
}

const { class: className, variant = 'lockup', alt = '' } = Astro.props
---

<span
  class:list={['brand-lockup inline-flex items-baseline gap-2', className]}
  aria-label={alt || undefined}
>
  <span class="brand-lockup-word">Agent V</span>
  {
    variant === 'lockup' ? (
      <span class="brand-lockup-annotation">VYOTIQ</span>
    ) : null
  }
</span>

<style>
  .brand-lockup-word {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .brand-lockup-annotation {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
