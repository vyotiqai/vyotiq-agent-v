---
const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';

const entry = {
  version: '1.1.3',
  date: '2026-09-13',
  items: [
    'Production-readiness hardening for the release pipeline: CHANGELOG-backed release notes, a tag/version gate, and a landing bake step that publishes current download URLs',
    'Astro upgraded to the latest security release',
    'Test-pool reliability: capped concurrent sessions to stop flaky test runs',
    'Documentation accuracy pass: README, CONTRIBUTING, SECURITY, NOTICE, and CODE_OF_CONDUCT claims verified against the tree',
  ],
};
---

<section id="changelog" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-20 sm:px-6 sm:pb-28">
  <div class="border-t border-zinc-200 pt-20">
    <p class="font-mono text-[11px] font-medium uppercase tracking-[0.25em] text-orange-600">
      Changelog
    </p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-zinc-950 sm:text-4xl">What's new</h2>

    <div class="mt-10 grid gap-2 sm:grid-cols-[150px_1fr] sm:gap-8">
      <div>
        <span class="font-mono text-sm font-semibold text-zinc-950">v{entry.version}</span>
        <p class="mt-1 text-xs text-zinc-400">{entry.date}</p>
      </div>
      <ul class="space-y-3">
        {
          entry.items.map((item) => (
            <li class="flex gap-3 text-sm leading-relaxed text-zinc-600">
              <span class="mt-0.5 select-none font-mono text-zinc-300" aria-hidden="true">
                –
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <a
      href={`${REPO}/blob/main/CHANGELOG.md`}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-10 inline-flex items-center gap-1.5 text-sm font-medium text-zinc-600 transition hover:text-zinc-950"
    >
      Full changelog
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
