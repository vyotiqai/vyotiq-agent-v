---
import { FOOTER, SITE, isExternal } from '../lib/site'

const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="wrap">
    <div class="top">
      <div class="maker">
        <a href="/" class="wordmark" aria-label={`${SITE.maker}, home`}>
          <img src="/brand/vyotiq-wordmark-black.svg" alt="" width="96" height="17" class="logo-art" />
        </a>
        <p>{SITE.product} is made by {SITE.maker}.</p>
      </div>

      {
        FOOTER.map((column) => (
          <nav class="column" aria-label={column.heading}>
            <h2 class="heading">{column.heading}</h2>
            <ul>
              {column.items.map((item) => (
                <li>
                  <a href={item.href} {...(isExternal(item.href) ? { rel: 'noopener noreferrer' } : {})}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="bottom">
      <p>© {year} {SITE.maker}</p>
      <div class="theme" role="group" aria-label="Color theme">
        <button type="button" data-theme-choice="system" aria-pressed="true">System</button>
        <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
        <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
    border-top: 1px solid var(--line);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }

  .wordmark {
    display: inline-block;
  }

  .maker p {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--text-3);
  }

  .heading {
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--text);
  }

  .column ul {
    display: grid;
    gap: 0.625rem;
  }

  .column a {
    font-size: 0.9375rem;
    color: var(--text-2);
    transition: color var(--fast) var(--ease);
  }

  .column a:hover {
    color: var(--text);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--text-3);
  }

  .theme {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .theme button {
    height: 1.875rem;
    padding: 0 0.75rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-3);
    cursor: pointer;
    transition:
      color var(--fast) var(--ease),
      background-color var(--fast) var(--ease);
  }

  .theme button:hover {
    color: var(--text);
  }

  .theme button[aria-pressed='true'] {
    background: var(--bg-3);
    color: var(--text);
  }

  @media (max-width: 859px) {
    .top {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .maker {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 539px) {
    .top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  // "System" clears the stored choice, so the page follows the OS again.
  // Storage can throw in a private window; the choice then lasts for the page.
  const root = document.documentElement
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')]

  const show = (choice: string) => {
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === choice))
    }
  }

  let stored: string | null = null
  try {
    stored = localStorage.getItem('vy-theme')
  } catch {}
  show(stored === 'light' || stored === 'dark' ? stored : 'system')

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const choice = button.dataset.themeChoice ?? 'system'
      if (choice === 'light' || choice === 'dark') {
        root.dataset.theme = choice
        try {
          localStorage.setItem('vy-theme', choice)
        } catch {}
      } else {
        delete root.dataset.theme
        try {
          localStorage.removeItem('vy-theme')
        } catch {}
      }
      show(choice)
    })
  }
</script>
