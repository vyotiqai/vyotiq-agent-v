---
const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';

const groups = [
  {
    title: 'Product',
    links: [
      { href: `${REPO}#build-from-source`, label: 'Download' },
      { href: REPO, label: 'GitHub' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: `${REPO}#readme`, label: 'Docs' },
      { href: `${REPO}/blob/main/CHANGELOG.md`, label: 'Changelog' },
    ],
  },
  {
    title: 'Community',
    links: [
      { href: `${REPO}/blob/main/CONTRIBUTING.md`, label: 'Contributing' },
      { href: `${REPO}/blob/main/CODE_OF_CONDUCT.md`, label: 'Code of Conduct' },
    ],
  },
  {
    title: 'Trust',
    links: [
      { href: `${REPO}/blob/main/LICENSE`, label: 'License (GPL-3.0)' },
      { href: `${REPO}/blob/main/SECURITY.md`, label: 'Security' },
    ],
  },
  {
    title: 'Connect',
    links: [
      { href: 'mailto:support@vyotiq.com', label: 'support@vyotiq.com' },
      { href: 'https://vyotiq.com', label: 'vyotiq.com' },
    ],
  },
];
---

<footer class="border-t border-zinc-200">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-[260px_1fr]">
      <div>
        <img src="/brand/vyotiq-lockup-black.svg" alt="Vyotiq" width="115" height="29" class="h-6 w-auto" />
        <p class="mt-3 max-w-[240px] text-sm leading-relaxed text-zinc-500">
          A free, open-source coding workspace for real repositories.
        </p>
      </div>
      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5" aria-label="Footer">
        {
          groups.map((g) => (
            <div>
              <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-400">{g.title}</h4>
              <ul class="mt-3 space-y-2">
                {g.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target={l.href.startsWith('http') ? '_blank' : undefined}
                      rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                      class="text-sm text-zinc-600 transition hover:text-zinc-950"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div
      class="mt-12 flex flex-col justify-between gap-2 border-t border-zinc-200 pt-6 text-xs text-zinc-400 sm:flex-row"
    >
      <p>© 2026 Vyotiq</p>
      <p>GPL-3.0-or-later</p>
    </div>
  </div>
</footer>
