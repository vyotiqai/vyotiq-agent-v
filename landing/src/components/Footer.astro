---
const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';

const links = [
  { href: REPO, label: 'GitHub' },
  { href: `${REPO}#readme`, label: 'Docs' },
  { href: 'mailto:support@vyotiq.com', label: 'Support' },
  { href: 'https://vyotiq.com', label: 'Vyotiq' },
  { href: `${REPO}/blob/main/LICENSE`, label: 'License' },
];
---

<footer class="border-t border-white/5">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col justify-between gap-8 sm:flex-row">
      <div>
        <img src="/brand/vyotiq-lockup-white.svg" alt="Vyotiq" width="115" height="29" class="h-6 w-auto" />
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-zinc-500">
          A free, open-source coding workspace for real repositories.
        </p>
      </div>
      <nav class="flex flex-wrap items-start gap-x-8 gap-y-3 text-sm" aria-label="Footer">
        {
          links.map((l) => (
            <a
              href={l.href}
              target={l.href.startsWith('http') ? '_blank' : undefined}
              rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="text-zinc-400 transition hover:text-white"
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div
      class="mt-10 flex flex-col justify-between gap-2 border-t border-white/5 pt-6 text-xs text-zinc-600 sm:flex-row"
    >
      <p>© 2026 Vyotiq</p>
      <p>GPL-3.0-or-later</p>
    </div>
  </div>
</footer>
