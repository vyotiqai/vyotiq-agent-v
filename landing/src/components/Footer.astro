---
import site from '../data/site.json';
---

<footer class="relative z-10 border-t border-line/50">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <img src="/brand/vyotiq-lockup-white.svg" alt="Vyotiq" class="h-4 w-auto" />
      <p class="mt-3 max-w-xs text-xs leading-relaxed text-fog/80">
        A coding workspace for real repositories. Free and open source under GPL-3.0.
      </p>
      <p class="mt-3 font-mono text-[11px] text-fog/60">© {new Date().getFullYear()} Vyotiq</p>
    </div>
    <nav class="flex flex-col gap-2 text-sm text-fog" aria-label="Footer">
      {
        site.nav.map((n) => (
          <a href={n.href} class="transition-colors hover:text-fg">
            {n.label}
          </a>
        ))
      }
      <a href={site.links.github} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-fg">Source</a>
      <a href={site.links.releases} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-fg">Releases</a>
    </nav>
  </div>
</footer>
