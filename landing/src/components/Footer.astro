---
const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';

const columns = [
  {
    title: 'Product',
    links: [
      { href: '/features', label: 'Features' },
      { href: '/download', label: 'Download' },
      { href: '/#providers', label: 'Multi-provider' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/docs', label: 'Docs' },
      { href: '/changelog', label: 'Changelog' },
      { href: '/contributing', label: 'Contributing' },
      { href: REPO, label: 'GitHub', external: true },
      { href: 'mailto:support@vyotiq.com', label: 'Support' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/legal', label: 'Legal' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
      { href: '/license', label: 'License' },
      { href: '/notice', label: 'Notices' },
      { href: '/security', label: 'Security' },
      { href: '/code-of-conduct', label: 'Code of Conduct' },
    ],
  },
];
---

<footer class="border-t border-[var(--av-hairline)] bg-[var(--av-panel)]">
  <div class="av-max mx-auto px-4 py-14 sm:px-6 sm:py-16 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[260px_1fr]">
      <div>
        <img src="/brand/vyotiq-lockup-black.svg" alt="Vyotiq" width="115" height="29" class="h-5 w-auto dark:hidden" />
        <img src="/brand/vyotiq-lockup-white.svg" alt="Vyotiq" width="115" height="29" class="hidden h-5 w-auto dark:block" />
        <p class="mt-4 max-w-[260px] text-sm leading-relaxed text-[color-mix(in_srgb,var(--av-ink)_55%,transparent)]">
          Agent V is a free, open-source coding workspace for real repositories — bring your own models, keep your keys local.
        </p>
      </div>
      <nav class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3" aria-label="Footer">
        {
          columns.map((col) => (
            <div>
              <h4 class="text-[11px] font-semibold uppercase tracking-wider text-[var(--av-muted)]">{col.title}</h4>
              <ul class="mt-3 space-y-2">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target={l.external ? '_blank' : undefined}
                      rel={l.external ? 'noopener noreferrer' : undefined}
                      class="text-[13px] text-[color-mix(in_srgb,var(--av-ink)_55%,transparent)] transition hover:text-[var(--av-ink)]"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div
      class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-[var(--av-hairline)] pt-6 text-xs text-[var(--av-muted)] sm:flex-row sm:items-center"
    >
      <p>© 2026 Vyotiq · GPL-3.0-or-later</p>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <a href="/privacy" class="hover:text-[var(--av-ink)]">Privacy</a>
        <a href="/terms" class="hover:text-[var(--av-ink)]">Terms</a>
        <a href="/license" class="hover:text-[var(--av-ink)]">License</a>
        <a href="/security" class="hover:text-[var(--av-ink)]">Security</a>
      </p>
    </div>
  </div>
</footer>
