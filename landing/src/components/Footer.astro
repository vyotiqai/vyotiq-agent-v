---
import site from '../data/site.json';
---

<footer class="border-t border-line/60">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-3 px-6 py-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono text-xs text-fog/70">© {new Date().getFullYear()} Vyotiq · GPL-3.0</p>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-fog" aria-label="Footer">
      {
        site.nav
          .filter((n) => n.label !== 'Download')
          .map((n) => (
            <a href={n.href} class="transition-colors hover:text-fg">
              {n.label}
            </a>
          ))
      }
      <a href={site.links.releases} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-fg">Releases</a>
    </nav>
  </div>
</footer>
