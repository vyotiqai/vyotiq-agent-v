---
import LandingIcon from './LandingIcon.astro'
import { RELEASES_PAGE } from '../lib/githubRelease'

// The code repository is private, so per-platform asset links cannot be
// served to visitors. The download area is one call to action pointing at
// the releases page, where installers are published.
---

<div class="home-release-area">
  <div class="home-installers">
    <a
      class="btn btn-primary platform-button"
      href={RELEASES_PAGE}
      aria-label="Download Agent V"
      rel="noopener noreferrer"
    >
      Download Agent V
    </a>
    <a class="home-text-link" href="/docs">
      Read the documentation
      <LandingIcon name="arrow-up-right" />
    </a>
  </div>
</div>
