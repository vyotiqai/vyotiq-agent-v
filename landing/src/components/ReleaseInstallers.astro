---
import LandingIcon from './LandingIcon.astro'
import { githubRelease, hasReleaseAssets, RELEASES_PAGE } from '../lib/githubRelease'

const { assets } = githubRelease

// One adaptive macOS link. It defaults to the arm64 dmg (with the legacy
// `mac` field backfilling the Apple-silicon slot for older single-field
// snapshots), falls back to the x64 asset when only Intel was captured, and
// carries the x64 URL in a data attribute so the inline script can rewrite
// the href on Intel Macs.
const macArm64Asset = assets.macArm64 ?? assets.mac ?? null
const macX64Asset = assets.macX64 ?? null
const macAsset = macArm64Asset ?? macX64Asset

const platforms = [
  { id: 'win', label: 'Download for Windows', asset: assets.win, hrefX64: null, hint: null },
  {
    id: 'mac',
    label: 'Download for macOS',
    asset: macAsset,
    hrefX64: macX64Asset?.url ?? null,
    hint: 'macOS — correct architecture chosen automatically (Apple silicon or Intel)'
  },
  { id: 'linux', label: 'Download for Linux', asset: assets.linux, hrefX64: null, hint: null }
] as const

const available = platforms.flatMap((platform) =>
  platform.asset ? [{ ...platform, asset: platform.asset }] : []
)
const showPackages = hasReleaseAssets()
---

<div class="home-release-area">
  <div class="home-installers" data-release-packages={showPackages ? 'true' : 'false'}>
    {
      available.map((platform) => (
        <a
          class="btn btn-secondary"
          data-release-platform={platform.id}
          href={platform.asset.url}
          data-href-x64={platform.hrefX64 ?? undefined}
          title={platform.hint ?? undefined}
          aria-label={platform.hint ?? undefined}
          rel="noopener noreferrer"
        >
          {platform.label}
        </a>
      ))
    }
    <a class="home-text-link" href={githubRelease.htmlUrl || RELEASES_PAGE}>
      GitHub Releases
      <LandingIcon name="arrow-up-right" />
    </a>
    <a class="home-text-link" href="/docs">
      Read the documentation
      <LandingIcon name="arrow-up-right" />
    </a>
  </div>
</div>

{
  showPackages ? (
    <script is:inline>
      (function () {
        function highlight(el) {
          document.querySelectorAll('[data-release-platform]').forEach(function (link) {
            link.classList.remove('btn-primary')
            link.classList.add('btn-secondary')
          })
          el.classList.remove('btn-secondary')
          el.classList.add('btn-primary')
        }
        var ua = navigator.userAgent
        var platform = ''
        if (/Windows NT/i.test(ua)) platform = 'win'
        else if (!/Android/i.test(ua) && /Linux/i.test(ua)) platform = 'linux'
        else if (/Mac OS X|Macintosh/i.test(ua)) platform = 'mac'
        if (!platform) return
        if (platform === 'mac') {
          // macOS UA strings still report "Intel" on Apple silicon, so use
          // the high-entropy architecture hint to pick the right href. The
          // server-rendered default is arm64; if the hint says x86 and an
          // Intel capture exists, the single macOS button swaps its href in
          // place. Buttons are never hidden or disabled — if the hint is
          // unavailable or fails, the arm64 default stays.
          try {
            var uad = navigator.userAgentData
            if (uad && typeof uad.getHighEntropyValues === 'function') {
              uad
                .getHighEntropyValues(['architecture'])
                .then(function (values) {
                  if (values && values.architecture === 'x86') {
                    var macLink = document.querySelector('[data-release-platform="mac"]')
                    if (
                      macLink instanceof HTMLElement &&
                      macLink.dataset.hrefX64
                    ) {
                      macLink.href = macLink.dataset.hrefX64
                    }
                  }
                })
                .catch(function () {})
            }
          } catch (error) {}
        }
        var target = platform === 'mac' ? 'mac' : platform
        var match = document.querySelector('[data-release-platform="' + target + '"]')
        if (!(match instanceof HTMLElement)) return
        highlight(match)
      })()
    </script>
  ) : null
}
