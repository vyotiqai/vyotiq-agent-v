---
// Compact per-platform installer buttons. Rendered inside the hero (#overview)
// so the homepage leads with real, reachable GitHub release downloads.
import LandingIcon from './LandingIcon.astro'
import { githubRelease, hasReleaseAssets, RELEASES_PAGE } from '../lib/githubRelease'

const assets = githubRelease.assets

const platforms = [
  { id: 'win', label: 'Download for Windows', asset: assets.win },
  { id: 'mac', label: 'Download for macOS', asset: assets.mac ?? assets.macArm64 ?? assets.macX64 },
  { id: 'linux', label: 'Download for Linux', asset: assets.linux }
].filter((entry) => entry.asset)

const available = hasReleaseAssets()
---

<div class="release-buttons" id="download">
  {
    available && platforms.length > 0 ? (
      platforms.map((entry) => (
        <a class="btn btn-primary release-button" data-release-platform={entry.id} href={entry.asset?.url}>
          <LandingIcon name="download" size={13} />
          {entry.label}
        </a>
      ))
    ) : (
      <a class="btn btn-primary release-button" data-release-platform="win" href={RELEASES_PAGE}>
        <LandingIcon name="download" size={13} />
        Download for Windows
      </a>
    )
  }
  <a class="text-link mono" href={RELEASES_PAGE} rel="noopener noreferrer">
    GitHub Releases
    <LandingIcon name="external" size={11} />
  </a>
  <a class="text-link mono" href="/docs">
    Docs
    <LandingIcon name="arrow-right" size={11} />
  </a>
</div>

<style>
  .release-buttons {
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
  }

  .release-button {
    border-radius: 999px;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
</style>
