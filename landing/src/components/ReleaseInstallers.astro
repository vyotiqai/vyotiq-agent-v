---
import LandingIcon from './LandingIcon.astro'
import { githubRelease, hasReleaseAssets, RELEASES_PAGE } from '../lib/githubRelease'

const assets = githubRelease.assets

const platforms = [
  { key: 'win', label: 'Windows', asset: assets.win },
  { key: 'macArm64', label: 'macOS (Apple silicon)', asset: assets.macArm64 ?? assets.mac },
  { key: 'macX64', label: 'macOS (Intel)', asset: assets.macX64 },
  { key: 'linux', label: 'Linux', asset: assets.linux }
].filter((entry) => entry.asset)

const available = hasReleaseAssets()
const versionLabel = githubRelease.version ?? githubRelease.tag
---

<section class="download section" id="download" aria-labelledby="download-title">
  <div class="wrap">
    <p class="eyebrow mono"><strong>04</strong> — Download</p>
    <h2 id="download-title" class="download-title">Get Agent V for your platform.</h2>
    {
      available && versionLabel ? (
        <p class="download-version mono">
          <span>Latest release</span>
          <a class="text-link" href={githubRelease.htmlUrl}>
            {versionLabel}
            <LandingIcon name="external" size={11} />
          </a>
        </p>
      ) : null
    }

    {
      available ? (
        <ul class="installers">
          {platforms.map((entry) => (
            <li class="installer-row">
              <span class="installer-platform mono">{entry.label}</span>
              <span class="installer-file mono">{entry.asset?.name}</span>
              <a class="btn btn-ghost" href={entry.asset?.url}>
                <LandingIcon name="download" size={13} />
                Download
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p class="empty-text">
            No release assets are published yet. Watch the GitHub releases page for the next
            build.
          </p>
          <a class="text-link mono" href={RELEASES_PAGE}>
            GitHub releases
            <LandingIcon name="external" size={11} />
          </a>
        </div>
      )
    }

    {
      available && (githubRelease.htmlUrl || githubRelease.version) ? (
        <p class="download-links">
          <a class="text-link mono" href={githubRelease.htmlUrl || RELEASES_PAGE}>
            {githubRelease.version ? `What's new in v${githubRelease.version}` : 'GitHub releases'}
            <LandingIcon name="arrow-up-right" size={11} />
          </a>
        </p>
      ) : null
    }
  </div>
</section>

<style>
  .download-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .download-version {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    margin: 0 0 2rem;
  }

  .download-version span:first-child {
    text-transform: uppercase;
  }

  .installers {
    list-style: none;
    margin: 0;
    max-width: 56rem;
    background: var(--surface);
    border: none;
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--shadow-card, 0 1px 2px rgb(2 8 23 / 0.3), 0 8px 24px rgb(2 8 23 / 0.25));
    overflow: hidden;
  }

  .installer-row {
    display: grid;
    grid-template-columns: 14rem 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 0.875rem 1.25rem;
    transition: background-color var(--duration, 150ms) var(--ease, ease);
  }

  .installer-row:hover {
    background: var(--well);
  }

  .installer-row + .installer-row {
    border-top: 1px solid var(--border-faint);
  }

  .installer-platform {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .installer-file {
    font-size: 0.75rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .installer-row .btn {
    border-radius: 999px;
  }

  .empty {
    background: var(--surface);
    border: none;
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--shadow-card, 0 1px 2px rgb(2 8 23 / 0.3), 0 8px 24px rgb(2 8 23 / 0.25));
    padding: 1.5rem;
    max-width: 48ch;
  }

  .empty-text {
    color: var(--muted);
    line-height: 1.55;
    margin: 0 0 1rem;
  }

  .download-links {
    margin: 1.75rem 0 0;
  }

  @media (max-width: 720px) {
    .installer-row {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
  }
</style>
