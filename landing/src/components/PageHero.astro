---
interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
  /** tighter prose column for docs-like pages */
  narrow?: boolean;
}

const { title, lede, eyebrow, narrow = false } = Astro.props;
const width = narrow ? 'max-w-3xl' : 'av-max';
---

<header class={`mx-auto w-full ${width} px-4 pb-8 pt-16 sm:px-6 sm:pb-10 sm:pt-20`}>
  {
    eyebrow ? (
      <p class="text-xs font-semibold uppercase tracking-wider text-[var(--av-muted)]">{eyebrow}</p>
    ) : null
  }
  <h1
    class:list={[
      'font-semibold tracking-tight text-[var(--av-ink)]',
      eyebrow ? 'mt-2' : null,
      'text-[clamp(1.75rem,3.5vw,2.75rem)] leading-[1.15]',
    ]}
  >
    {title}
  </h1>
  {
    lede ? (
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-[color-mix(in_srgb,var(--av-ink)_60%,transparent)] sm:text-[17px]">
        {lede}
      </p>
    ) : null
  }
</header>
