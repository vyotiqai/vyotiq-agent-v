---
interface Props {
  eyebrow: string;
  title: string;
  sub?: string;
}

const { eyebrow, title, sub } = Astro.props;
---

<div class="mx-auto w-full max-w-5xl px-6 pt-16">
  <p class="vy-in font-mono text-xs uppercase tracking-[0.14em] text-vy">{eyebrow}</p>
  <h1 class="vy-in mt-3 max-w-xl text-3xl font-bold tracking-tight text-bright [animation-delay:60ms] sm:text-4xl">
    {title}
  </h1>
  {sub && <p class="vy-in mt-3 max-w-lg text-base leading-relaxed text-fog [animation-delay:120ms]">{sub}</p>}
</div>
