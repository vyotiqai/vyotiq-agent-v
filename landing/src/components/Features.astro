---
const features = [
  {
    title: 'Works in real repositories',
    body: 'Not a chat sandbox. Agent V reads your working tree, plans changes, and applies real edits you can review and run.',
    icon: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/><path d="M8 13h8M8 16h5"/>',
  },
  {
    title: 'Local-first code index',
    body: 'An on-device SQLite index keeps codebase search instant and private. Nothing about your repo leaves your machine.',
    icon: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.66 3.13 3 7 3s7-1.34 7-3V6"/><path d="M5 12c0 1.66 3.13 3 7 3s7-1.34 7-3"/>',
  },
  {
    title: 'Multi-provider models',
    body: 'Bring Anthropic, OpenAI, Google, and local models into one workspace — pick the right model for the task.',
    icon: '<path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3Z"/><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15Z"/>',
  },
  {
    title: 'MCP tools built in',
    body: 'Connect any Model Context Protocol server and the agent can use those tools like its own hands.',
    icon: '<path d="M9 3v6m6-6v6"/><path d="M7 9h10v3a5 5 0 0 1-5 5v4"/>',
  },
  {
    title: 'Terminal and git included',
    body: 'A built-in terminal, staged diffs, and a changes review surface keep every step of the workflow in one window.',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>',
  },
  {
    title: 'Local dictation',
    body: 'Whisper speech-to-text runs on your machine, so you can talk to the agent without sending audio anywhere.',
    icon: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  },
];
---

<section id="features" class="scroll-mt-20 py-24">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-sm font-semibold text-orange-600 dark:text-orange-400">Features</p>
    <h2 class="mt-2 text-balance text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50">
      Everything a real repo needs.
    </h2>
    <p class="mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
      A desktop workspace built for shipping software, not for chatting at code.
    </p>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="rounded-2xl border border-zinc-200 bg-white p-6 transition-colors hover:border-orange-500/40 dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-orange-500/40">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6 text-orange-600 dark:text-orange-400" aria-hidden="true" set:html={f.icon} />
            <h3 class="mt-4 font-semibold text-zinc-900 dark:text-zinc-50">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{f.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
