---
import BrandLockup from './BrandLockup.astro'
import LandingIcon from './LandingIcon.astro'
import { feedbackMailto, SITE_PRODUCT } from '../lib/site'

const onDocs = Astro.url.pathname === '/docs' || Astro.url.pathname.startsWith('/docs/')
const onDocsIndex = Astro.url.pathname === '/docs' || Astro.url.pathname === '/docs/'
const feedbackHref = feedbackMailto()
---

<header class="sticky top-0 z-40 border-b border-border/80 bg-bg/90 backdrop-blur-md">
  <div class="wrap flex flex-wrap items-center justify-between gap-3 py-3">
    <a href="/" class="flex min-h-11 items-center" aria-label={`${SITE_PRODUCT} home`}>
      <BrandLockup />
    </a>

    <nav class="flex flex-wrap items-center gap-1 text-sm" aria-label="Primary">
      <a class="inline-flex min-h-11 items-center px-3 text-muted hover:text-fg" href="/#overview">
        Overview
      </a>
      <a class="inline-flex min-h-11 items-center px-3 text-muted hover:text-fg" href="/#capabilities">
        Capabilities
      </a>
      <a
        class:list={[
          'inline-flex min-h-11 items-center px-3 hover:text-fg',
          onDocs ? 'text-fg' : 'text-muted'
        ]}
        href="/docs"
        aria-current={onDocsIndex ? 'page' : onDocs ? 'true' : undefined}
      >
        Docs
      </a>
      <a
        class="inline-flex min-h-11 items-center px-3 text-muted hover:text-fg"
        href={feedbackHref}
      >
        Feedback
      </a>
      <button
        type="button"
        class="inline-flex min-h-11 shrink-0 items-center justify-center gap-1.5 rounded-full border border-border bg-surface px-3 text-muted hover:border-muted hover:text-fg"
        data-theme-toggle
        aria-label="Toggle color theme"
      >
        <LandingIcon name="monitor" size={16} class="hidden" data-theme-icon="system" />
        <LandingIcon name="sun" size={16} class="hidden" data-theme-icon="light" />
        <LandingIcon name="moon" size={16} class="hidden" data-theme-icon="dark" />
        <span class="hidden text-xs sm:inline" data-theme-label>System</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const KEY = 'vyotiq-theme'
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
  const media = window.matchMedia('(prefers-color-scheme: dark)')
  const icons = {
    system: button?.querySelector<HTMLElement>('[data-theme-icon="system"]'),
    light: button?.querySelector<HTMLElement>('[data-theme-icon="light"]'),
    dark: button?.querySelector<HTMLElement>('[data-theme-icon="dark"]')
  }
  const label = button?.querySelector<HTMLElement>('[data-theme-label]')

  const MODE_LABEL = {
    system: 'System',
    light: 'Light',
    dark: 'Dark'
  } as const

  function storedMode(): 'light' | 'dark' | 'system' {
    const value = localStorage.getItem(KEY)
    if (value === 'light' || value === 'dark') return value
    return 'system'
  }

  function resolved(mode: 'light' | 'dark' | 'system'): 'light' | 'dark' {
    if (mode === 'system') return media.matches ? 'dark' : 'light'
    return mode
  }

  function nextMode(mode: 'light' | 'dark' | 'system'): 'light' | 'dark' | 'system' {
    return mode === 'system' ? 'light' : mode === 'light' ? 'dark' : 'system'
  }

  function apply(): void {
    const mode = storedMode()
    const theme = resolved(mode)
    document.documentElement.setAttribute('data-theme', theme)
    for (const [name, icon] of Object.entries(icons)) {
      if (!icon) continue
      icon.classList.toggle('hidden', name !== mode)
    }
    if (button) {
      const next = nextMode(mode)
      button.setAttribute('aria-label', `Color theme: ${MODE_LABEL[mode]}. Click for ${MODE_LABEL[next]}.`)
      button.setAttribute('title', `${MODE_LABEL[mode]} theme`)
    }
    if (label) label.textContent = MODE_LABEL[mode]
  }

  button?.addEventListener('click', () => {
    const mode = storedMode()
    const next = nextMode(mode)
    if (next === 'system') localStorage.removeItem(KEY)
    else localStorage.setItem(KEY, next)
    apply()
  })

  media.addEventListener('change', () => {
    if (storedMode() === 'system') apply()
  })

  apply()
</script>
