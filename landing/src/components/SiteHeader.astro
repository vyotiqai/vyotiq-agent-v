---
import BrandLockup from './BrandLockup.astro'
import LandingIcon from './LandingIcon.astro'
import { githubRelease, RELEASES_PAGE } from '../lib/githubRelease'
import { SITE_PRODUCT } from '../lib/site'

const onDocs = Astro.url.pathname === '/docs' || Astro.url.pathname.startsWith('/docs/')
const onDocsIndex = Astro.url.pathname === '/docs' || Astro.url.pathname === '/docs/'
const onHome = Astro.url.pathname === '/' || Astro.url.pathname === ''

const themeOptions = [
  { value: 'system', label: 'System', icon: 'monitor' },
  { value: 'light', label: 'Light', icon: 'sun' },
  { value: 'dark', label: 'Dark', icon: 'moon' }
] as const

const { assets } = githubRelease
const downloadHref = assets.win?.url ?? assets.macArm64?.url ?? assets.linux?.url ?? RELEASES_PAGE
---

<header class="site-header">
  <div class="wrap site-header-inner">
    <a href="/" class="flex min-h-11 items-center" aria-label={`${SITE_PRODUCT} home`}>
      <BrandLockup />
    </a>

    <nav class="site-nav" aria-label="Primary">
      <a href="/#overview" aria-current={onHome ? 'page' : undefined}>Overview</a>
      <a href="/#capabilities">Capabilities</a>
      <a href="/docs" aria-current={onDocsIndex ? 'page' : onDocs ? 'true' : undefined}>Docs</a>
      <a href="/changelog">Changelog</a>
      <a
        href="https://github.com/vyotiqai/vyotiq-agent-v"
        rel="noopener noreferrer"
        aria-label="Source on GitHub"
      >
        <LandingIcon name="github" size={17} />
      </a>
    </nav>

    <div class="header-actions">
      <div class="relative" data-theme-root>
        <button
          type="button"
          class="theme-button"
          data-theme-toggle
          aria-label="Color theme"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="theme-menu"
        >
          <span class="hidden" data-theme-icon="system"><LandingIcon name="monitor" size={17} /></span>
          <span class="hidden" data-theme-icon="light"><LandingIcon name="sun" size={17} /></span>
          <span class="hidden" data-theme-icon="dark"><LandingIcon name="moon" size={17} /></span>
        </button>
        <div
          id="theme-menu"
          role="menu"
          aria-label="Color theme"
          hidden
          data-theme-menu
          class="theme-menu"
        >
          {
            themeOptions.map((option) => (
              <button type="button" role="menuitemradio" data-theme-option={option.value} aria-checked="false">
                <LandingIcon name={option.icon} size={15} />
                <span>{option.label}</span>
                <span aria-hidden="true" class="theme-check">
                  <LandingIcon name="check" size={13} />
                </span>
              </button>
            ))
          }
        </div>
      </div>
      <a class="header-download" href={downloadHref} rel="noopener noreferrer">
        <LandingIcon name="download" size={15} />
        <span>Download</span>
      </a>
    </div>
  </div>
  <script
    is:inline
    type="application/json"
    data-release-assets
    set:html={JSON.stringify({
      win: assets.win?.url ?? null,
      mac: (assets.macArm64 ?? assets.mac)?.url ?? null,
      linux: assets.linux?.url ?? null
    })}
  />
</header>

<script>
  const KEY = 'vyotiq-theme'
  const root = document.querySelector<HTMLElement>('[data-theme-root]')
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
  const menu = document.querySelector<HTMLElement>('[data-theme-menu]')
  const media = window.matchMedia('(prefers-color-scheme: dark)')

  type Mode = 'light' | 'dark' | 'system'

  const MODE_LABEL: Record<Mode, string> = {
    system: 'System',
    light: 'Light',
    dark: 'Dark'
  }

  const icons = {
    system: button?.querySelector<HTMLElement>('[data-theme-icon="system"]'),
    light: button?.querySelector<HTMLElement>('[data-theme-icon="light"]'),
    dark: button?.querySelector<HTMLElement>('[data-theme-icon="dark"]')
  }

  const options = Array.from(menu?.querySelectorAll<HTMLButtonElement>('[data-theme-option]') ?? [])

  function storedMode(): Mode {
    const value = localStorage.getItem(KEY)
    if (value === 'light' || value === 'dark') return value
    return 'system'
  }

  function resolved(mode: Mode): 'light' | 'dark' {
    if (mode === 'system') return media.matches ? 'dark' : 'light'
    return mode
  }

  function apply(): void {
    const mode = storedMode()
    document.documentElement.setAttribute('data-theme', resolved(mode))
    for (const [name, icon] of Object.entries(icons)) {
      if (!icon) continue
      icon.classList.toggle('hidden', name !== mode)
    }
    for (const option of options) {
      option.setAttribute('aria-checked', String(option.dataset.themeOption === mode))
    }
    if (button) {
      button.setAttribute('aria-label', `Color theme: ${MODE_LABEL[mode]}`)
      button.setAttribute('title', `Color theme: ${MODE_LABEL[mode]}`)
    }
  }

  function setMode(mode: Mode): void {
    if (mode === 'system') localStorage.removeItem(KEY)
    else localStorage.setItem(KEY, mode)
    apply()
  }

  function openMenu(): void {
    if (!menu || !button) return
    menu.hidden = false
    button.setAttribute('aria-expanded', 'true')
    const current =
      options.find((option) => option.getAttribute('aria-checked') === 'true') ?? options[0]
    current?.focus()
  }

  function closeMenu(returnFocus: boolean): void {
    if (!menu || !button || menu.hidden) return
    menu.hidden = true
    button.setAttribute('aria-expanded', 'false')
    if (returnFocus) button.focus()
  }

  function moveFocus(step: number): void {
    if (options.length === 0) return
    const current = options.indexOf(document.activeElement as HTMLButtonElement)
    const next = (current + step + options.length) % options.length
    options[next].focus()
  }

  button?.addEventListener('click', () => {
    if (menu?.hidden) openMenu()
    else closeMenu(false)
  })

  menu?.addEventListener('click', (event) => {
    const option = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-theme-option]')
    const value = option?.dataset.themeOption
    if (!option || (value !== 'light' && value !== 'dark' && value !== 'system')) return
    setMode(value)
    closeMenu(true)
  })

  root?.addEventListener('keydown', (event) => {
    if (menu?.hidden) return
    if (event.key === 'Escape') {
      event.preventDefault()
      closeMenu(true)
    } else if (event.key === 'ArrowDown') {
      event.preventDefault()
      moveFocus(1)
    } else if (event.key === 'ArrowUp') {
      event.preventDefault()
      moveFocus(-1)
    } else if (event.key === 'Tab') {
      closeMenu(false)
    }
  })

  document.addEventListener('click', (event) => {
    if (menu?.hidden) return
    if (root?.contains(event.target as Node)) return
    closeMenu(false)
  })

  media.addEventListener('change', () => {
    if (storedMode() === 'system') apply()
  })

  apply()
</script>

<script is:inline>
  // Point the header download at the current platform's installer when one
  // exists in the baked release snapshot. Falls back to the releases page.
  (function () {
    var link = document.querySelector('a.header-download')
    var data = document.querySelector('script[data-release-assets]')
    if (!link || !data) return
    var ua = navigator.userAgent
    var platform = ''
    if (/Windows NT/i.test(ua)) platform = 'win'
    else if (!/Android/i.test(ua) && /Linux/i.test(ua)) platform = 'linux'
    else if (/Mac OS X|Macintosh/i.test(ua)) platform = 'mac'
    if (!platform) return
    try {
      var assets = JSON.parse(data.textContent || '{}')
      if (assets[platform]) link.href = assets[platform]
    } catch (error) {}
  })()
</script>
