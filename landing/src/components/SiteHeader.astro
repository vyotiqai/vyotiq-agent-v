---
// Slim sticky site header. Consumed with no props by every page layout.
import BrandLockup from './BrandLockup.astro'
import LandingIcon from './LandingIcon.astro'
import { SITE_PRODUCT } from '../lib/site'

const path = Astro.url.pathname

// Header chrome reflects the Docs section: the index claims the page itself.
const onDocs = path.startsWith('/docs')
const onDocsIndex = Astro.url.pathname === '/docs' || Astro.url.pathname === '/docs/'

const nav = [
  { href: '/docs', label: 'Docs', active: onDocs },
  { href: '/changelog', label: 'Changelog', active: path.startsWith('/changelog') },
  { href: '/#download', label: 'Download', active: false },
]
---

<header class="header">
  <div class="bar">
    <a href="/" class="brand" aria-label={`${SITE_PRODUCT} home`}>
      <BrandLockup />
    </a>

    <nav class="nav" aria-label="Main">
      <a
        href="/docs"
        class:list={['nav-link', { active: onDocs }]}
        aria-current={onDocsIndex ? 'page' : onDocs ? 'true' : undefined}
      >
        Docs
      </a>
      {
        nav.slice(1).map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: item.active }]}
            aria-current={item.active ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <div class="theme-menu" data-theme-menu>
        <button
          type="button"
          class="icon-btn"
          data-theme-toggle
          aria-label="Switch theme"
          aria-haspopup="menu"
          aria-expanded="false"
        >
          <span class="only-dark" aria-hidden="true">
            <LandingIcon name="sun" size={16} />
          </span>
          <span class="only-light" aria-hidden="true">
            <LandingIcon name="moon" size={16} />
          </span>
        </button>
        <span class="sr-only" data-theme-icon="system">system</span>
        <div class="theme-pop" data-theme-pop hidden>
          <button type="button" class="theme-option mono" data-theme-option="light">light</button>
          <button type="button" class="theme-option mono" data-theme-option="dark">dark</button>
          <button type="button" class="theme-option mono" data-theme-option="system">system</button>
        </div>
      </div>

      <a
        class="icon-btn"
        href="https://github.com/vyotiqai/vyotiq-agent-v"
        aria-label="VYOTIQ on GitHub"
        title="GitHub"
      >
        <span aria-hidden="true">
          <LandingIcon name="github" size={16} />
        </span>
      </a>

      <button
        type="button"
        class="icon-btn menu-btn"
        id="menu-button"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="menu-open" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </span>
        <span class="menu-close" aria-hidden="true">
          <LandingIcon name="x" size={16} />
        </span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" hidden aria-label="Mobile">
    {nav.map((item) => <a href={item.href} class="mobile-link">{item.label}</a>)}
    <a href="https://github.com/vyotiqai/vyotiq-agent-v" class="mobile-link">GitHub</a>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-faint);
  }

  .bar {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .theme-menu {
    position: relative;
    display: inline-flex;
  }

  .theme-pop {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    display: grid;
    gap: 0.25rem;
    padding: 0.375rem;
    background: var(--surface);
    border: 1px solid var(--border-faint);
    border-radius: 10px;
    box-shadow: var(--shadow-card);
    min-width: 7rem;
    z-index: 50;
  }

  .theme-option {
    text-align: left;
    padding: 0.375rem 0.625rem;
    border: none;
    border-radius: 7px;
    background: transparent;
    color: var(--fg);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .theme-option:hover,
  .theme-option[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--fg);
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-left: auto;
  }

  .nav-link {
    font-size: 0.875rem;
    line-height: 1;
    color: var(--muted);
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-pill);
    transition:
      color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .nav-link:hover {
    color: var(--fg);
    background: var(--accent-soft);
  }

  .nav-link.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-decoration: none;
  }

  .icon-btn:hover {
    color: var(--fg);
    border-color: transparent;
    background: var(--accent-soft);
  }

  .icon-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Theme icons: moon in light (click for dark), sun in dark (click for light). */
  .only-dark {
    display: none;
  }

  :global([data-theme='dark']) .only-dark {
    display: inline-flex;
  }

  :global([data-theme='dark']) .only-light {
    display: none;
  }

  .only-light {
    display: inline-flex;
  }

  /* Mobile menu button: hidden on desktop. */
  .menu-btn {
    display: none;
  }

  .menu-close {
    display: none;
  }

  .menu-btn[aria-expanded='true'] .menu-open {
    display: none;
  }

  .menu-btn[aria-expanded='true'] .menu-close {
    display: inline-flex;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding-block: 0.5rem 0.75rem;
    background: var(--surface);
    border-top: 1px solid var(--border-faint);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    box-shadow: 0 16px 40px rgb(2 8 23 / 0.35);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-link {
    font-size: 0.9375rem;
    color: var(--muted);
    text-decoration: none;
    margin-inline: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-md);
    transition:
      color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .mobile-link:hover {
    color: var(--fg);
    background: var(--accent-soft);
  }

  @media (max-width: 760px) {
    .nav {
      display: none;
    }

    .menu-btn {
      display: inline-flex;
    }

    .mobile-nav {
      display: flex;
    }

    .mobile-nav[hidden] {
      display: none;
    }
  }

  @media (min-width: 761px) {
    .mobile-nav {
      display: none;
    }
  }
</style>

<script>
  const KEY = 'vyotiq-theme'
  const root = document.documentElement

  // Theme menu. The toggle opens the option list; each option applies and
  // persists 'light' | 'dark' | 'system' under the same key the inline init
  // script in BaseLayout reads before first paint.
  const menu = document.querySelector<HTMLElement>('[data-theme-menu]')
  const toggle = menu?.querySelector<HTMLButtonElement>('[data-theme-toggle]')
  const pop = menu?.querySelector<HTMLElement>('[data-theme-pop]')
  const icon = menu?.querySelector<HTMLElement>('[data-theme-icon]')
  const options = menu
    ? Array.from(menu.querySelectorAll<HTMLButtonElement>('[data-theme-option]'))
    : []

  const systemTheme = () =>
    window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'

  type ThemeChoice = 'light' | 'dark' | 'system'

  const storedTheme = (): ThemeChoice => {
    try {
      const value = localStorage.getItem(KEY)
      if (value === 'light' || value === 'dark' || value === 'system') return value
    } catch {
      /* storage unavailable */
    }
    return 'system'
  }

  const currentTheme = (): 'light' | 'dark' => {
    const value = root.getAttribute('data-theme')
    if (value === 'light' || value === 'dark') return value
    return systemTheme()
  }

  function render() {
    if (icon) icon.textContent = storedTheme()
    for (const option of options) {
      option.setAttribute('aria-pressed', option.dataset.option === storedTheme() ? 'true' : 'false')
    }
  }

  function applyTheme(value: ThemeChoice) {
    root.setAttribute('data-theme', value === 'system' ? systemTheme() : value)
    try {
      localStorage.setItem(KEY, value)
    } catch {
      /* storage unavailable; theme still switches for this page view */
    }
    toggle?.setAttribute('aria-label', `Switch theme (current: ${value})`)
    render()
  }

  toggle?.addEventListener('click', () => {
    if (!pop) return
    const open = pop.hidden
    pop.hidden = !open
    toggle.setAttribute('aria-expanded', String(open))
  })

  for (const option of options) {
    option.addEventListener('click', () => {
      const value = option.dataset.option
      if (value === 'light' || value === 'dark' || value === 'system') applyTheme(value)
      if (pop) pop.hidden = true
      toggle?.setAttribute('aria-expanded', 'false')
    })
  }

  document.addEventListener('click', (event) => {
    if (!pop || pop.hidden || !menu) return
    if (!menu.contains(event.target as Node)) {
      pop.hidden = true
      toggle?.setAttribute('aria-expanded', 'false')
    }
  })

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (storedTheme() === 'system') applyTheme('system')
  })

  render()

  // Mobile menu. Without JS the panel stays hidden; links remain in the DOM.
  const menuBtn = document.querySelector<HTMLButtonElement>('#menu-button')
  const panel = document.querySelector<HTMLElement>('#mobile-nav')
  if (menuBtn && panel) {
    const setOpen = (open: boolean) => {
      menuBtn.setAttribute('aria-expanded', String(open))
      panel.hidden = !open
    }
    menuBtn.addEventListener('click', () => {
      setOpen(menuBtn.getAttribute('aria-expanded') !== 'true')
    })
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false)
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        setOpen(false)
        menuBtn.focus()
      }
    })
    window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false)
    })
  }
</script>
