---
// Slim sticky site header. Consumed with no props by every page layout.
import BrandLockup from './BrandLockup.astro'
import LandingIcon from './LandingIcon.astro'

const path = Astro.url.pathname
const nav = [
  { href: '/docs', label: 'Docs', active: path.startsWith('/docs') },
  { href: '/changelog', label: 'Changelog', active: path.startsWith('/changelog') },
  { href: '/#download', label: 'Download', active: false },
]
---

<header class="header">
  <div class="bar">
    <a href="/" class="brand" aria-label="VYOTIQ home">
      <BrandLockup />
    </a>

    <nav class="nav" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: item.active }]}
            aria-current={item.active ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch theme">
        <span class="only-dark" aria-hidden="true">
          <LandingIcon name="sun" size={16} />
        </span>
        <span class="only-light" aria-hidden="true">
          <LandingIcon name="moon" size={16} />
        </span>
      </button>

      <a
        class="icon-btn"
        href="https://github.com/vyotiqai/vyotiq-agent-v"
        aria-label="VYOTIQ on GitHub"
        title="GitHub"
      >
        <span aria-hidden="true">
          <LandingIcon name="github" size={16} />
        </span>
      </a>

      <button
        type="button"
        class="icon-btn menu-btn"
        id="menu-button"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="menu-open" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </span>
        <span class="menu-close" aria-hidden="true">
          <LandingIcon name="x" size={16} />
        </span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" hidden aria-label="Mobile">
    {nav.map((item) => <a href={item.href} class="mobile-link">{item.label}</a>)}
    <a href="https://github.com/vyotiqai/vyotiq-agent-v" class="mobile-link">GitHub</a>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-faint);
  }

  .bar {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--fg);
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-left: auto;
  }

  .nav-link {
    font-size: 0.875rem;
    line-height: 1;
    color: var(--muted);
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-pill);
    transition:
      color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .nav-link:hover {
    color: var(--fg);
    background: var(--accent-soft);
  }

  .nav-link.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-decoration: none;
  }

  .icon-btn:hover {
    color: var(--fg);
    border-color: transparent;
    background: var(--accent-soft);
  }

  .icon-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Theme icons: moon in light (click for dark), sun in dark (click for light). */
  .only-dark {
    display: none;
  }

  :global([data-theme='dark']) .only-dark {
    display: inline-flex;
  }

  :global([data-theme='dark']) .only-light {
    display: none;
  }

  .only-light {
    display: inline-flex;
  }

  /* Mobile menu button: hidden on desktop. */
  .menu-btn {
    display: none;
  }

  .menu-close {
    display: none;
  }

  .menu-btn[aria-expanded='true'] .menu-open {
    display: none;
  }

  .menu-btn[aria-expanded='true'] .menu-close {
    display: inline-flex;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding-block: 0.5rem 0.75rem;
    background: var(--surface);
    border-top: 1px solid var(--border-faint);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    box-shadow: 0 16px 40px rgb(2 8 23 / 0.35);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-link {
    font-size: 0.9375rem;
    color: var(--muted);
    text-decoration: none;
    margin-inline: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-md);
    transition:
      color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .mobile-link:hover {
    color: var(--fg);
    background: var(--accent-soft);
  }

  @media (max-width: 760px) {
    .nav {
      display: none;
    }

    .menu-btn {
      display: inline-flex;
    }

    .mobile-nav {
      display: flex;
    }

    .mobile-nav[hidden] {
      display: none;
    }
  }

  @media (min-width: 761px) {
    .mobile-nav {
      display: none;
    }
  }
</style>

<script>
  const KEY = 'vyotiq-theme'
  const root = document.documentElement

  // Theme toggle. The old header stored 'system' | 'light' | 'dark'; if the
  // resolved value is neither explicit option, fall back to the media query.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const setLabel = () => {
      const dark = root.getAttribute('data-theme') === 'dark'
      btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme')
    }
    setLabel()
    btn.addEventListener('click', () => {
      let current = root.getAttribute('data-theme')
      if (current !== 'light' && current !== 'dark') {
        current = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
      }
      const next = current === 'dark' ? 'light' : 'dark'
      root.setAttribute('data-theme', next)
      try {
        localStorage.setItem(KEY, next)
      } catch {
        /* storage unavailable; theme still switches for this page view */
      }
      setLabel()
    })
  }

  // Mobile menu. Without JS the panel stays hidden; links remain in the DOM.
  const menuBtn = document.querySelector<HTMLButtonElement>('#menu-button')
  const panel = document.querySelector<HTMLElement>('#mobile-nav')
  if (menuBtn && panel) {
    const setOpen = (open: boolean) => {
      menuBtn.setAttribute('aria-expanded', String(open))
      panel.hidden = !open
    }
    menuBtn.addEventListener('click', () => {
      setOpen(menuBtn.getAttribute('aria-expanded') !== 'true')
    })
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false)
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        setOpen(false)
        menuBtn.focus()
      }
    })
    window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false)
    })
  }
</script>
