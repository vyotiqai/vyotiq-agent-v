---
import BrandLockup from './BrandLockup.astro'
import LandingIcon from './LandingIcon.astro'
import { SITE_PRODUCT } from '../lib/site'

const onDocs = Astro.url.pathname === '/docs' || Astro.url.pathname.startsWith('/docs/')
const onDocsIndex = Astro.url.pathname === '/docs' || Astro.url.pathname === '/docs/'

const themeOptions = [
  { value: 'system', label: 'System', icon: 'monitor' },
  { value: 'light', label: 'Light', icon: 'sun' },
  { value: 'dark', label: 'Dark', icon: 'moon' }
] as const
---

<header class="sticky top-0 z-40 border-b border-border/80 bg-bg/90 backdrop-blur-md">
  <div class="wrap flex flex-wrap items-center justify-between gap-3 py-3">
    <a href="/" class="flex min-h-11 items-center" aria-label={`${SITE_PRODUCT} home`}>
      <BrandLockup />
    </a>

    <nav class="flex flex-wrap items-center gap-1 text-sm" aria-label="Primary">
      <a class="inline-flex min-h-11 items-center px-3 text-muted hover:text-fg" href="/#overview">
        Overview
      </a>
      <a class="inline-flex min-h-11 items-center px-3 text-muted hover:text-fg" href="/#capabilities">
        Capabilities
      </a>
      <a
        class:list={[
          'inline-flex min-h-11 items-center px-3 hover:text-fg',
          onDocs ? 'text-fg' : 'text-muted'
        ]}
        href="/docs"
        aria-current={onDocsIndex ? 'page' : onDocs ? 'true' : undefined}
      >
        Docs
      </a>
      <div class="relative" data-theme-root>
        <button
          type="button"
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border bg-surface text-muted hover:border-muted hover:text-fg"
          data-theme-toggle
          aria-label="Color theme"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="theme-menu"
        >
          <span class="hidden" data-theme-icon="system"><LandingIcon name="monitor" size={18} /></span>
          <span class="hidden" data-theme-icon="light"><LandingIcon name="sun" size={18} /></span>
          <span class="hidden" data-theme-icon="dark"><LandingIcon name="moon" size={18} /></span>
        </button>
        <div
          id="theme-menu"
          role="menu"
          aria-label="Color theme"
          hidden
          data-theme-menu
          class="absolute right-0 top-full z-10 mt-2 w-44 rounded-lg border border-border bg-surface py-1 shadow-lg shadow-black/20"
        >
          {
            themeOptions.map((option) => (
              <button
                type="button"
                role="menuitemradio"
                data-theme-option={option.value}
                aria-checked="false"
                class="flex w-full items-center gap-2.5 px-3 py-2 text-left text-sm text-muted hover:bg-bg hover:text-fg"
              >
                <LandingIcon name={option.icon} size={16} />
                <span>{option.label}</span>
                <span
                  aria-hidden="true"
                  data-theme-check
                  class="ml-auto h-1.5 w-1.5 rounded-full bg-current opacity-0"
                />
              </button>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const KEY = 'vyotiq-theme'
  const root = document.querySelector<HTMLElement>('[data-theme-root]')
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
  const menu = document.querySelector<HTMLElement>('[data-theme-menu]')
  const media = window.matchMedia('(prefers-color-scheme: dark)')

  type Mode = 'light' | 'dark' | 'system'

  const MODE_LABEL: Record<Mode, string> = {
    system: 'System',
    light: 'Light',
    dark: 'Dark'
  }

  const icons = {
    system: button?.querySelector<HTMLElement>('[data-theme-icon="system"]'),
    light: button?.querySelector<HTMLElement>('[data-theme-icon="light"]'),
    dark: button?.querySelector<HTMLElement>('[data-theme-icon="dark"]')
  }

  const options = Array.from(menu?.querySelectorAll<HTMLButtonElement>('[data-theme-option]') ?? [])

  function storedMode(): Mode {
    const value = localStorage.getItem(KEY)
    if (value === 'light' || value === 'dark') return value
    return 'system'
  }

  function resolved(mode: Mode): 'light' | 'dark' {
    if (mode === 'system') return media.matches ? 'dark' : 'light'
    return mode
  }

  function apply(): void {
    const mode = storedMode()
    document.documentElement.setAttribute('data-theme', resolved(mode))
    for (const [name, icon] of Object.entries(icons)) {
      if (!icon) continue
      icon.classList.toggle('hidden', name !== mode)
    }
    for (const option of options) {
      const selected = option.dataset.themeOption === mode
      option.setAttribute('aria-checked', String(selected))
      option.classList.toggle('text-fg', selected)
      option.classList.toggle('text-muted', !selected)
      option.querySelector('[data-theme-check]')?.classList.toggle('opacity-100', selected)
    }
    if (button) {
      button.setAttribute('aria-label', `Color theme: ${MODE_LABEL[mode]}`)
      button.setAttribute('title', `Color theme: ${MODE_LABEL[mode]}`)
    }
  }

  function setMode(mode: Mode): void {
    if (mode === 'system') localStorage.removeItem(KEY)
    else localStorage.setItem(KEY, mode)
    apply()
  }

  function openMenu(): void {
    if (!menu || !button) return
    menu.hidden = false
    button.setAttribute('aria-expanded', 'true')
    const current =
      options.find((option) => option.getAttribute('aria-checked') === 'true') ?? options[0]
    current?.focus()
  }

  function closeMenu(returnFocus: boolean): void {
    if (!menu || !button || menu.hidden) return
    menu.hidden = true
    button.setAttribute('aria-expanded', 'false')
    if (returnFocus) button.focus()
  }

  function moveFocus(step: number): void {
    if (options.length === 0) return
    const current = options.indexOf(document.activeElement as HTMLButtonElement)
    const next = (current + step + options.length) % options.length
    options[next].focus()
  }

  button?.addEventListener('click', () => {
    if (menu?.hidden) openMenu()
    else closeMenu(false)
  })

  menu?.addEventListener('click', (event) => {
    const option = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-theme-option]')
    const value = option?.dataset.themeOption
    if (!option || (value !== 'light' && value !== 'dark' && value !== 'system')) return
    setMode(value)
    closeMenu(true)
  })

  root?.addEventListener('keydown', (event) => {
    if (menu?.hidden) return
    if (event.key === 'Escape') {
      event.preventDefault()
      closeMenu(true)
    } else if (event.key === 'ArrowDown') {
      event.preventDefault()
      moveFocus(1)
    } else if (event.key === 'ArrowUp') {
      event.preventDefault()
      moveFocus(-1)
    } else if (event.key === 'Tab') {
      closeMenu(false)
    }
  })

  document.addEventListener('click', (event) => {
    if (menu?.hidden) return
    if (root?.contains(event.target as Node)) return
    closeMenu(false)
  })

  media.addEventListener('change', () => {
    if (storedMode() === 'system') apply()
  })

  apply()
</script>
