---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { SITE_BRAND, SITE_PRODUCT } from '../lib/site'
---

<BaseLayout
  title={`Terms of Service — ${SITE_PRODUCT}`}
  description="The terms that apply to the Agent V website and the open-source Agent V desktop application."
>
  <SiteHeader />
  <main id="main-content" class="wrap py-14 md:py-20" tabindex="-1">
    <article class="legal-page">
      <p class="eyebrow"><strong>§</strong> Legal</p>
      <h1>Terms of Service</h1>
      <p>
        These terms apply to the {SITE_BRAND} website and to your use of the {SITE_PRODUCT}
        desktop application and its download services. Last updated: September 11, 2026.
      </p>

      <h2>The software</h2>
      <p>
        {SITE_PRODUCT} is free and open-source software licensed under the GNU General Public
        License v3.0 (GPL-3.0). You may use, study, modify, and redistribute it under that
        license, available in the <a
          href="https://github.com/vyotiqai/vyotiq-agent-v/blob/main/LICENSE"
          rel="noopener noreferrer">LICENSE file</a
        > of the source repository. Nothing in these terms restricts rights the license grants
        you.
      </p>

      <h2>No warranty</h2>
      <p>
        The website and the application are provided "as is", without warranty of any kind.
        The authors and copyright holders are not liable for any damages arising from their
        use, to the maximum extent permitted by law. The application operates on your
        repositories and systems at your direction: review changes before committing and keep
        backups of work you cannot afford to lose.
      </p>

      <h2>Acceptable use</h2>
      <p>
        Do not use the website or the application to break the law, infringe others' rights,
        distribute malware, or attack systems you do not have permission to test. You are
        responsible for how you configure model providers, MCP servers, and the commands the
        agent runs in your workspaces.
      </p>

      <h2>Your data</h2>
      <p>
        The application stores its data locally on your machine. The website stores a theme
        preference and, when enabled, cookieless analytics, see
        <a href="/privacy">Website privacy</a>. The application's data handling is documented
        in <a href="/docs/concepts/privacy-data">Privacy and data storage</a>.
      </p>

      <h2>Changes</h2>
      <p>
        We may update these terms as the product evolves. Material changes are announced on
        this page. Questions: <a href="mailto:support@vyotiq.com">support@vyotiq.com</a>.
      </p>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>

