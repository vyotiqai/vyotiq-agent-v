---
import Base from '../layouts/Base.astro'
import { NAV } from '../lib/site'

const links = [{ href: '/', label: 'Home' }, ...NAV, { href: '/download', label: 'Download' }]
---

<Base title="Page not found" description="That page does not exist on vyotiq.com." noindex>
  <section class="vy-page-head vy-nf">
    <div class="vy-shell">
      <img
        class="vy-nf-wordmark vy-dark-invert"
        src="/brand/vyotiq-wordmark-black.svg"
        alt=""
        width="113"
        height="20"
      />
      <p class="vy-eyebrow">404</p>
      <h1 class="vy-display">That page does not exist</h1>
      <p class="vy-lede">The link may be out of date, or the page may have moved.</p>
      <ul class="vy-jump" aria-label="Site pages">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .vy-nf {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .vy-nf-wordmark {
    margin-bottom: 2rem;
    opacity: 0.7;
  }

  .vy-nf .vy-display {
    max-width: 16ch;
  }

  .vy-nf .vy-lede {
    margin-top: 1rem;
  }
</style>
