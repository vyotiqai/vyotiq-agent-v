---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { SITE_PRODUCT } from '../lib/site'
---

<BaseLayout
  title={`Page not found — ${SITE_PRODUCT}`}
  description="That page does not exist. The home page, documentation, and changelog do."
  robots="noindex, nofollow"
>
  <SiteHeader />
  <main id="main-content" class="wrap">
    <section class="nf">
      <p class="mono">404 · No matching route</p>
      <h1>Page not found</h1>
      <p class="nf-line">
        Nothing is published at this URL. It may have moved, or the link may be wrong.
      </p>
      <nav class="nf-links" aria-label="Where to go next">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="text-link" href="/docs">Docs</a>
        <a class="text-link" href="/changelog">Changelog</a>
      </nav>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .nf {
    padding: var(--space-9, 96px) 0 var(--space-10, 128px);
    max-width: 640px;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: var(--space-4, 16px) 0 var(--space-5, 24px);
  }

  .nf-line {
    color: var(--muted);
    line-height: 1.65;
    margin: 0 0 var(--space-6, 32px);
  }

  .nf-links {
    display: flex;
    align-items: center;
    gap: var(--space-5, 24px);
    flex-wrap: wrap;
  }
</style>
