---
import Base from '../layouts/Base.astro'
import { NAV } from '../lib/site'
---

<Base title="Page not found" description="That page does not exist on vyotiq.com." noindex>
  <section class="vy-section vy-nf">
    <div class="vy-shell">
      <p class="vy-eyebrow">404</p>
      <h1 class="vy-h2 vy-nf-title">That page does not exist</h1>
      <p class="vy-lede">
        The link may be out of date, or the page may have moved. Here is everything on the site.
      </p>

      <ul class="vy-nf-links">
        <li><a href="/" class="vy-link">Home</a></li>
        {NAV.map((item) => <li><a href={item.href} class="vy-link">{item.label}</a></li>)}
        <li><a href="/download" class="vy-link">Download</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .vy-nf {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .vy-nf-title {
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .vy-nf-links {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    font-size: 0.9375rem;
  }
</style>
