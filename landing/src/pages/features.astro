---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FeaturesTour from '../components/FeaturesTour.astro';
import FinalCta from '../components/FinalCta.astro';
import { enabledCategories, enabledFeatures } from '../data/features';

const count = enabledFeatures().length;
const categoryCount = enabledCategories().length;
---

<Layout
  title="Features — Agent V"
  description="A structured tour of Agent V: parallel instances, Ask / Plan / Agent, browser tools, BYO models, memory, MCP, tool approval, and more — grounded in the real product."
  canonical="https://vyotiq.com/features"
>
  <Nav />
  <main id="main">
    <PageHero
      eyebrow="Product tour"
      title="Every capability, organized"
      lede={`A structured tour of ${count} capabilities across ${categoryCount} areas. Add, improve, or remove features in one catalog — the page stays consistent.`}
    />
    <FeaturesTour />
    <FinalCta />
  </main>
  <Footer />
</Layout>
