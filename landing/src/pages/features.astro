---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import FeatureCard from '../components/FeatureCard.astro';
import features from '../data/features.json';
---

<Layout title="Features — Vyotiq Agent V" description="Core features of Agent V: multi-provider chat, real repository tooling, agent instances on git worktrees, local Whisper dictation, skills, MCP, self-built tools, and long-term memory.">
  <div class="flex min-h-svh flex-col">
    <Nav />
    <main class="flex-1">
      <PageHeader eyebrow="Core features" title="Everything the workspace ships with." sub="No feature list theater — these are the surfaces in the app today, described the way you'd meet them." />
      <div class="mx-auto mt-12 grid w-full max-w-6xl grid-cols-1 gap-4 px-6 sm:grid-cols-2 lg:grid-cols-3 pb-20">
        {features.map((f, i) => <FeatureCard index={i} title={f.title} body={f.body} />)}
      </div>
    </main>
    <Footer />
  </div>
</Layout>
