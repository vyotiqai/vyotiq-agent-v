---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import features from '../data/features.json';
---

<Layout title="Features — Vyotiq Agent V" description="Core features of Agent V: multi-provider chat, real repository tooling, agent instances on git worktrees, local Whisper dictation, skills, MCP, self-built tools, and long-term memory.">
  <div class="flex min-h-svh flex-col">
    <Nav />
    <main class="flex-1">
      <PageHeader eyebrow="Features" title="What the workspace ships with." sub="No feature-list theater. These are the surfaces in the app today, described the way you'd meet them." />
      <div class="mx-auto w-full max-w-5xl px-6 pb-24 pt-10">
        <ul class="divide-y divide-line/60 border-y border-line/60">
          {
            features.map((f) => (
              <li class="grid gap-1.5 py-7 md:grid-cols-[230px_1fr] md:gap-8">
                <h2 class="text-sm font-semibold text-bright">{f.title}</h2>
                <p class="max-w-2xl text-sm leading-relaxed text-fog">{f.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
