---
import Base from '../layouts/Base.astro'
import ClaimSection from '../components/ClaimSection.astro'
import LogoWall from '../components/LogoWall.astro'
import Shot from '../components/Shot.astro'
import { app } from '../lib/site'
import { FEATURE_SECTIONS } from '../lib/showcase'
import { TOOL_GROUPS, TOOL_TOTAL } from '../lib/tools'

/**
 * Every capability claim on this page comes from src/lib/showcase.ts. The two
 * sections written out below — providers and the tool catalog — render baked
 * data rather than prose, and showcase.ts gates which names that data may
 * contain.
 *
 * The providers and tools sections sit between the opening claim sections and
 * the rest, so the page reads positioning → modes → what it runs on → what it
 * can do, rather than burying the catalogue at the bottom.
 */
const INTRO: string[] = ['principles', 'modes']
const intro = FEATURE_SECTIONS.filter((s) => INTRO.includes(s.id))
const rest = FEATURE_SECTIONS.filter((s) => !INTRO.includes(s.id))

const jump = [
  ...intro.map((s) => ({ href: `#${s.id}`, label: s.eyebrow })),
  { href: '#providers', label: 'Providers' },
  { href: '#tools', label: 'Tools' },
  ...rest.map((s) => ({ href: `#${s.id}`, label: s.eyebrow }))
]
---

<Base
  title="Features"
  description={`What Agent V does: ${TOOL_TOTAL} built-in tools, ${app.providers.total} model providers, git worktree parallelism, checkpoints and rewind, a local code index, MCP and skills.`}
>
  <section class="vy-page-head">
    <div class="vy-shell">
      <p class="vy-eyebrow">Features</p>
      <h1 class="vy-h1">Everything Agent V can do</h1>
      <p class="vy-lede">What is implemented and shipping today.</p>
      <ul class="vy-jump" aria-label="On this page">
        {jump.map((j) => <li><a href={j.href}>{j.label}</a></li>)}
      </ul>
    </div>
  </section>

  {intro.map((section) => <ClaimSection section={section} />)}

  <section class="vy-rule vy-section" id="providers">
    <div class="vy-shell vy-section-grid">
      <header class="vy-sec-head">
        <p class="vy-eyebrow">Providers</p>
        <h2 class="vy-h2">{app.providers.total} providers, your own keys</h2>
        <p class="vy-prose-muted">
          Requests go directly from your machine to the provider. There is no Vyotiq API, no
          account, and no usage metering. Keys are stored in your operating system's keychain.
        </p>
      </header>

      <div>
        <LogoWall kind="providers" tint showKeyless />
        <p class="vy-footnote">
          Model lists are fetched live per provider where the API supports it. Context windows and
          pricing metadata come from a public model registry.
        </p>
      </div>
    </div>
  </section>

  <section class="vy-rule vy-section" id="tools">
    <div class="vy-shell vy-section-grid">
      <header class="vy-sec-head">
        <p class="vy-eyebrow">Tool catalog</p>
        <h2 class="vy-h2">{TOOL_TOTAL} built-in tools</h2>
        <p class="vy-prose-muted">Every name below is a tool the agent can call.</p>
      </header>

      <div>
        <ol class="vy-rows">
          {
            TOOL_GROUPS.map((group) => (
              <li class="vy-row-lead vy-tool-row">
                <div class="vy-item">
                  <h3 class="vy-h3">
                    {group.title} <span class="vy-tool-count vy-mono">{group.names.length}</span>
                  </h3>
                  <p>{group.blurb}</p>
                </div>
                <ul class="vy-chips">
                  {group.names.map((n) => (
                    <li>{n}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
        <div class="vy-tools-shot">
          <Shot
            name="settings-tools"
            alt="The Agent V settings screen listing the built-in tools with their approval state."
            caption="The same catalog, in Settings → Tools."
          />
        </div>
      </div>
    </div>
  </section>

  {rest.map((section) => <ClaimSection section={section} />)}

  <section class="vy-rule vy-section">
    <div class="vy-shell vy-cta">
      <h2 class="vy-h2">Try it on a repository you know well.</h2>
      <div class="vy-cta-actions">
        <a class="vy-btn vy-btn-primary" href="/download">Download</a>
        <a class="vy-btn vy-btn-secondary" href="/extensions">Browse extensions</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .vy-rows > .vy-tool-row {
    grid-template-columns: 14rem minmax(0, 1fr);
  }

  @media (max-width: 640px) {
    .vy-rows > .vy-tool-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .vy-tools-shot {
    margin-top: 2rem;
  }

  .vy-tool-count {
    margin-left: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--vy-tertiary);
  }
</style>
