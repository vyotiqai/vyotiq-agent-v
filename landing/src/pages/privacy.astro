---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { landingAnalytics } from '../lib/analytics'
import { SITE_PRODUCT } from '../lib/site'

const analytics = landingAnalytics()
const analyticsHost = analytics ? new URL(analytics.src).host : null
---

<BaseLayout
  title={`Website privacy — ${SITE_PRODUCT}`}
  description="How the Agent V website stores a theme preference and when cookieless analytics is included in a build."
>
  <SiteHeader />
  <main id="main-content" class="wrap py-14 md:py-20" tabindex="-1">
    <article class="legal-page">
      <p class="eyebrow"><strong>§</strong> Website</p>
      <h1>Website privacy</h1>
      <p>
        This page describes the public Agent V website. Product data stored by the Agent V
        application is documented in
        <a href="/docs/concepts/privacy-data">Privacy and data storage</a>.
      </p>

      <h2>Theme preference</h2>
      <p>
        The color theme control stores a first-party <code>vyotiq-theme</code> value in
        <code>localStorage</code> when you choose light or dark. Choosing system removes that
        value. This is essential presentation state. It is not a third-party cookie, and this
        site does not show a cookie banner for it.
      </p>

      <h2>Analytics</h2>
      {
        analytics ? (
          <p>
            This site build loads a cookieless analytics script from <code>{analyticsHost}</code>
            for <code>{analytics.domain}</code>. The script is included only because both
            <code>PUBLIC_ANALYTICS_SRC</code> and <code>PUBLIC_ANALYTICS_DOMAIN</code> were set
            at build time. It is not used for advertising, and this site does not set advertising
            cookies.
          </p>
        ) : (
          <p>
            This site build does not load an analytics script. Analytics is optional and ships
            only when an operator sets <code>PUBLIC_ANALYTICS_SRC</code> and
            <code>PUBLIC_ANALYTICS_DOMAIN</code> at build time. When those variables are unset,
            no tracker is injected.
          </p>
        )
      }

      <h2>What this site does not do</h2>
      <p>
        The website does not set a cookie banner or advertising cookies. It does not sell
        personal information. The terms that govern use of the site and the open-source
        application are in <a href="/terms">Terms of Service</a>. Security contacts for the
        project remain on <a href="/docs/concepts/security">Security</a>.
      </p>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>

