---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import workflows from '../data/workflows.json';
---

<Layout title="Agent V workflows — Vyotiq" description="How an Agent V run works: plan against the repo, edit real files, fan out to child instances on git worktrees, run verify gates, ship, and extend the tool catalog.">
  <div class="flex min-h-svh flex-col">
    <Nav />
    <main class="flex-1">
      <PageHeader eyebrow="Workflows" title="How a run actually works." sub="Six phases, grounded in what the agent can really do — not a marketing loop diagram." />
      <div class="mx-auto w-full max-w-5xl px-6 pb-24 pt-10">
        <ol class="divide-y divide-line/60 border-y border-line/60">
          {
            workflows.map((w, i) => (
              <li class="grid gap-1.5 py-7 md:grid-cols-[230px_1fr] md:gap-8">
                <p class="font-mono text-xs uppercase tracking-[0.14em] text-vy">
                  {String(i + 1).padStart(2, '0')} · {w.step}
                </p>
                <div class="max-w-2xl">
                  <h2 class="text-sm font-semibold text-bright">{w.title}</h2>
                  <p class="mt-1.5 text-sm leading-relaxed text-fog">{w.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
