---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import WorkflowCard from '../components/WorkflowCard.astro';
import workflows from '../data/workflows.json';
---

<Layout title="Agent V workflows — Vyotiq" description="How an Agent V run works: plan against the repo, edit real files, fan out to child instances on git worktrees, run verify gates, ship, and extend the tool catalog.">
  <div class="flex min-h-svh flex-col">
    <Nav />
    <main class="flex-1">
      <PageHeader eyebrow="Agent V workflows" title="How a run actually works." sub="Six phases, grounded in what the agent can really do — not a marketing loop diagram." />
      <div class="mx-auto mt-14 w-full max-w-3xl px-6 pb-20">
        {workflows.map((w, i) => <WorkflowCard index={i} step={w.step} title={w.title} body={w.body} />)}
      </div>
    </main>
    <Footer />
  </div>
</Layout>
