---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DownloadTable from '../components/DownloadTable.astro';
import site from '../data/site.json';
import release from '../data/release.json';
import heroApp from '../assets/hero-app.png';

const ascii = ['██    ██', '██    ██', ' ██████ ', '  ████  ', '   ██   '].join('\n');

const highlights = [
  { href: '/features', eyebrow: 'Core features', text: 'Multi-provider chat, real repo tooling, local dictation, MCP, memory.' },
  { href: '/workflows', eyebrow: 'Agent V workflows', text: 'Plan, edit, fan out, verify, ship — how an agent run actually works.' },
  { href: '/download', eyebrow: 'Download', text: `Installers for Windows, macOS, and Linux — ${release.tag ?? 'latest'}.` },
  { href: '/changelog', eyebrow: 'Changelog', text: 'Release notes for every published version, straight from the repo.' },
];
---

<Layout>
  <div class="flex min-h-svh flex-col">
    <Nav />

    <section class="relative flex flex-1 flex-col overflow-hidden">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="hero-grid absolute inset-0"></div>
        <div class="hero-glow vy-drift absolute left-1/2 top-[6%] h-[520px] w-[900px] -translate-x-1/2"></div>
      </div>

      <pre
        data-ascii
        class="vy-breathe pointer-events-none absolute right-10 top-28 hidden select-none font-mono text-sm leading-tight text-vy lg:block"
        aria-hidden="true">{ascii}</pre
      >

      <div class="mx-auto w-full max-w-6xl px-6 pt-16 md:pt-24">
        <p class="vy-rise flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.2em] text-fog">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-vy opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-vy"></span>
          </span>
          {release.tag ?? 'Open source'} — free & open source
        </p>

        <h1 class="vy-rise mt-5 max-w-3xl text-balance text-4xl font-bold leading-[1.08] tracking-tight text-bright md:text-6xl [animation-delay:80ms]">
          The coding workspace for real repositories.
        </h1>

        <p class="vy-rise mt-5 max-w-xl text-pretty text-base leading-relaxed text-fog md:text-lg [animation-delay:160ms]">
          Agent V plans, edits, and ships in your actual working tree. Local-first, private by default, free to run.
        </p>

        <p class="vy-rise mt-6 font-mono text-[11px] uppercase tracking-[0.18em] text-fog/70 [animation-delay:240ms]">
          {site.stack.join(' · ')}
        </p>

        <div class="vy-rise mt-8 flex flex-wrap items-center gap-3 [animation-delay:320ms]">
          <a href="/download" class="rounded-full bg-vy px-6 py-2.5 text-sm font-semibold text-vy-ink transition-colors hover:bg-vy-hover">Download Agent V</a>
          <a href="/workflows" class="rounded-full border border-line px-6 py-2.5 text-sm font-medium text-fg transition-colors hover:border-vy/60 hover:text-bright">See how it works</a>
        </div>
      </div>

      <div data-shot class="vy-float relative mx-auto mt-auto w-full max-w-4xl px-6 pt-12">
        <div class="overflow-hidden rounded-t-2xl border border-b-0 border-line bg-panel shadow-[0_-24px_80px_-24px_rgb(79_179_232/0.18)]">
          <div class="flex h-7 items-center gap-1.5 border-b border-line/60 px-4">
            <span class="size-2 rounded-full bg-[#ff5f57]"></span>
            <span class="size-2 rounded-full bg-[#febc2e]"></span>
            <span class="size-2 rounded-full bg-[#28c840]"></span>
            <span class="ml-3 font-mono text-[10px] tracking-wider text-fog/60">agent-v</span>
          </div>
          <img src={heroApp.src} alt="Agent V app" class="h-[30vh] min-h-[200px] w-full object-cover object-top" />
        </div>
      </div>
    </section>

    <section class="border-t border-line/50 bg-ink">
      <div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-px bg-line/40 sm:grid-cols-2 lg:grid-cols-4">
        {
          highlights.map((h, i) => (
            <a href={h.href} class="vy-rise group bg-ink px-6 py-8 transition-colors hover:bg-surface [animation-delay:{`${300 + i * 70}ms`}]">
              <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-vy/80">{h.eyebrow}</p>
              <p class="mt-3 text-sm leading-relaxed text-fog group-hover:text-fg">{h.text}</p>
              <p class="mt-4 font-mono text-xs text-fog/60 transition-colors group-hover:text-vy">→</p>
            </a>
          ))
        }
      </div>
    </section>

    <Footer />
  </div>
</Layout>
