---
import BaseLayout from '../layouts/BaseLayout.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import Hero from '../components/Hero.astro'
import LandingIcon from '../components/LandingIcon.astro'
import ProviderMarks from '../components/ProviderMarks.astro'
import ReleaseInstallers from '../components/ReleaseInstallers.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import HowItRuns from '../components/home/HowItRuns.astro'
import LocalFirst from '../components/home/LocalFirst.astro'
---

<BaseLayout>
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <Hero />
    <HowItRuns />
    <FeatureGrid />
    <ProviderMarks />
    <LocalFirst />
    <ReleaseInstallers />
    <section class="closing" aria-label="Closing note">
      <div class="wrap">
        <hr class="rule" />
        <p class="closing-line">
          Agent V is open source under GPL-3.0. Read the source on
          <a
            class="text-link"
            href="https://github.com/vyotiqai/vyotiq-agent-v"
            rel="noopener noreferrer"
          >
            GitHub
            <LandingIcon name="arrow-up-right" size={12} />
          </a>.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .closing {
    padding-top: 3rem;
    padding-bottom: 3.5rem;
  }

  .closing .rule {
    margin: 0 0 2rem;
  }

  .closing-line {
    color: var(--muted);
    font-size: 0.9375rem;
    margin: 0;
  }
</style>
