---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import release from '../data/release.json';
import heroApp from '../assets/hero-app.png';

const transcript = [
  { kind: 'cmd', text: 'fix the flaky test in chatStore' },
  { kind: 'step', text: 'read src/renderer/stores/chatStore.ts — 212 lines' },
  { kind: 'step', text: 'edit 3 hunks applied' },
  { kind: 'step', text: 'run pnpm vitest -- chatStore' },
  { kind: 'ok', text: '38 passed · 0 failed' },
  { kind: 'step', text: 'commit fix(chat): await flush before assertion' },
  { kind: 'pr', text: 'PR #142 opened' },
];
---

<Layout>
  <div class="flex min-h-svh flex-col">
    <Nav />

    <main class="flex-1">
      <section class="mx-auto grid w-full max-w-5xl gap-12 px-6 pb-16 pt-14 sm:pt-20 lg:grid-cols-[1fr_360px] lg:items-center lg:gap-16">
        <div>
          <h1 class="vy-in max-w-lg text-balance text-4xl font-bold leading-[1.12] tracking-tight text-bright sm:text-5xl">
            Agent V works in your repository, not in a sandbox.
          </h1>
          <p class="vy-in mt-4 max-w-md text-base leading-relaxed text-fog [animation-delay:80ms]">
            Chat with the model you prefer. The agent reads your working tree, edits real files, runs your checks, and opens pull requests.
          </p>
          <div class="vy-in mt-7 flex items-center gap-5 [animation-delay:140ms]">
            <a href="/download" class="rounded-lg bg-vy px-5 py-2.5 text-sm font-semibold text-vy-ink transition-colors hover:bg-vy-hover">Download for {release.tag ?? 'v1.0.0'}</a>
            <a href="/workflows" class="text-sm font-medium text-fog transition-colors hover:text-fg">See how it works</a>
          </div>
        </div>

        <div data-transcript class="vy-in rounded-xl border border-line bg-panel p-5 font-mono text-[13px] leading-relaxed [animation-delay:160ms]">
          {
            transcript.map((t) => (
              <p class="flex gap-3">
                <span class:list={['shrink-0', t.kind === 'cmd' ? 'text-bright' : t.kind === 'ok' ? 'text-vy' : t.kind === 'pr' ? 'text-vy' : 'text-fog/50']}>
                  {t.kind === 'cmd' ? '›' : t.kind === 'ok' ? '✓' : t.kind === 'pr' ? '→' : '·'}
                </span>
                <span class:list={[t.kind === 'cmd' ? 'text-fg' : t.kind === 'ok' || t.kind === 'pr' ? 'text-fg/80' : 'text-fog']}>{t.text}</span>
              </p>
            ))
          }
        </div>
      </section>

      <section class="border-t border-line/60">
        <div class="mx-auto w-full max-w-5xl px-6 py-14">
          <p class="font-mono text-xs text-fog/70">The workspace</p>
          <img data-shot src={heroApp.src} alt="Agent V workspace" class="vy-in mt-4 w-full rounded-xl border border-line" loading="lazy" />
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
