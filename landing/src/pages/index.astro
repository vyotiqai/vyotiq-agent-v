---
import Base from '../layouts/Base.astro'
import ChangelogStrip from '../components/ChangelogStrip.astro'
import ClaimSection from '../components/ClaimSection.astro'
import LogoWall from '../components/LogoWall.astro'
import PlatformMark from '../components/PlatformMark.astro'
import { app } from '../lib/site'
import { HOME_SECTIONS } from '../lib/showcase'
import { HAS_RELEASE, RELEASE_META } from '../lib/download'

/**
 * The homepage showcases the approved sections marked for it in showcase.ts —
 * today runs, parallelism and teammates, each as full-width cards. Everything
 * else it carries is baked data rather than prose: the provider and integration
 * marks and the release strip. showcase.ts gates which names that data is
 * allowed to contain.
 */
---

<Base>
  <section class="vy-page-head vy-hero">
    <div class="vy-shell vy-shell-wide">
      <p class="vy-eyebrow">Open source · GPL-3.0-or-later</p>
      <h1 class="vy-display">A coding agent that works on your checkout.</h1>
      <p class="vy-lede">
        Agent V opens the repository you point it at and works there — editing files, running your
        terminal, driving git and GitHub, with your own model key.
      </p>
      <div class="vy-cta-actions">
        <a class="vy-btn vy-btn-primary" href="/download">Download for free</a>
        <a class="vy-btn vy-btn-secondary" href={app.repo.source} rel="noopener noreferrer">View source</a>
      </div>
      <ul class="vy-platform-marks vy-hero-platforms">
        <li><PlatformMark os="windows" label="Windows" /></li>
        <li><PlatformMark os="macos" label="macOS" /></li>
        <li><PlatformMark os="linux" label="Linux" /></li>
        {HAS_RELEASE && <li class="vy-mono vy-hero-version">v{RELEASE_META.version}</li>}
      </ul>
    </div>
  </section>

  <section class="vy-rule vy-section">
    <div class="vy-shell vy-section-grid">
      <header class="vy-sec-head">
        <p class="vy-eyebrow">Providers</p>
        <h2 class="vy-h2">Bring your own key</h2>
        <p class="vy-prose-muted">
          Configure any of these with your own credentials. Model lists are fetched live from each
          provider where the API supports it, so you see current models rather than a stale list.
        </p>
        <p class="vy-more"><a href="/features#providers" class="vy-link">Every provider →</a></p>
      </header>

      <div>
        <LogoWall kind="providers" />
        <p class="vy-prose-muted vy-note vy-provider-note">
          Ollama and private or LAN endpoints need no API key at all. Run entirely local models and
          keep every request on your own machine.
        </p>
      </div>
    </div>
  </section>

  {HOME_SECTIONS.map((section) => <ClaimSection section={section} />)}

  <section class="vy-rule vy-section">
    <div class="vy-shell vy-section-grid">
      <header class="vy-sec-head">
        <p class="vy-eyebrow">Integrations</p>
        <h2 class="vy-h2">Connect the tools you already use</h2>
        <p class="vy-prose-muted">
          Model Context Protocol servers ship with the app and install per workspace. Connect one
          and its tools join the catalog, with OAuth handled for the hosted ones.
        </p>
        <p class="vy-more"><a href="/extensions" class="vy-link">Every package →</a></p>
      </header>

      <LogoWall kind="integrations" dense />
    </div>
  </section>

  <section class="vy-rule vy-section">
    <div class="vy-shell">
      <ChangelogStrip limit={3} />
    </div>
  </section>

  <section class="vy-rule vy-section">
    <div class="vy-shell">
      <div class="vy-canvas vy-cta vy-cta-canvas">
        <h2 class="vy-h2">Install it and point it at a repository.</h2>
        <p class="vy-prose-muted">
          Free, open source, and yours to fork. Builds for Windows, macOS and Linux.
        </p>
        <div class="vy-cta-actions">
          <a class="vy-btn vy-btn-primary" href="/download">Download</a>
          <a class="vy-btn vy-btn-secondary" href="/docs">Read the docs</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .vy-hero .vy-display {
    max-width: 20ch;
  }

  .vy-hero .vy-lede {
    margin-top: 1.125rem;
  }

  .vy-hero .vy-cta-actions {
    margin-top: 1.75rem;
  }

  .vy-hero-platforms {
    margin-top: 1.25rem;
  }

  .vy-hero-version {
    color: var(--vy-tertiary);
    font-size: 0.75rem;
  }

  .vy-provider-note {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
  }

  .vy-cta-canvas {
    padding-block: clamp(3rem, 7vw, 5rem);
  }
</style>
