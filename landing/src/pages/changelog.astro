---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { githubReleases } from '../lib/githubReleases'
import { parseReleaseNotesSections } from '../lib/releaseNotes'
import { RELEASES_PAGE } from '../lib/githubRelease'
import { SITE_PRODUCT } from '../lib/site'

const releases = githubReleases.map((release) => {
  const date = release.publishedAt ? new Date(release.publishedAt) : null
  return {
    ...release,
    sections: parseReleaseNotesSections(release.body),
    dateLabel:
      date && !Number.isNaN(date.getTime())
        ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
        : null
  }
})
---

<BaseLayout
  title={`Changelog — ${SITE_PRODUCT}`}
  description="Release notes for every Agent V desktop release: what changed, fixed, and shipped."
>
  <SiteHeader />
  <main id="main-content" class="wrap py-16 md:py-24" tabindex="-1">
    <div class="changelog-page">
      <p class="home-eyebrow">Releases</p>
      <h1>Changelog</h1>
      <p class="changelog-intro">
        Every desktop release and what it changes. Installers live on
        <a href={RELEASES_PAGE} rel="noopener noreferrer">GitHub Releases</a>; the app
        checks for updates on its own and shows these notes when a new version is
        available.
      </p>

      {
        releases.length === 0 ? (
          <p class="changelog-empty">
            No published release notes yet — see{' '}
            <a href={RELEASES_PAGE} rel="noopener noreferrer">
              GitHub Releases
            </a>{' '}
            for the latest installers.
          </p>
        ) : (
          <div class="changelog-list">
            {releases.map((release) => (
              <article class="changelog-entry">
                <header class="changelog-entry-header">
                  <div class="changelog-entry-title">
                    <h2>
                      <a href={release.htmlUrl} rel="noopener noreferrer">
                        v{release.version}
                      </a>
                    </h2>
                    {release.dateLabel && <time datetime={release.publishedAt}>{release.dateLabel}</time>}
                  </div>
                  <a class="changelog-entry-link" href={release.htmlUrl} rel="noopener noreferrer">
                    Full release notes
                  </a>
                </header>
                {release.sections.map((section) => (
                  <section class="changelog-section">
                    {section.heading && <h3>{section.heading}</h3>}
                    <ul>
                      {section.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                ))}
              </article>
            ))}
          </div>
        )
      }
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .changelog-page {
    max-width: 46rem;
  }

  .changelog-page h1 {
    margin: 1rem 0 0;
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .changelog-intro {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 40rem;
  }

  .changelog-empty {
    margin: 2rem 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .changelog-page a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.2em;
  }

  .changelog-page a:hover {
    text-decoration-color: var(--fg);
  }

  .changelog-list {
    margin: 3rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .changelog-entry {
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .changelog-entry-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .changelog-entry-title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
  }

  .changelog-entry-title h2 {
    margin: 0;
    font-family: var(--font-headline);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .changelog-entry-title h2 a {
    text-decoration: none;
  }

  .changelog-entry-title h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--border);
  }

  .changelog-entry-title time {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .changelog-entry-link {
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .changelog-section {
    margin: 1.25rem 0 0;
  }

  .changelog-section h3 {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .changelog-section ul {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .changelog-section li {
    position: relative;
    padding-left: 1rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .changelog-section li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 999px;
    background: var(--fg);
  }
</style>
