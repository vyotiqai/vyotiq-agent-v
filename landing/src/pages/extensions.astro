---
import Base from '../layouts/Base.astro'
import { app } from '../lib/site'
import Shot from '../components/Shot.astro'

const ext = app.extensions

const GROUPS = [
  {
    kind: 'mcp',
    id: 'mcp-servers',
    title: 'MCP servers',
    blurb:
      'Model Context Protocol servers. Connect one and its tools, resources and prompts become available to the agent. Several use OAuth, so you sign in to the vendor rather than pasting a token.'
  },
  {
    kind: 'skill',
    id: 'skills',
    title: 'Skills',
    blurb:
      'Reusable instruction sets the agent loads into a run, invoked as slash commands. These ship with the app; you can also write your own.'
  },
  {
    kind: 'plugin',
    id: 'plugin-rule-sets',
    title: 'Plugin rule sets',
    blurb: 'Bundles of standing rules that apply to every run in a workspace.'
  }
] as const

// Featured packages first, in the order the app's marketplace shows them.
const byKind = (kind: string) =>
  ext.list
    .filter((p) => p.kind === kind)
    .sort((a, b) => {
      if (a.featuredRank && b.featuredRank) return a.featuredRank - b.featuredRank
      if (a.featuredRank) return -1
      if (b.featuredRank) return 1
      return a.name.localeCompare(b.name)
    })

const AUTH_LABEL: Record<string, string> = {
  oauth: 'OAuth',
  'oauth-client': 'OAuth'
}
---

<Base
  title="Extensions"
  description={`${ext.total} extensions ship with Agent V — ${ext.counts.mcp} MCP servers, ${ext.counts.skill} skills and ${ext.counts.plugin} plugin rule sets.`}
>
  <section class="vy-page-head">
    <div class="vy-shell">
      <p class="vy-eyebrow">Extensions</p>
      <h1 class="vy-h1">{ext.total} packages, bundled with the app</h1>
      <p class="vy-lede">
        The marketplace ships inside Agent V. Browsing it makes no network request, and installing
        is per workspace. There is no registry account and nothing to sign up for.
      </p>
      <ul class="vy-jump" aria-label="On this page">
        <li><a href="#mcp-servers">{ext.counts.mcp} MCP servers</a></li>
        <li><a href="#skills">{ext.counts.skill} skills</a></li>
        <li><a href="#plugin-rule-sets">{ext.counts.plugin} plugin rule sets</a></li>
      </ul>

      <div class="vy-canvas vy-ext-canvas">
        <Shot
          name="marketplace"
          alt="The Agent V marketplace listing bundled MCP servers with their publishers."
          caption="Browsing the bundle, offline, inside the application."
          eager
        />
      </div>
    </div>
  </section>

  {
    GROUPS.map((group) => {
      const items = byKind(group.kind)
      return (
        <section class="vy-rule vy-section" id={group.id}>
          <div class="vy-shell vy-section-grid">
            <header class="vy-sec-head">
              <p class="vy-eyebrow">{items.length} packages</p>
              <h2 class="vy-h2">{group.title}</h2>
              <p class="vy-prose-muted">{group.blurb}</p>
            </header>

            <div class="vy-panel">
              <ul class="vy-rows">
                {items.map((pkg) => (
                  <li class="vy-pkg">
                    {pkg.icon ? (
                      <img
                        class="vy-pkg-icon"
                        src={`/brand/extensions/${pkg.icon}`}
                        alt=""
                        width="20"
                        height="20"
                        loading="lazy"
                      />
                    ) : (
                      <span class="vy-pkg-icon vy-pkg-icon-fallback" aria-hidden="true">
                        {pkg.name.slice(0, 1)}
                      </span>
                    )}
                    <div class="vy-pkg-body">
                      <h3 class="vy-pkg-name">{pkg.name}</h3>
                      <p class="vy-pkg-desc">{pkg.description}</p>
                    </div>
                    <div class="vy-pkg-side">
                      {pkg.publisher && <span class="vy-pkg-pub vy-mono">{pkg.publisher}</span>}
                      {AUTH_LABEL[pkg.auth] && <span class="vy-tag">{AUTH_LABEL[pkg.auth]}</span>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )
    })
  }

  <section class="vy-rule vy-section">
    <div class="vy-shell vy-section-grid">
      <header class="vy-sec-head">
        <p class="vy-eyebrow">Your own servers</p>
        <h2 class="vy-h2">Not limited to the bundle</h2>
      </header>
      <div>
        <p class="vy-prose-muted">
          Any MCP server works, not just the bundled ones. Point Agent V at a command or a URL, or
          import servers you have already configured for another client.
        </p>
        <p class="vy-footnote">
          Trade marks and icons on this page belong to their respective owners and are shown to
          identify the integration.
        </p>
      </div>
    </div>
  </section>

  <section class="vy-rule vy-section">
    <div class="vy-shell vy-cta">
      <h2 class="vy-h2">Install it and open the marketplace.</h2>
      <div class="vy-cta-actions">
        <a class="vy-btn vy-btn-primary" href="/download">Download</a>
        <a class="vy-btn vy-btn-secondary" href="/docs">Documentation</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .vy-ext-canvas {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .vy-rows > .vy-pkg {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    gap: 0.875rem;
    align-items: start;
    padding-block: 1rem;
  }

  .vy-pkg-icon {
    width: 20px;
    height: 20px;
    margin-top: 0.1rem;
    object-fit: contain;
  }

  .vy-pkg-icon-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--vy-border);
    border-radius: var(--vy-radius-sm);
    background: var(--vy-surface);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--vy-muted);
    text-transform: uppercase;
  }

  .vy-pkg-name {
    font-size: 0.9375rem;
    letter-spacing: -0.014em;
  }

  .vy-pkg-desc {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--vy-muted);
  }

  .vy-pkg-side {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding-top: 0.15rem;
  }

  .vy-pkg-pub {
    font-size: 0.6875rem;
    color: var(--vy-tertiary);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .vy-pkg {
      grid-template-columns: 20px minmax(0, 1fr);
    }
    .vy-pkg-side {
      grid-column: 2;
      padding-top: 0;
    }
  }
</style>
