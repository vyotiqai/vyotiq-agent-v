---
import DocsLayout from '../../../layouts/DocsLayout.astro'
import {
  DOC_SECTION_INTRO,
  DOC_SECTION_LABEL,
  DOC_SECTIONS,
  docsHref,
  groupedDocs,
  type DocSection
} from '../../../lib/docs'

export function getStaticPaths() {
  return DOC_SECTIONS.map((section) => ({ params: { section } }))
}

const section = Astro.params.section as DocSection
if (!DOC_SECTIONS.includes(section)) {
  return Astro.redirect('/docs')
}

const groups = await groupedDocs()
const group = groups.find((entry) => entry.section === section)
if (!group) {
  return Astro.redirect('/docs')
}

const label = DOC_SECTION_LABEL[section]
const intro = DOC_SECTION_INTRO[section]
---

<DocsLayout
  title={label}
  description={intro}
  currentSection={section}
>
  <ul class="docs-index-list">
    {
      group.entries.map((entry) => (
        <li>
          <a href={docsHref(entry.id)}>{entry.data.title}</a>
          <span>{entry.data.description}</span>
        </li>
      ))
    }
  </ul>
</DocsLayout>
