---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { SITE } from '../lib/site'

interface Props {
  title?: string
  description?: string
  /** Error pages: no canonical, and keep them out of the index. */
  noindex?: boolean
}

const { title, description = SITE.description, noindex = false } = Astro.props

const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title
// The root keeps its trailing slash (a bare origin cannot be expressed without
// one); every other route drops it. The sitemap is normalised the same way.
const url = new URL(Astro.url.pathname, SITE.url)
const canonicalUrl = url.pathname === '/' ? url.href : url.href.replace(/\/$/, '')
const ogImage = new URL('/brand/vyotiq-social-card.png', SITE.url).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}

    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/vyotiq-app-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={noindex ? SITE.url : canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="color-scheme" content="light dark" />

    <script is:inline>
      // Applied before first paint so a stored theme never flashes.
      try {
        var stored = localStorage.getItem('vy-theme')
        if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored
      } catch (e) {}
    </script>
  </head>

  <body>
    <a href="#main" class="vy-skip">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style is:global>
      .vy-skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.65rem 1rem;
        background: var(--vy-accent);
        color: var(--vy-accent-fg);
        border-radius: 0 0 var(--vy-radius-md) 0;
        font-size: 0.875rem;
        font-weight: 500;
      }

      .vy-skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
