---
import BaseLayout from './BaseLayout.astro'
import LandingIcon from '../components/LandingIcon.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { SITE_BRAND, SITE_PRODUCT } from '../lib/site'
import {
  docsEditHref,
  docsFeedbackHref,
  docsHref,
  docsNavTitle,
  docsPageContext,
  docsSearchEntries,
  docsSectionHref,
  docsTocLabel,
  groupedDocs,
  type DocSection,
  type DocsSearchEntry
} from '../lib/docs'

type Heading = { depth: number; slug: string; text: string }

interface Props {
  title: string
  description: string
  currentId?: string | null
  currentSection?: DocSection | null
  headings?: Heading[]
  type?: 'quickstart' | 'guide' | 'concept' | 'reference' | 'troubleshooting'
  audience?: string
}

const {
  title,
  description,
  currentId = null,
  currentSection = null,
  headings = [],
  type,
  audience
} = Astro.props

const groups = await groupedDocs()
const searchEntries = await docsSearchEntries()
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const pageTitle = `${title} — ${SITE_PRODUCT}`
const onIndex = currentId == null && currentSection == null
const onSection = currentSection != null
const context = currentId ? await docsPageContext(currentId) : null
const quickstartPage = type === 'quickstart' && currentId === 'start/quickstart'
const pageUrl = new URL(Astro.url.pathname, Astro.site)
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Docs',
        item: new URL('/docs', Astro.site).href
      },
      ...(context
        ? [
            {
              '@type': 'ListItem',
              position: 2,
              name: context.sectionLabel,
              item: new URL(context.sectionHref, Astro.site).href
            },
            {
              '@type': 'ListItem',
              position: 3,
              name: title
            }
          ]
        : [])
    ]
  },
  ...(!onIndex
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'TechArticle',
          headline: title,
          description,
          audience: audience ? { '@type': 'Audience', audienceType: audience } : undefined,
          url: pageUrl.href,
          author: { '@type': 'Organization', name: SITE_BRAND }
        }
      ]
    : [])
]
---

<BaseLayout title={pageTitle} description={description} structuredData={structuredData}>
  <SiteHeader />
  <div class="wrap docs-shell py-10 md:py-14">
    <aside class="docs-nav" aria-label="Docs">
      <button class="docs-search-button" type="button" data-docs-search-open>
        <LandingIcon name="search" size={15} />
        <span>Search docs</span>
        <kbd><span data-mod-key>Ctrl</span> K</kbd>
      </button>
      <div class="docs-nav-scroll">
      <details class="docs-nav-box" id="docs-nav-box" open>
        <summary class="docs-nav-summary">Docs menu</summary>
        <a
          class:list={['docs-nav-index', onIndex && 'docs-nav-current']}
          href="/docs"
          aria-current={onIndex ? 'page' : undefined}
        >
          Docs
        </a>
        {
          groups.map((group) => (
            <div class="docs-nav-group">
              <a
                class:list={['docs-nav-heading', currentSection === group.section && 'docs-nav-section-current']}
                href={docsSectionHref(group.section)}
                aria-current={currentSection === group.section ? 'page' : undefined}
              >
                {group.label}
                <span class="docs-nav-count">{group.entries.length}</span>
              </a>
              <ul>
                {group.entries.map((entry) => {
                  const current = entry.id === currentId
                  return (
                    <li>
                      <a
                        href={docsHref(entry.id)}
                        class:list={[current && 'docs-nav-current']}
                        aria-current={current ? 'page' : undefined}
                      >
                        {docsNavTitle(entry.id, entry.data.title)}
                      </a>
                    </li>
                  )
                })}
              </ul>
            </div>
          ))
        }
      </details>
      </div>
    </aside>

    <main id="main-content" class="min-w-0" tabindex="-1">
      <article class:list={['doc-prose', onIndex && 'docs-index-prose', quickstartPage && 'docs-quickstart']}>
        {
          context || onSection ? (
            <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
              <a href="/docs">Docs</a>
              <span aria-hidden="true">/</span>
              {context ? (
                <>
                  <a href={context.sectionHref}>{context.sectionLabel}</a>
                  <span aria-hidden="true">/</span>
                  <span aria-current="page">{title}</span>
                </>
              ) : (
                <span aria-current="page">{title}</span>
              )}
            </nav>
          ) : null
        }
        <h1 id="page-title">{title}</h1>
        <p class="doc-lede">{description}</p>
        {
          toc.length > 0 ? (
            <details class="docs-mobile-toc">
              <summary>On this page</summary>
              <ul>
                {toc.map((heading) => (
                  <li class:list={[heading.depth === 3 && 'docs-toc-h3']}>
                    <a href={`#${heading.slug}`}>{docsTocLabel(heading.text)}</a>
                  </li>
                ))}
              </ul>
            </details>
          ) : null
        }
        <div data-docs-body>
          <slot />
        </div>
        {
          context && context.related.length > 0 ? (
            <section class="docs-related" aria-labelledby="related-pages-heading">
              <h2 id="related-pages-heading">Related pages</h2>
              <ul>
                {context.related.map((entry) => (
                  <li>
                    <a href={docsHref(entry.id)}>{entry.data.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          ) : null
        }
        {
          context ? (
            <nav class="docs-pager" aria-label="Documentation pages">
              {context.previous ? (
                <a href={docsHref(context.previous.id)} rel="prev">
                  <span class="inline-flex items-center gap-1">
                    <LandingIcon name="chevron-left" size={13} />
                    Previous
                  </span>
                  <strong>{context.previous.data.title}</strong>
                </a>
              ) : (
                <span />
              )}
              {context.next ? (
                <a href={docsHref(context.next.id)} rel="next">
                  <span class="inline-flex items-center justify-end gap-1">
                    Next
                    <LandingIcon name="chevron-right" size={13} />
                  </span>
                  <strong>{context.next.data.title}</strong>
                </a>
              ) : null}
            </nav>
          ) : null
        }
        {
          currentId ? (
            <p class="docs-edit-links">
              <a href={docsEditHref(currentId)}>
                Edit page
                <LandingIcon name="arrow-up-right" size={12} />
              </a>
              <span aria-hidden="true">·</span>
              <a href={docsFeedbackHref(title)}>
                Report an issue
                <LandingIcon name="arrow-up-right" size={12} />
              </a>
            </p>
          ) : null
        }
      </article>
    </main>

    {
      toc.length > 0 ? (
        <nav class="docs-toc" aria-label="On this page">
          <p class="docs-nav-heading">On this page</p>
          <ul>
            {toc.map((heading) => (
              <li class:list={[heading.depth === 3 && 'docs-toc-h3']}>
                <a href={`#${heading.slug}`}>{docsTocLabel(heading.text)}</a>
              </li>
            ))}
          </ul>
          <button class="docs-copy-button" type="button" data-docs-copy>
            <LandingIcon name="copy" size={14} />
            <span data-docs-copy-label>Copy page</span>
          </button>
        </nav>
      ) : null
    }
  </div>
  <dialog class="docs-search-dialog" aria-labelledby="docs-search-title" data-docs-search-dialog>
    <div class="docs-search-header">
      <div>
        <h2 id="docs-search-title">Search documentation</h2>
        <p>Search page titles, summaries, and headings.</p>
      </div>
      <button type="button" data-docs-search-close aria-label="Close documentation search">
        <LandingIcon name="x" size={15} />
        <span class="sr-only">Close</span>
      </button>
    </div>
    <label class="docs-search-field">
      <span class="sr-only">Search documentation</span>
      <input
        type="search"
        placeholder="Search docs…"
        autocomplete="off"
        role="combobox"
        aria-expanded="true"
        aria-controls="docs-search-results"
        aria-autocomplete="list"
        data-docs-search-input
      />
      <kbd>Esc</kbd>
    </label>
    <p class="docs-search-status" aria-live="polite" data-docs-search-status></p>
    <ul
      class="docs-search-results"
      id="docs-search-results"
      role="listbox"
      aria-label="Search results"
      data-docs-search-results
    ></ul>
  </dialog>
  <script
    is:inline
    type="application/json"
    id="docs-search-data"
    set:html={JSON.stringify(searchEntries satisfies DocsSearchEntry[])}
  />
  <SiteFooter />
  <script is:inline>
    (function () {
      var box = document.getElementById('docs-nav-box')
      if (!(box instanceof HTMLDetailsElement)) return
      var mq = window.matchMedia('(min-width: 48rem)')
      function sync() {
        box.open = mq.matches
      }
      sync()
      mq.addEventListener('change', sync)
    })()
  </script>
  <script>
    type SearchEntry = {
      title: string
      description: string
      section: string
      href: string
      text: string
    }

    const dialog = document.querySelector<HTMLDialogElement>('[data-docs-search-dialog]')
    const input = document.querySelector<HTMLInputElement>('[data-docs-search-input]')
    const results = document.querySelector<HTMLUListElement>('[data-docs-search-results]')
    const status = document.querySelector<HTMLElement>('[data-docs-search-status]')
    const copyLabel = document.querySelector<HTMLElement>('[data-docs-copy-label]')
    const raw = document.querySelector<HTMLScriptElement>('#docs-search-data')?.textContent ?? '[]'
    const entries = JSON.parse(raw) as SearchEntry[]

    let activeIndex = -1

    function resultLinks(): HTMLAnchorElement[] {
      if (!results) return []
      return [...results.querySelectorAll<HTMLAnchorElement>('li > a')]
    }

    function setActive(index: number, scroll = true): void {
      const links = resultLinks()
      if (!results) return
      activeIndex = links.length === 0 ? -1 : Math.max(0, Math.min(index, links.length - 1))
      links.forEach((link, i) => {
        const active = i === activeIndex
        if (active) {
          link.dataset.active = 'true'
          link.setAttribute('aria-selected', 'true')
        } else {
          delete link.dataset.active
          link.setAttribute('aria-selected', 'false')
        }
      })
      if (scroll && activeIndex >= 0) {
        links[activeIndex]?.scrollIntoView({ block: 'nearest' })
      }
    }

    function moveActive(delta: number): void {
      const links = resultLinks()
      if (links.length === 0) return
      setActive(activeIndex < 0 ? (delta > 0 ? 0 : links.length - 1) : activeIndex + delta)
    }

    function renderSearch(query = ''): void {
      if (!results || !status) return
      const terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean)
      const matches = entries
        .map((entry) => {
          const haystack =
            `${entry.title} ${entry.description} ${entry.section} ${entry.text}`.toLowerCase()
          const score = terms.reduce((total, term) => {
            if (!haystack.includes(term)) return -1000
            if (entry.title.toLowerCase().includes(term)) return total + 8
            if (entry.description.toLowerCase().includes(term)) return total + 4
            return total + 1
          }, 0)
          return { entry, score }
        })
        .filter((match) => terms.length > 0 && match.score >= 0)
        .sort((a, b) => b.score - a.score || a.entry.title.localeCompare(b.entry.title))
        .slice(0, 12)

      if (terms.length === 0) {
        results.replaceChildren()
        status.textContent = 'Type to search documentation.'
        activeIndex = -1
        return
      }

      results.replaceChildren(
        ...matches.map(({ entry }) => {
          const item = document.createElement('li')
          const link = document.createElement('a')
          const heading = document.createElement('strong')
          const summary = document.createElement('span')
          const section = document.createElement('small')
          link.href = entry.href
          link.setAttribute('role', 'option')
          link.setAttribute('aria-selected', 'false')
          heading.textContent = entry.title
          summary.textContent = entry.description
          section.textContent = entry.section
          link.append(heading, summary, section)
          item.append(link)
          return item
        })
      )
      // Reset selection on every new result set; keyboard input re-selects.
      activeIndex = -1
      status.textContent =
        matches.length === 0
          ? `No documentation matches “${query.trim()}”.`
          : `${matches.length} result${matches.length === 1 ? '' : 's'}`
    }

    function openSearch(): void {
      if (!dialog) return
      if (!dialog.open) dialog.showModal()
      renderSearch(input?.value)
      requestAnimationFrame(() => input?.focus())
    }

    document.querySelectorAll<HTMLElement>('[data-docs-search-open]').forEach((button) => {
      button.addEventListener('click', openSearch)
    })
    document.querySelector<HTMLElement>('[data-docs-search-close]')?.addEventListener('click', () => {
      dialog?.close()
    })
    input?.addEventListener('input', () => renderSearch(input.value))
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault()
        moveActive(1)
        return
      }
      if (event.key === 'ArrowUp') {
        event.preventDefault()
        moveActive(-1)
        return
      }
      if (event.key === 'Enter') {
        const links = resultLinks()
        if (activeIndex >= 0 && links[activeIndex]) {
          event.preventDefault()
          links[activeIndex]!.click()
        }
        // Otherwise fall through so the browser submits/follows default behavior.
      }
    })
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dialog?.open) {
        event.preventDefault()
        dialog.close()
        return
      }
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault()
        openSearch()
      }
    })

    const isApple =
      /Mac|iPhone|iPad/.test(navigator.platform) || navigator.userAgent.includes('Mac')
    document.querySelectorAll('[data-mod-key]').forEach((node) => {
      node.textContent = isApple ? '⌘' : 'Ctrl'
    })

    const navScroll = document.querySelector('.docs-nav-scroll')
    const currentNav = document.querySelector('.docs-nav a[aria-current="page"]')
    if (navScroll instanceof HTMLElement && currentNav instanceof HTMLElement) {
      const navBox = navScroll.getBoundingClientRect()
      const itemBox = currentNav.getBoundingClientRect()
      if (itemBox.top < navBox.top || itemBox.bottom > navBox.bottom) {
        navScroll.scrollTop += itemBox.top - navBox.top - (navBox.height - itemBox.height) / 2
      }
    }

    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.docs-toc a[href^="#"]')]
    const headingEls = tocLinks
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((el): el is HTMLElement => el instanceof HTMLElement)

    function setActiveToc(id: string | null): void {
      for (const link of tocLinks) {
        const active = id != null && link.hash === `#${id}`
        if (active) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      }
    }

    if (headingEls.length > 0 && 'IntersectionObserver' in window) {
      const visible = new Map<string, IntersectionObserverEntry>()
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.set(entry.target.id, entry)
            else visible.delete(entry.target.id)
          }
          const firstVisible = headingEls.find((el) => visible.has(el.id))
          setActiveToc(firstVisible?.id ?? headingEls[0]?.id ?? null)
        },
        { rootMargin: '-20% 0px -65% 0px', threshold: [0, 1] }
      )
      for (const el of headingEls) observer.observe(el)
      setActiveToc(headingEls[0]?.id ?? null)
    }

    document.querySelector<HTMLElement>('[data-docs-copy]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget
      if (!(button instanceof HTMLButtonElement) || !copyLabel) return
      let text: string | null = null
      // Prefer the page's raw markdown served at /docs/<section>/<doc>.md,
      // prefixed with the title and URL so the copied context stands alone.
      try {
        const rawPath = `${location.pathname.replace(/\/+$/, '')}.md`
        const response = await fetch(rawPath)
        if (response.ok) {
          const raw = await response.text()
          const heading = document.querySelector<HTMLElement>('#page-title')
          text = `# ${heading?.innerText?.trim() ?? document.title}\n${location.href}\n\n${raw}`
        }
      } catch {
        // fall through to rendered-text fallback
      }
      if (text == null || text.trim() === '') {
        const heading = document.querySelector<HTMLElement>('#page-title')
        const body = document.querySelector<HTMLElement>('[data-docs-body]')
        text = `${heading?.innerText ?? document.title}\n${location.href}\n\n${body?.innerText ?? ''}`.trim()
      }
      try {
        await navigator.clipboard.writeText(text)
        copyLabel.textContent = 'Copied'
      } catch {
        copyLabel.textContent = 'Copy failed'
      }
      window.setTimeout(() => {
        copyLabel.textContent = 'Copy page'
      }, 1600)
    })

    const prose = document.querySelector<HTMLElement>('[data-docs-body]')
    if (prose) {
      for (const heading of prose.querySelectorAll<HTMLHeadingElement>('h2, h3')) {
        const id = heading.id || heading.textContent?.trim().toLowerCase().replace(/\s+/g, '-')
        if (!id) continue
        if (!heading.id) heading.id = id
        if (heading.querySelector('.docs-heading-anchor')) continue
        const anchor = document.createElement('a')
        anchor.className = 'docs-heading-anchor'
        anchor.href = `#${id}`
        anchor.setAttribute('aria-label', `Link to ${heading.textContent?.trim() ?? 'section'}`)
        anchor.innerHTML =
          '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>'
        heading.append(anchor)
      }
      const keys = new Set(['Esc', 'Enter', 'Tab'])
      for (const code of prose.querySelectorAll('code')) {
        if (code.closest('pre')) continue
        const label = code.textContent?.trim() ?? ''
        if (!keys.has(label)) continue
        const kbd = document.createElement('kbd')
        kbd.textContent = label
        code.replaceWith(kbd)
      }
    }
  </script>
</BaseLayout>
