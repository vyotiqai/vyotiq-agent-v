---
import BaseLayout from './BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import LandingIcon from '../components/LandingIcon.astro'
import { SITE_PRODUCT } from '../lib/site'
import {
  DOC_SECTION_LABEL,
  docsEditHref,
  docsFeedbackHref,
  docsHref,
  docsNavTitle,
  docsPageContext,
  docsSectionHref,
  docsTocLabel,
  docsSearchEntries,
  groupedDocs,
  type DocSection,
  type DocsSearchEntry
} from '../lib/docs'

interface Props {
  title: string
  description: string
  currentId?: string
  currentSection?: DocSection
  headings?: { depth: number; slug: string; text: string }[]
  type?: string
  audience?: string
}

const { title, description, currentId, currentSection, headings = [], type, audience = [] } = Astro.props

const pageTitle = `${title} — ${SITE_PRODUCT}`
const quickstartPage = currentId === 'start/quickstart'

const toc = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({ depth: heading.depth, slug: heading.slug, text: docsTocLabel(heading.text) }))

const groups = await groupedDocs()
const searchEntries: DocsSearchEntry[] = await docsSearchEntries()

const context = currentId ? await docsPageContext(currentId) : null
const activeSection: DocSection | null =
  currentSection ?? (currentId ? (currentId.split('/')[0] as DocSection) : null)
const onIndex = !currentId && !currentSection

const origin = Astro.site?.toString() ?? 'https://vyotiq.com/'
const breadcrumbTrail: { name: string; href: string }[] = [{ name: 'Documentation', href: '/docs' }]
if (context) {
  breadcrumbTrail.push({ name: context.sectionLabel, href: context.sectionHref })
} else if (currentSection) {
  breadcrumbTrail.push({ name: DOC_SECTION_LABEL[currentSection], href: docsSectionHref(currentSection) })
}

const structuredData: Record<string, unknown>[] = []
if (!onIndex) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbTrail.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.href, origin).toString()
    }))
  })
}
if (currentId) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    ...(type ? { articleSection: type } : {}),
    ...(audience ? { audience: { '@type': 'Audience', audienceType: audience } } : {})
  })
}

const searchPayload = JSON.stringify(searchEntries).replace(/</g, '\\u003c')
const mobileCrumb = context?.sectionLabel ?? (currentSection ? DOC_SECTION_LABEL[currentSection] : 'Documentation')
---

<BaseLayout title={pageTitle} description={description} structuredData={structuredData}>
  <SiteHeader />

  <div class="docs-shell">
    <div class="docs-mobile-bar">
      <button
        type="button"
        class="docs-menu-button"
        data-docs-nav-toggle
        aria-expanded="false"
        aria-controls="docs-sidebar"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <span>Docs</span>
      </button>
      <span class="docs-mobile-crumb">{mobileCrumb}</span>
    </div>

    <div class="docs-scrim" data-docs-scrim aria-hidden="true"></div>

    <aside class="docs-sidebar" id="docs-sidebar" data-docs-sidebar aria-label="Documentation">
      <div class="docs-sidebar-head">
        <button type="button" class="docs-search-button" data-docs-search-open>
          <LandingIcon name="search" size={14} />
          <span>Search docs</span>
          <span class="docs-search-keys"><kbd data-mod-key>Ctrl</kbd><kbd>K</kbd></span>
        </button>
        <button type="button" class="docs-sidebar-close" data-docs-nav-close aria-label="Close menu">
          <LandingIcon name="x" size={16} />
        </button>
      </div>

      <nav class="docs-nav docs-nav-scroll">
        <a class:list={['docs-nav-home', onIndex && 'is-active']} href="/docs">All documentation</a>
        {
          groups.map((group) => (
            <div class="docs-nav-group">
              <a
                class:list={['docs-nav-label', activeSection === group.section && 'is-active']}
                href={docsSectionHref(group.section)}
              >
                <span>{group.label}</span>
                <span class="docs-nav-count">{group.entries.length}</span>
              </a>
              <ul class="docs-nav-list">
                {group.entries.map((entry) => (
                  <li>
                    <a
                      class:list={['docs-nav-link', entry.id === currentId && 'is-active']}
                      aria-current={entry.id === currentId ? 'page' : undefined}
                      href={docsHref(entry.id)}
                    >
                      {docsNavTitle(entry.id, entry.data.title)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    <main id="main-content" class="docs-main" tabindex="-1">
      <article class="docs-article">
        {
          !onIndex && (
            <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
              <a href="/docs">Docs</a>
              {breadcrumbTrail.slice(1).map((crumb) => (
                <>
                  <span class="docs-breadcrumb-sep" aria-hidden="true">/</span>
                  <a href={crumb.href}>{crumb.name}</a>
                </>
              ))}
              <span class="docs-breadcrumb-sep" aria-hidden="true">/</span>
              <span class="docs-breadcrumb-current" aria-current="page">{title}</span>
            </nav>
          )
        }

        <header class="docs-header">
          <h1 id="page-title">{title}</h1>
          <p class="docs-lede">{description}</p>
        </header>

        {
          toc.length > 0 && (
            <details class="docs-toc-details">
              <summary>On this page</summary>
              <ul>
                {toc.map((item) => (
                  <li class={item.depth === 3 ? 'is-h3' : undefined}>
                    <a href={`#${item.slug}`}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }

        <div class:list={['docs-prose', quickstartPage && 'docs-quickstart']} data-docs-body>
          <slot />
        </div>

        {
          context && context.related.length > 0 && (
            <section class="docs-related">
              <p class="docs-eyebrow">Related</p>
              <ul>
                {context.related.map((entry) => (
                  <li>
                    <a href={docsHref(entry.id)}>
                      <span>{docsNavTitle(entry.id, entry.data.title)}</span>
                      <LandingIcon name="arrow-up-right" size={13} />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          context && (context.previous || context.next) && (
            <nav class="docs-pager" aria-label="Adjacent pages">
              {context.previous ? (
                <a class="docs-pager-link is-prev" rel="prev" href={docsHref(context.previous.id)}>
                  <span class="docs-eyebrow">
                    <LandingIcon name="chevron-left" size={12} />
                    Previous
                  </span>
                  <span class="docs-pager-title">{docsNavTitle(context.previous.id, context.previous.data.title)}</span>
                </a>
              ) : (
                <span />
              )}
              {context.next ? (
                <a class="docs-pager-link is-next" rel="next" href={docsHref(context.next.id)}>
                  <span class="docs-eyebrow">
                    Next
                    <LandingIcon name="chevron-right" size={12} />
                  </span>
                  <span class="docs-pager-title">{docsNavTitle(context.next.id, context.next.data.title)}</span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }

        {
          currentId && (
            <footer class="docs-article-footer">
              <a href={docsEditHref(currentId)}>
                <span>Edit this page</span>
                <LandingIcon name="arrow-up-right" size={12} />
              </a>
              <a href={docsFeedbackHref(title)}>
                <span>Report an issue</span>
                <LandingIcon name="arrow-up-right" size={12} />
              </a>
            </footer>
          )
        }
      </article>
    </main>

    {
      toc.length > 0 && (
        <nav class="docs-toc" aria-label="On this page">
          <div class="docs-toc-head">
            <p class="docs-eyebrow">On this page</p>
            <button type="button" class="docs-copy-button" data-docs-copy>
              <LandingIcon name="copy" size={12} />
              <span data-docs-copy-label>Copy</span>
            </button>
          </div>
          <ul class="docs-toc-list" data-docs-toc>
            {toc.map((item) => (
              <li class={item.depth === 3 ? 'is-h3' : undefined}>
                <a href={`#${item.slug}`}>{item.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>

  <dialog class="docs-search-dialog" data-docs-search-dialog aria-label="Search documentation">
    <form class="docs-search-form" role="combobox" aria-expanded="true" aria-haspopup="listbox" aria-owns="docs-search-results" onsubmit="return false">
      <LandingIcon name="search" size={16} />
      <input
        data-docs-search-input
        type="search"
        placeholder="Search the docs"
        autocomplete="off"
        aria-autocomplete="list"
        aria-controls="docs-search-results"
      />
    </form>
    <ul class="docs-search-results" id="docs-search-results" role="listbox" aria-label="Search results" data-docs-search-results></ul>
    <p class="docs-search-status" data-docs-search-status role="status"></p>
    <p class="docs-search-empty" data-docs-search-empty hidden>No results. Try a different term.</p>
    <p class="docs-search-footer">
      <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> navigate</span>
      <span><kbd>Enter</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </p>
  </dialog>

  <script type="application/json" id="docs-search-data" is:inline set:html={searchPayload} />

  <SiteFooter />

  <script>
    // ---- Mobile drawer -------------------------------------------------
    const sidebar = document.querySelector<HTMLElement>('[data-docs-sidebar]')
    const toggleButton = document.querySelector<HTMLButtonElement>('[data-docs-nav-toggle]')
    const closeButton = document.querySelector<HTMLButtonElement>('[data-docs-nav-close]')
    const scrim = document.querySelector<HTMLElement>('[data-docs-scrim]')

    function setNavOpen(open: boolean) {
      sidebar?.classList.toggle('is-open', open)
      scrim?.classList.toggle('is-open', open)
      toggleButton?.setAttribute('aria-expanded', open ? 'true' : 'false')
      document.documentElement.classList.toggle('docs-nav-locked', open)
    }

    toggleButton?.addEventListener('click', () => {
      setNavOpen(!sidebar?.classList.contains('is-open'))
    })
    closeButton?.addEventListener('click', () => setNavOpen(false))
    scrim?.addEventListener('click', () => setNavOpen(false))
    // Keys with their own semantics inside form controls (cancel, activate,
    // focus movement) never implicitly toggle the drawer.
    const drawerHandled = new Set(['Esc', 'Enter', 'Tab'])
    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null
      const inForm = target?.tagName === 'INPUT' || target?.tagName === 'TEXTAREA'
      if (inForm && drawerHandled.has(event.key)) return
      if (event.key === 'Escape') setNavOpen(false)
    })
    window.matchMedia('(min-width: 50.01rem)').addEventListener('change', (event) => {
      if (event.matches) setNavOpen(false)
    })

    // ---- Mod-key label -------------------------------------------------
    const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent)
    if (isMac) {
      document.querySelectorAll('[data-mod-key]').forEach((key) => {
        key.textContent = 'Cmd'
      })
    }

    // ---- Heading anchors -----------------------------------------------
    const prose = document.querySelector<HTMLElement>('[data-docs-body]')
    prose?.querySelectorAll<HTMLElement>('h2, h3, h4').forEach((heading) => {
      if (!heading.id) return
      const anchor = document.createElement('a')
      anchor.className = 'docs-heading-anchor'
      anchor.href = `#${heading.id}`
      anchor.setAttribute('aria-label', `Link to this section`)
      anchor.textContent = '#'
      heading.appendChild(anchor)
    })

    // ---- Copy page -----------------------------------------------------
    const copyButton = document.querySelector<HTMLButtonElement>('[data-docs-copy]')
    const copyLabel = document.querySelector<HTMLElement>('[data-docs-copy-label]')
    copyButton?.addEventListener('click', async () => {
      if (!copyButton) return
      try {
        const response = await fetch(`${window.location.pathname}.md`)
        await navigator.clipboard.writeText(await response.text())
        copyButton.classList.add('is-copied')
        if (copyLabel) copyLabel.textContent = 'Copied'
        window.setTimeout(() => {
          copyButton.classList.remove('is-copied')
          if (copyLabel) copyLabel.textContent = 'Copy'
        }, 2000)
      } catch {
        /* clipboard unavailable — ignore */
      }
    })

    // ---- TOC scroll spy ------------------------------------------------
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-docs-toc] a'))
    if (tocLinks.length > 0) {
      const pairs = tocLinks
        .map((link) => ({
          link,
          heading: document.getElementById(decodeURIComponent(link.hash.slice(1)))
        }))
        .filter((pair): pair is { link: HTMLAnchorElement; heading: HTMLElement } => pair.heading !== null)

      const observer = new IntersectionObserver(
        (observed) => {
          for (const observation of observed) {
            if (!observation.isIntersecting) continue
            for (const pair of pairs) pair.link.removeAttribute('aria-current')
            const active = pairs.find((pair) => pair.heading === observation.target)
            active?.link.setAttribute('aria-current', 'location')
          }
        },
        { rootMargin: '-10% 0px -80% 0px' }
      )
      for (const pair of pairs) observer.observe(pair.heading)
    }
  </script>

  <script>
    // ---- Docs search ---------------------------------------------------
    type SearchEntry = {
      id: string
      title: string
      description: string
      section: string
      href: string
      text: string
    }

    const dialog = document.querySelector<HTMLDialogElement>('[data-docs-search-dialog]')
    const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-docs-search-open]')
    const input = document.querySelector<HTMLInputElement>('[data-docs-search-input]')
    const resultsEl = document.querySelector<HTMLUListElement>('[data-docs-search-results]')
    const emptyEl = document.querySelector<HTMLElement>('[data-docs-search-empty]')
    const status = document.querySelector<HTMLElement>('[data-docs-search-status]')
    const payload = document.getElementById('docs-search-data')

    const entries: SearchEntry[] = payload ? JSON.parse(payload.textContent ?? '[]') : []
    let activeIndex = -1

    function openSearch() {
      dialog?.showModal()
      if (status) status.textContent = 'Type to search documentation.'
      input?.focus()
      input?.select()
    }

    function setActive(index: number) {
      const items = resultsEl?.querySelectorAll('li') ?? []
      activeIndex = index
      items.forEach((item, i) => {
        const isActive = i === index
        item.classList.toggle('is-active', isActive)
        item.setAttribute('aria-selected', isActive ? 'true' : 'false')
      })
      if (dialog) dialog.setAttribute('aria-activedescendant', index >= 0 ? `docs-search-option-${index}` : '')
    }

    function renderResults(results: SearchEntry[]) {
      if (!resultsEl || !emptyEl) return
      resultsEl.innerHTML = ''
      emptyEl.hidden = results.length > 0
      results.forEach((entry, index) => {
        const item = document.createElement('li')
        item.className = 'docs-search-item'
        item.id = `docs-search-option-${index}`
        item.setAttribute('role', 'option')
        item.setAttribute('aria-selected', 'false')

        const link = document.createElement('a')
        link.href = entry.href
        const heading = document.createElement('span')
        heading.className = 'docs-search-title'
        heading.textContent = entry.title
        const meta = document.createElement('span')
        meta.className = 'docs-search-meta'
        meta.textContent = [entry.section, entry.description].filter(Boolean).join(' — ')
        link.append(heading, meta)
        item.append(link)
        resultsEl.append(item)
      })
      setActive(-1)
    }

    function runSearch(raw: string) {
      const query = raw.trim().toLowerCase()
      if (!query) {
        renderResults([])
        return
      }
      const terms = query.split(/\s+/)
      const scored: { entry: SearchEntry; score: number }[] = []
      for (const entry of entries) {
        const title = entry.title.toLowerCase()
        const description = entry.description.toLowerCase()
        const text = entry.text.toLowerCase()
        let score = 0
        let matchesAll = true
        for (const term of terms) {
          if (title.includes(term)) {
            score += title.startsWith(term) ? 14 : 10
          } else if (description.includes(term)) {
            score += 4
          } else if (text.includes(term)) {
            score += 2
          } else {
            matchesAll = false
            break
          }
        }
        if (matchesAll) scored.push({ entry, score })
      }
      const visible = scored.filter((match) => terms.length > 0 && match.score >= 0)
      visible.sort((a, b) => b.score - a.score)
      renderResults(visible.slice(0, 8).map((hit) => hit.entry))
    }

    openButtons.forEach((button) => button.addEventListener('click', openSearch))
    input?.addEventListener('input', () => runSearch(input.value))
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault()
        const count = resultsEl?.children.length ?? 0
        if (count === 0) return
        const delta = event.key === 'ArrowDown' ? 1 : -1
        setActive((activeIndex + delta + count) % count)
      }
      if (event.key === 'Enter' && activeIndex >= 0) {
        event.preventDefault()
        const link = resultsEl?.children[activeIndex]?.querySelector('a')
        link?.click()
      }
    })
    resultsEl?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) dialog?.close()
    })
    window.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault()
        if (dialog?.open) dialog.close()
        else openSearch()
      }
    })
  </script>
</BaseLayout>

<style>
  /* ---- Shell grid ---------------------------------------------------- */
  .docs-shell {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr) 13rem;
    column-gap: 2.5rem;
    max-width: 75rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .docs-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0;
  }

  /* ---- Sidebar ------------------------------------------------------- */
  .docs-sidebar {
    position: sticky;
    top: 4rem;
    height: fit-content;
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    padding-block: 2.25rem 3rem;
    padding-right: 1.25rem;
    border-right: 1px solid var(--border-faint);
    scrollbar-width: thin;
  }

  .docs-sidebar-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .docs-search-button {
    flex: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.125rem;
    padding: 0 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .docs-search-button:hover {
    border-color: var(--border);
    color: var(--fg);
  }

  .docs-search-keys {
    margin-left: auto;
    display: inline-flex;
    gap: 2px;
  }

  .docs-search-button kbd {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    padding: 0 0.25rem;
    background: var(--well);
    color: var(--muted);
  }

  .docs-sidebar-close {
    display: none;
    align-items: center;
    background: none;
    border: 0;
    color: var(--muted);
    cursor: pointer;
    padding: 0.375rem;
  }

  .docs-nav {
    display: grid;
    gap: 1.75rem;
  }

  .docs-nav-home {
    display: block;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-faint);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .docs-nav-home:hover {
    color: var(--accent-strong);
  }

  .docs-nav-home.is-active {
    color: var(--accent);
  }

  .docs-nav-group {
    display: grid;
    gap: 0.75rem;
  }

  .docs-nav-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .docs-nav-label:hover {
    color: var(--fg);
  }

  .docs-nav-label.is-active {
    color: var(--accent);
  }

  .docs-nav-count {
    font-size: 0.625rem;
    opacity: 0.7;
  }

  .docs-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.125rem;
  }

  .docs-nav-link {
    display: block;
    padding: 0.375rem 0.625rem;
    border-radius: 8px;
    font-size: 0.8438rem;
    line-height: 1.45;
    color: var(--muted);
    text-decoration: none;
    transition:
      color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .docs-nav-link:hover {
    color: var(--fg);
  }

  .docs-nav-link.is-active {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
  }

  /* ---- Main column --------------------------------------------------- */
  .docs-main {
    min-width: 0;
    padding-block: 2.25rem 4rem;
  }

  .docs-article {
    max-width: 70ch;
  }

  .docs-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .docs-breadcrumbs a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .docs-breadcrumbs a:hover {
    color: var(--accent-strong);
  }

  .docs-breadcrumb-sep {
    color: var(--border);
  }

  .docs-breadcrumb-current {
    color: var(--fg);
  }

  .docs-header h1 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.625rem);
    font-weight: 700;
    line-height: 1.08;
