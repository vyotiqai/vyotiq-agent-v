---
import '../styles/global.css';

const description =
  'Agent V is a free, open-source coding workspace for real repositories by Vyotiq. It pairs a natural-language agent harness with workspace tools, multi-provider chat, live context management, and file-backed long-term memory.';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Agent V — AI coding workspace for real repositories</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href="https://vyotiq.com/" />
    <link rel="icon" type="image/svg+xml" href="/brand/vyotiq-app-icon.svg" />
    <link rel="icon" type="image/png" sizes="1024x1024" href="/brand/vyotiq-app-icon.png" />
    <link rel="apple-touch-icon" href="/brand/vyotiq-app-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://vyotiq.com/brand/vyotiq-social-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vyotiq — Agent V social card" />
    <meta property="og:site_name" content="Agent V" />
    <meta property="og:title" content="Agent V — AI coding workspace for real repositories" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://vyotiq.com/" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://vyotiq.com/brand/vyotiq-social-card.png" />
    <meta name="twitter:title" content="Agent V — AI coding workspace for real repositories" />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#09090b" />
  </head>
  <body
    id="top"
    class="min-h-screen bg-zinc-950 font-sans text-zinc-300 antialiased selection:bg-zinc-300/25"
  >
    <slot />
  </body>
</html>
