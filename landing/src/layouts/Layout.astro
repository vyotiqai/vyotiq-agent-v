---
import '../styles/global.css';

const REPO = 'https://github.com/vyotiqai/vyotiq-agent-v';
const SOCIAL = 'https://vyotiq.com/brand/vyotiq-social-card.png';
const DESCRIPTION =
  'The coding agent that sits in your workspace — reads your code, makes the change, runs it, and checks its own work. Locally, with the models you already use. Free and open source.';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Agent V — AI coding workspace for real repositories</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href="https://vyotiq.com/" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#faf9f7" />

    <link rel="icon" type="image/svg+xml" href="/brand/vyotiq-app-icon.svg" />
    <link rel="icon" type="image/png" sizes="1024x1024" href="/brand/vyotiq-app-icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/vyotiq-app-icon-180.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Agent V" />
    <meta property="og:title" content="Agent V — AI coding workspace for real repositories" />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content="https://vyotiq.com/" />
    <meta property="og:image" content={SOCIAL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vyotiq — Agent V social card" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Agent V — AI coding workspace for real repositories" />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={SOCIAL} />
  </head>
  <body
    id="top"
    class="min-h-screen bg-[#faf9f7] font-sans text-zinc-800 antialiased selection:bg-orange-600/15"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-zinc-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
