{
  "schemaVersion": 1,
  "kind": "mcp",
  "id": "chrome-devtools",
  "name": "Chrome DevTools",
  "version": "1.0.0",
  "description": "Inspect a live page: console, network, performance traces, and DOM.",
  "transport": "stdio",
  "command": "npx",
  "args": [
    "-y",
    "chrome-devtools-mcp@latest",
    "--no-usage-statistics",
    "--no-performance-crux"
  ],
  "env": {},
  "auth": "none",
  "requires": [
    "node"
  ],
  "docsUrl": "https://github.com/ChromeDevTools/chrome-devtools-mcp"
}
