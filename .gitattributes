resources/harness/default.md text eol=lf

# Generated art is compared byte-for-byte against what its generator writes
# (tests/main/unit/marketplaceBrandIcons.test.ts). The scripts emit LF, so a
# CRLF checkout on Windows would fail that test — pin these to LF everywhere.
resources/marketplace/icons/*.svg text eol=lf
resources/branding/**/*.svg text eol=lf

# Captured application screenshots. Explicitly binary so no future text
# attribute can line-ending-convert them into corruption.
landing/public/shots/*.png binary

# Bundled marketplace packages ship byte-for-byte (electron-builder
# extraResources) and are compared against the installed copy on every boot
# (src/main/marketplace/install.ts repairBundled*FromResources). Pin their text
# files to LF so a CRLF checkout cannot make a packaged build disagree with a
# dev checkout over the same userData.
resources/marketplace/**/*.json text eol=lf
resources/marketplace/**/*.md text eol=lf
# Shell templates a skill tells the agent to run. CRLF would make the shebang
# line fail with "bad interpreter" on every non-Windows host.
resources/marketplace/**/*.sh text eol=lf

# Tray spinner frames are generated art (scripts/generate-spinner-frames.mjs).
# The PNGs are binary; the manifest is emitted with LF, so pin it.
resources/tray/**/*.png binary
resources/tray/manifest.json text eol=lf
