# Markdown siblings generated from .md.docx (scripts/sync-docx-md.mjs)
# NOTE: only resources/marketplace .md stay generated.
resources/marketplace/**/*.md

# ...but these skills are authored directly as SKILL.md with no .md.docx source,
# so the blanket rule above would leave a fresh checkout without them and the
# bundled-skill tests would fail. A marketplace .md needs an entry here whenever
# it has no .md.docx sibling to be generated from.
!resources/marketplace/packages/create-teammate/SKILL.md
!resources/marketplace/packages/dependency-upgrade/SKILL.md
!resources/marketplace/packages/flake-hunter/SKILL.md
!resources/marketplace/packages/incident-triage/SKILL.md
!resources/marketplace/packages/pr-review-reply/SKILL.md
!resources/marketplace/packages/release-notes/SKILL.md
!resources/marketplace/packages/repo-onboarding/SKILL.md
!resources/marketplace/packages/standup-digest/SKILL.md

# Skills vendored from github.com/mattpocock/skills (MIT — see NOTICE). Each
# carries supporting Markdown its SKILL.md links to, so these are whole-package
# rules rather than a file list: re-syncing upstream must not silently drop a
# newly added reference file that nothing here names. There is no .md.docx
# anywhere under them, so nothing generated is un-ignored by the glob.
!resources/marketplace/packages/ask-matt/**/*.md
!resources/marketplace/packages/codebase-design/**/*.md
!resources/marketplace/packages/diagnosing-bugs/**/*.md
!resources/marketplace/packages/domain-modeling/**/*.md
!resources/marketplace/packages/grill-me/**/*.md
!resources/marketplace/packages/grill-with-docs/**/*.md
!resources/marketplace/packages/grilling/**/*.md
!resources/marketplace/packages/handoff/**/*.md
!resources/marketplace/packages/implement/**/*.md
!resources/marketplace/packages/improve-codebase-architecture/**/*.md
!resources/marketplace/packages/prototype/**/*.md
!resources/marketplace/packages/research/**/*.md
!resources/marketplace/packages/resolving-merge-conflicts/**/*.md
!resources/marketplace/packages/review-changes/**/*.md
!resources/marketplace/packages/setup-matt-pocock-skills/**/*.md
!resources/marketplace/packages/setup-pre-commit/**/*.md
!resources/marketplace/packages/tdd/**/*.md
!resources/marketplace/packages/teach/**/*.md
!resources/marketplace/packages/to-questionnaire/**/*.md
!resources/marketplace/packages/to-spec/**/*.md
!resources/marketplace/packages/to-tickets/**/*.md
!resources/marketplace/packages/triage/**/*.md
!resources/marketplace/packages/wait-what/**/*.md
!resources/marketplace/packages/wayfinder/**/*.md
!resources/marketplace/packages/wizard/**/*.md
!resources/marketplace/packages/writing-for-agents/**/*.md

# Local agent / editor state (keep rules and skills)
.vyotiq/memory/
.cursor/hooks/state/
.cursor/mcp.json
.commandcode/

# Python helpers
__pycache__/
*.py[cod]
.venv/
venv/

# IDE
.idea/
.vs/
*.iml

# Docs are stored as Word binaries in these trees. Catch-all ignores
# other .docx (including Windows "Copy (1)" collisions after the
# un-ignores below).
*.docx
!docs/**/*.docx
!resources/**/*.docx
!.cursor/**/*.docx
!.vyotiq/rules/**/*.docx
!tests/**/*.docx

# Windows Explorer duplicate copies — after docx un-ignores so they win
* (1).*
*(1).*

# Local-only editor and internal design notes (must stay after docx un-ignores)
/.cursor/
/.vyotiq/rules/
# Editor recovery snapshot (full source mirror) — local-only, never commit.
/.vyotiq/editor-recovery.json
/.vyotiq/**/editor-recovery.json
# Runtime audit scratch: real userData transcripts/telemetry. Only the written
# report and the .ps1 projections are committed; everything else stays local.
/_audit-runtime/*
!/_audit-runtime/AUDIT-REPORT.md
!/_audit-runtime/proj-*.ps1

# Local coverage scratch
/coverage-baseline.txt
/docs/**
!/docs/**/
!/docs/**/*.docx
# Authored directly, with no .docx source to regenerate it from, and linked
# from the README and the website — it has to be in the repository.
!/docs/teammates.md
# Same: hand-authored, no .docx source, linked from the README. States the
# egress gate's coverage boundary, so it has to ship with the code it describes.
!/docs/egress.md
# Same again. Describes what an agent-authored tool module is actually allowed
# to do, and what bounds it; a security boundary documented only on one machine
# is no boundary at all.
!/docs/agent-tools.md
.cursorrules
AGENTS.md
scripts/remove-coauthors-from-history.sh

# L10 remediation (2026-09-10 audit): local-only clutter. Append-only block —
# nothing above is modified, reordered, or weakened.
asar-list.txt
screenshots/
scripts/tmp-*

# Local-only outputs: packaging verification unpacks and OSS-flip evidence
# snapshots taken by prior working sessions. Machine-local, never publish.
dist-verify*/
tmp-os-evidence/

# Local agent session scratch (2026-09-12): worktree merge leftovers, audit notes
tmp-merge/
.vyotiq/audit-modes/
.vyotiq/fixes/

# Local agent instance scratch (2026-09-15): branch listings, diff deltas, and
# patch files written at the .vyotiq root by agent runs. Machine-local, never
# commit. Append-only block — nothing above is modified, reordered, or weakened.
/.vyotiq/*.txt
/.vyotiq/*.patch
/.vyotiq/*.diff

# Local agent session scratch (2026-09-17): loose patch dumps at the repo root,
# read-only simplify-audit reports, and TMP runtime repro tests that are marked
# "delete after run". Machine-local, never commit. Append-only block — nothing
# above is modified, reordered, or weakened.
/_*.diff
/artifacts/
tests/**/_tmp-*.test.ts

# Machine-local working-tree artifacts (2026-09-19). None of these belong to
# the project, and all of them would be staged by a blanket `git add -A`.
# Append-only block — nothing above is modified, reordered, or weakened.
#
# Live delegated-task queue for THIS machine. It is real runtime state, not
# config: the scheduler reads exactly this path, so a committed copy would
# become every cloner's task queue and leak local workspace paths and prompts.
/.vyotiq/tasks.json
# Separate reference codebase, deliberately kept on disk and already ignored by
# eslint.config.mjs. 2.1 MB of another project — keep it, never commit it.
/errand-main/
# Shell-redirect artifact: a literal file named $null created by `>$null` /
# `2>$null` outside PowerShell.
/$null
# Loose patch dumps and their one-off apply scripts at the repo root.
/[0-9][0-9][0-9][0-9]-*.patch
/_apply_*.ps1
