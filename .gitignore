# Logs and temp
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
.tmp/
.eslintcache
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Secrets and local env (keep committed examples)
.env
.env.*
!.env.example
!.env.*.example

# Developer certificates, keys, and credentials
*.pem
*.key
*.pfx
*.p12
*.jks
*.crt
*.cer
*.der

# Generated synced assets (scripts/sync-*.mjs on postinstall/dev/build)
src/renderer/public/file-icons/
resources/codeindex/wasm/

# Markdown siblings generated from .md.docx (scripts/sync-docx-md.mjs)
# NOTE: only resources/marketplace .md stay generated.
resources/marketplace/**/*.md

# ...but these skills are authored directly as SKILL.md with no .md.docx source,
# so the blanket rule above would leave a fresh checkout without them and the
# bundled-skill tests would fail. A marketplace .md needs an entry here whenever
# it has no .md.docx sibling to be generated from.
!resources/marketplace/packages/dependency-upgrade/SKILL.md
!resources/marketplace/packages/flake-hunter/SKILL.md
!resources/marketplace/packages/incident-triage/SKILL.md
!resources/marketplace/packages/pr-review-reply/SKILL.md
!resources/marketplace/packages/release-notes/SKILL.md
!resources/marketplace/packages/repo-onboarding/SKILL.md
!resources/marketplace/packages/standup-digest/SKILL.md

# Local agent / editor state (keep rules and skills)
.vyotiq/memory/
.cursor/hooks/state/
.cursor/mcp.json
.commandcode/

# Python helpers
__pycache__/
*.py[cod]
.venv/
venv/

# IDE
.idea/
.vs/
*.iml

# Docs are stored as Word binaries in these trees. Catch-all ignores
# other .docx (including Windows "Copy (1)" collisions after the
# un-ignores below).
*.docx
!docs/**/*.docx
!resources/**/*.docx
!.cursor/**/*.docx
!.vyotiq/rules/**/*.docx
!tests/**/*.docx

# Windows Explorer duplicate copies — after docx un-ignores so they win
* (1).*
*(1).*

# Local-only editor and internal design notes (must stay after docx un-ignores)
/.cursor/
/.vyotiq/rules/
# Editor recovery snapshot (full source mirror) — local-only, never commit.
/.vyotiq/editor-recovery.json
/.vyotiq/**/editor-recovery.json
# Runtime audit scratch: real userData transcripts/telemetry. Only the written
# report and the .ps1 projections are committed; everything else stays local.
/_audit-runtime/*
!/_audit-runtime/AUDIT-REPORT.md
!/_audit-runtime/proj-*.ps1

# Local coverage scratch
/coverage-baseline.txt
/docs/**
!/docs/**/
!/docs/**/*.docx
# Authored directly, with no .docx source to regenerate it from, and linked
# from the README and the website — it has to be in the repository.
!/docs/teammates.md
.cursorrules
AGENTS.md
scripts/remove-coauthors-from-history.sh

# L10 remediation (2026-09-10 audit): local-only clutter. Append-only block —
# nothing above is modified, reordered, or weakened.
asar-list.txt
screenshots/
scripts/tmp-*

# Local-only outputs: packaging verification unpacks and OSS-flip evidence
# snapshots taken by prior working sessions. Machine-local, never publish.
dist-verify*/
tmp-os-evidence/

# Local agent session scratch (2026-09-12): worktree merge leftovers, audit notes
tmp-merge/
.vyotiq/audit-modes/
.vyotiq/fixes/

# Local agent instance scratch (2026-09-15): branch listings, diff deltas, and
# patch files written at the .vyotiq root by agent runs. Machine-local, never
# commit. Append-only block — nothing above is modified, reordered, or weakened.
/.vyotiq/*.txt
/.vyotiq/*.patch
/.vyotiq/*.diff

# Local agent session scratch (2026-09-17): loose patch dumps at the repo root,
# read-only simplify-audit reports, and TMP runtime repro tests that are marked
# "delete after run". Machine-local, never commit. Append-only block — nothing
# above is modified, reordered, or weakened.
/_*.diff
/artifacts/
tests/**/_tmp-*.test.ts
