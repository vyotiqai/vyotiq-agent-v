# IDE
.idea/
.vs/
*.iml

# Docs are stored as Word binaries in these trees. Catch-all ignores
# other .docx (including Windows "Copy (1)" collisions after the
# un-ignores below).
*.docx
!docs/**/*.docx
!resources/**/*.docx
!.cursor/**/*.docx
!.vyotiq/rules/**/*.docx
!tests/**/*.docx

# Windows Explorer duplicate copies — after docx un-ignores so they win
* (1).*
*(1).*

# Local-only editor and internal design notes (must stay after docx un-ignores)
/.cursor/
/.devin/
/.vyotiq/rules/
# Editor recovery snapshot (full source mirror) — local-only, never commit.
/.vyotiq/editor-recovery.json
/.vyotiq/**/editor-recovery.json
# Runtime audit scratch: real userData transcripts/telemetry. Only the written
# report and the .ps1 projections are committed; everything else stays local.
/_audit-runtime/*
!/_audit-runtime/AUDIT-REPORT.md
!/_audit-runtime/proj-*.ps1

# Local coverage scratch
/coverage-baseline.txt
/docs/**
!/docs/**/
!/docs/**/*.docx
.cursorrules
AGENTS.md
scripts/remove-coauthors-from-history.sh

