{
  "name": "vyotiq",
  "version": "1.0.0",
  "description": "Agent V — coding workspace for real repositories",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./out/main/index.js",
  "author": "Vyotiq",
  "license": "MIT",
  "homepage": "https://vyotiq.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vyotiqai/vyotiq-agent-v.git"
  },
  "scripts": {
    "dev": "pnpm sync:harness && pnpm sync:file-icons && pnpm sync:codeindex-wasm && electron-vite dev",
    "build": "pnpm typecheck && pnpm build:vite",
    "build:vite": "pnpm sync:harness && pnpm sync:docx-md && pnpm sync:app-icon && pnpm sync:file-icons && pnpm sync:codeindex-wasm && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "pnpm sync:harness && pnpm sync:docx-md && node scripts/test-exit-wrapper.cjs",
    "test:coverage": "pnpm sync:harness && pnpm sync:docx-md && vitest run --coverage",
    "test:reliability": "vitest run tests/main/unit/runsState.test.ts tests/main/unit/agentLoopResume.test.ts tests/main/unit/followUpStore.test.ts tests/main/unit/loopCheckpoint.test.ts tests/main/unit/runRegistry.test.ts tests/main/unit/eventAppendQueue.test.ts tests/main/unit/networkMonitor.test.ts tests/main/unit/sparsegrepSyncPaginated.test.ts tests/main/unit/globIndex.test.ts tests/main/audit/enduranceRun.audit.test.ts tests/main/audit/largeRepoScanCap.audit.test.ts tests/renderer/chat/autoResume.test.tsx tests/renderer/chat/chatStreamController.test.ts",
    "test:e2e": "vitest run tests/main/e2e",
    "test:gui-e2e": "playwright test -c tests/gui-e2e/playwright.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "start": "electron-vite preview",
    "pack": "pnpm build && electron-builder --win --mac --linux --publish never",
    "pack:win": "pnpm build && electron-builder --win nsis --publish never",
    "pack:win:alt": "pnpm build && electron-builder --win nsis --publish never --config.directories.output=dist-package-alt",
    "pack:mac": "pnpm build && electron-builder --mac dmg --publish never",
    "pack:linux": "pnpm build && electron-builder --linux AppImage --publish never",
    "pack:dir:win": "pnpm build && electron-builder --win dir --publish never",
    "pack:dir:win:alt": "pnpm build && electron-builder --win dir --publish never --config.directories.output=dist-package-alt",
    "sync:provider-icons": "node scripts/sync-provider-brand-paths.mjs",
    "sync:harness": "node scripts/sync-harness.mjs",
    "sync:docx-md": "node scripts/sync-docx-md.mjs",
    "sync:brand": "node scripts/generate-precision-mono-brand.mjs",
    "sync:app-icon": "node scripts/sync-app-icon.mjs",
    "sync:file-icons": "node scripts/sync-file-icons.mjs",
    "sync:codeindex-wasm": "node scripts/sync-codeindex-wasm.mjs",
    "sync:landing-brand": "node scripts/sync-landing-brand.mjs",
    "bake:landing-release": "node landing/scripts/bake-github-release.mjs",
    "landing:dev": "pnpm sync:brand && pnpm sync:landing-brand && pnpm bake:landing-release && pnpm --filter @vyotiq/landing dev",
    "landing:build": "pnpm sync:brand && pnpm sync:landing-brand && pnpm bake:landing-release && pnpm --filter @vyotiq/landing build",
    "landing:check": "pnpm --filter @vyotiq/landing check",
    "landing:audit": "node tests/landing/runDocsAudit.mjs",
    "postinstall": "node node_modules/electron/install.js && (electron-builder install-app-deps || node -e \"console.warn('[vyotiq] native module rebuild failed — node-pty will use pipe fallback if unavailable')\") && node scripts/sync-file-icons.mjs && node scripts/sync-codeindex-wasm.mjs && node scripts/sync-harness.mjs && node scripts/sync-docx-md.mjs && node scripts/generate-precision-mono-brand.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/electron": "^7.18.0",
    "@sentry/react": "10.73.0",
    "ajv": "8.20.0",
    "cross-spawn": "^7.0.6",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "gpt-tokenizer": "^3.4.0",
    "onnxruntime-node": "1.24.3",
    "tree-kill": "^1.2.2",
    "tree-sitter-wasms": "^0.1.13",
    "unpdf": "^1.8.1",
    "web-tree-sitter": "^0.26.13",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.20.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lezer/highlight": "1.2.3",
    "@lobehub/icons": "^5.18.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@testing-library/react": "^16.3.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "add": "^2.0.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "codemirror": "^6.0.2",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "material-icon-theme": "^5.38.1",
    "mermaid": "^11.17.2",
    "opentype.js": "^2.0.0",
    "png2icons": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
